---
import { supabase } from '../lib/supabase';
const { mode } = Astro.props as { mode:'members'|'access' };
const db=supabase(Astro.cookies,Astro.request);
const {data:{user}}=db?await db.auth.getUser():{data:{user:null}};
const profile=user&&db?(await db.from('profiles').select('role').eq('id',user.id).single()).data:null;
const groups:Record<string,any>[]=profile?.role==='admin'&&db?(await db.from('permission_groups').select('*').order('name')).data??[]:[];
const members:Record<string,any>[]=profile?.role==='admin'&&db?(await db.from('profiles').select('id,display_name,role,bio,avatar_media_id,permission_group_id,created_at').order('created_at',{ascending:false}).limit(200)).data??[]:[];
const permissionLabels:Record<string,string>={comment:'Yorum yapma',content:'İçerik yönetimi',taxonomy:'Kategori ve etiketler',media:'Medya kütüphanesi',messages:'Mesajlar',appearance:'Görünüm ve ana sayfa',navigation:'Menü ve yönlendirmeler',members:'Üye yönetimi',permissions:'Yetki grupları',audit:'İşlem geçmişi'};
const selectedId=Astro.url.searchParams.get('edit');
const selected=groups.find((group)=>group.id===selectedId);
---
{profile?.role!=='admin' ? <p class="alert">Bu alan yalnız yöneticilere açıktır.</p> : mode==='members' ? <div class="member-admin">
  <section class="studio-panel member-create"><span class="eyebrow">YENİ ÜYELİK</span><h2>Üye oluştur</h2><p>E-posta ve geçici şifre ile üyeliği açın. Üye ilk girişinden sonra şifresini değiştirebilir.</p><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="member_account"/><input type="hidden" name="operation" value="create"/><label class="field">Görünen ad<input name="display_name" required minlength="2" maxlength="100" autocomplete="off"/></label><label class="field">E-posta<input name="email" type="email" required autocomplete="off"/></label><label class="field">Geçici şifre<input name="password" type="password" minlength="10" maxlength="128" required autocomplete="new-password"/></label><label class="field">Yetki grubu<select name="group_id" required>{groups.map((group)=><option value={group.id}>{group.name}</option>)}</select></label><button class="button">Üyeliği oluştur</button></form></section>
  <section class="studio-panel member-list"><div class="section-heading"><div><span class="eyebrow">ÜYELER</span><h2>{members.length} üyelik</h2></div><a class="text-link" href="/studio/?section=access">Yetki gruplarını düzenle →</a></div><div class="member-grid">{members.map((member)=>{const group=groups.find((entry)=>entry.id===member.permission_group_id);return <article class="member-card"><div class="member-avatar">{member.avatar_media_id?<img src={`/api/media/${member.avatar_media_id}/`} alt=""/>:(member.display_name||'P').slice(0,1).toUpperCase()}</div><div class="member-copy"><h3>{member.display_name||'Adsız üye'}</h3><p>{member.bio||'Henüz kısa tanıtım eklenmedi.'}</p><small>{new Date(member.created_at).toLocaleDateString('tr-TR')} · {member.role}</small></div>{member.id===user?.id?<strong class="member-self">Siz</strong>:<div class="member-actions"><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="member_group"/><input type="hidden" name="id" value={member.id}/><label>Yetki grubu<select name="group_id">{groups.map((entry)=><option value={entry.id} selected={entry.id===member.permission_group_id}>{entry.name}</option>)}</select></label><button type="submit">Uygula</button></form><details><summary>Üyeliği sil</summary><p>Profil, yorumlar ve oturum hesabı kalıcı olarak silinir.</p><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="member_account"/><input type="hidden" name="operation" value="delete"/><input type="hidden" name="id" value={member.id}/><button class="danger-button">Kalıcı olarak sil</button></form></details></div>}<span class="member-group">{group?.name??'Grup yok'}</span></article>})}</div></section>
</div> : <div class="access-admin"><section class="studio-panel"><span class="eyebrow">YETKİ GRUBU</span><h2>{selected?'Grubu düzenle':'Yeni grup oluştur'}</h2><p>Grubun temel rolü veritabanı güvenlik sınırını, ayrıntılı seçenekler ise Studio’da hangi araçların verileceğini tanımlar.</p><form class="permission-form" method="post" action="/api/studio/"><input type="hidden" name="entity" value="permission_group"/><input type="hidden" name="operation" value={selected?'update':'create'}/><input type="hidden" name="id" value={selected?.id??''}/><label class="field">Grup adı<input name="name" required minlength="2" maxlength="80" value={selected?.name??''}/></label><label class="field">Kısa açıklama<textarea name="description" maxlength="300">{selected?.description??''}</textarea></label><label class="field">Temel rol<select name="base_role"><option value="member" selected={selected?.base_role==='member'}>Üye · yalnız hesap ve yorum</option><option value="editor" selected={selected?.base_role==='editor'}>Editör · yayın araçları</option><option value="admin" selected={selected?.base_role==='admin'}>Yönetici · yönetim araçları</option></select></label><fieldset><legend>Yetki ayrıntıları</legend><div class="permission-grid">{Object.entries(permissionLabels).map(([key,label])=><label><input type="checkbox" name={`permission_${key}`} checked={selected?.permissions?.[key]??key==='comment'}/> <span><strong>{label}</strong><small>{key==='comment'?'Yayımlanmış içeriklere yorum gönderir.':key==='content'?'Yazı oluşturur, düzenler ve yayımlar.':key==='taxonomy'?'Kategori ve etiketleri düzenler.':key==='media'?'Görsel yükler ve yönetir.':key==='messages'?'İletişim mesajlarını görür.':key==='members'?'Üyelik oluşturur, siler ve grup atar.':key==='permissions'?'Yetki gruplarını oluşturur ve düzenler.':key==='audit'?'Yönetim işlem geçmişini görür.':'Site ayarlarını yönetir.'}</small></span></label>)}</div></fieldset><button class="button">Grubu kaydet</button></form></section><section class="studio-panel"><h2>Mevcut gruplar</h2><div class="access-list">{groups.map((group)=><article><div><h3>{group.name}{group.protected&&<small> · Sistem grubu</small>}</h3><p>{group.description}</p><span>{group.base_role} · {Object.values(group.permissions??{}).filter(Boolean).length} yetki</span></div><div><a class="text-link" href={`/studio/?section=access&edit=${group.id}`}>Düzenle</a>{!group.protected&&<form method="post" action="/api/studio/"><input type="hidden" name="entity" value="permission_group"/><input type="hidden" name="operation" value="delete"/><input type="hidden" name="id" value={group.id}/><button type="submit">Sil</button></form>}</div></article>)}</div></section></div>}
