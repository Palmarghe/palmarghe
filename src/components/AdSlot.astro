---
import { safeExternalUrl } from '../lib/site';
interface Props { placement: 'header' | 'article' | 'footer'; config?: Record<string, any>; locale: 'tr' | 'en'; }
const { placement, config = {}, locale } = Astro.props;
const legacySlot = config?.slots?.[placement];
const item = config?.placements?.[placement] ?? {};
const mode = item.mode ?? (config?.enabled && legacySlot ? 'google' : 'placeholder');
const publisher = String(config?.publisher_id ?? '');
const google = mode === 'google' && /^ca-pub-\d{10,20}$/.test(publisher) && /^\d{6,20}$/.test(String(legacySlot ?? ''));
const manual = mode === 'manual' && String(item.title ?? '').trim() && safeExternalUrl(String(item.url ?? ''));
const label = locale === 'tr' ? 'REKLAM ALANI' : 'ADVERTISEMENT';
---
{mode !== 'off' && <aside class={`ad-slot ad-slot--${placement} ad-slot--${mode}`} aria-label={locale === 'tr' ? 'Reklam alanı' : 'Advertisement area'} data-ad-slot={placement}>
  <span class="ad-slot-label">{label}</span>
  {google ? <><ins class="adsbygoogle" style="display:block" data-ad-client={publisher} data-ad-slot={String(legacySlot)} data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline set:html={`(adsbygoogle=window.adsbygoogle||[]).push({});`}/></>
  : manual ? <a class="ad-manual" href={String(item.url)} target="_blank" rel="sponsored noopener noreferrer"><strong>{String(item.title)}</strong>{item.description && <small>{String(item.description)}</small>}<span>{String(item.cta ?? (locale === 'tr' ? 'İncele' : 'Explore'))} →</span></a>
  : <div class="ad-placeholder"><strong>{locale === 'tr' ? 'Burada reklam alanı bulunur' : 'Advertising space'}</strong><small>{locale === 'tr' ? 'Studio’dan Google veya manuel yerleşim seçebilirsiniz.' : 'Choose a Google or manual placement in Studio.'}</small></div>}
</aside>}
