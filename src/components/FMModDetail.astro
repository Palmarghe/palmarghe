---
import { safeExternalUrl, type Locale } from '../lib/site';
interface Props { locale: Locale; typeData: Record<string,unknown>; itemId: string; }
const { locale, typeData, itemId } = Astro.props;
const tr = locale === 'tr';
const compatibility = String(typeData.compatibility ?? '').trim();
const version = String(typeData.mod_version ?? '').trim();
const size = String(typeData.size_label ?? '').trim();
const installation = String(typeData.installation ?? '').trim();
const changelog = String(typeData.changelog ?? '').trim();
const compatibilityNotes = String(typeData.compatibility_notes ?? '').trim();
const source = String(typeData.source_url ?? '');
const download = String(typeData.download_url ?? '');
---
<div class="fm-detail">
  {(compatibility || version || size) && <dl class="fm-facts">
    {version && <div><dt>{tr ? 'Sürüm' : 'Version'}</dt><dd>{version}</dd></div>}
    {compatibility && <div><dt>{tr ? 'FM uyumluluğu' : 'FM compatibility'}</dt><dd>{compatibility}</dd></div>}
    {size && <div><dt>{tr ? 'Dosya boyutu' : 'File size'}</dt><dd>{size}</dd></div>}
  </dl>}
  <slot />
  {compatibilityNotes && <section><h2>{tr ? 'Uyumluluk notları' : 'Compatibility notes'}</h2><p>{compatibilityNotes}</p></section>}
  {installation && <section><h2>{tr ? 'Kurulum' : 'Installation'}</h2><p>{installation}</p></section>}
  {changelog && <section><h2>{tr ? 'Değişiklikler' : 'Changelog'}</h2><p>{changelog}</p></section>}
  {(safeExternalUrl(source) || safeExternalUrl(download)) && <div class="fm-links">
    {safeExternalUrl(source) && <a class="text-link" href={source} target="_blank" rel="noopener noreferrer">{tr ? 'Kaynağı aç' : 'View source'} ↗</a>}
    {safeExternalUrl(download) && <a class="button" href={download} target="_blank" rel="noopener noreferrer" data-download={itemId}>{tr ? 'Harici indirme sayfasını aç' : 'Open external download page'} ↗</a>}
  </div>}
</div>
