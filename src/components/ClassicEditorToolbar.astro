<div class="classic-menubar"><strong>Yazı araçları</strong><div role="tablist" aria-label="Editör şeridi"><button type="button" role="tab" data-ribbon-tab="home" aria-selected="true">Biçim</button><button type="button" role="tab" data-ribbon-tab="insert" aria-selected="false">Ekle</button><button type="button" role="tab" data-ribbon-tab="view" aria-selected="false">Görünüm</button></div></div>
<div class="classic-ribbon" data-ribbon-panel="home">
  <div class="ribbon-group ribbon-history"><div><button type="button" data-editor="undo" aria-label="Geri al" title="Geri al (Ctrl+Z)">↶</button><button type="button" data-editor="redo" aria-label="Yinele" title="Yinele (Ctrl+Y)">↷</button></div><small>Geçmiş</small></div>
  <div class="ribbon-group ribbon-styles"><div><button type="button" data-editor="paragraph">Normal</button><button type="button" data-editor="heading2">Başlık 1</button><button type="button" data-editor="heading3">Başlık 2</button></div><small>Stiller</small></div>
  <div class="ribbon-group ribbon-font"><div><span class="classic-font-name">Calibri</span><span class="classic-font-size">12</span></div><div><button type="button" data-editor="bold" aria-label="Kalın"><b>K</b></button><button type="button" data-editor="italic" aria-label="İtalik"><i>İ</i></button><button type="button" data-editor="underline" aria-label="Altı çizili"><u>A</u></button><button type="button" data-editor="strike" aria-label="Üstü çizili"><s>abc</s></button><button type="button" data-editor="link" title="Bağlantı ekle (Ctrl+K)">🔗</button></div><small>Yazı tipi</small></div>
  <div class="ribbon-group ribbon-paragraph"><div><button type="button" data-editor="bullet" aria-label="Madde işaretleri">• Liste</button><button type="button" data-editor="ordered" aria-label="Numaralı liste">1. Liste</button><button type="button" data-editor="quote">❝</button></div><div><button type="button" data-editor="align-left" aria-label="Sola hizala">≡</button><button type="button" data-editor="align-center" aria-label="Ortala">≡</button><button type="button" data-editor="align-right" aria-label="Sağa hizala">≡</button><button type="button" data-editor="align-justify" aria-label="İki yana yasla">☰</button></div><small>Paragraf</small></div>
</div>
<div class="classic-ribbon" data-ribbon-panel="insert" hidden>
  <div class="ribbon-group"><div><button type="button" data-editor="media">🖼 Görsel</button><button type="button" data-editor="gallery">▦ Galeri</button></div><small>Görseller</small></div>
  <div class="ribbon-group"><div><button type="button" data-editor="table">▦ Tablo</button><button type="button" data-editor="divider">— Ayırıcı</button><button type="button" data-editor="quote">❝ Alıntı</button></div><small>Belge</small></div>
  <div class="ribbon-group"><div><button type="button" data-editor="callout">ⓘ Bilgi kutusu</button><button type="button" data-editor="cta">▣ Buton</button><button type="button" data-editor="embed">▶ Video</button><button type="button" data-editor="code">&lt;/&gt; Kod</button></div><small>Zengin içerik</small></div>
</div>
<div class="classic-ribbon" data-ribbon-panel="view" hidden>
  <div class="ribbon-group"><div><button type="button" data-editor="focus">⛶ Odak modu</button></div><small>Görünüm</small></div>
  <div class="ribbon-group ribbon-zoom"><label>Yakınlaştır <input type="range" min="80" max="140" value="100" step="10" data-editor-zoom><output>100%</output></label><small>Yakınlaştırma</small></div>
</div>
