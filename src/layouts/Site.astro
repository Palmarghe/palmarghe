---
import { copy, nav, pathFor, safeExternalUrl, type Locale } from '../lib/site';
import { createClient } from '@supabase/supabase-js';
import { localTestRequest, supabase } from '../lib/supabase';
import { runtimeSecret } from '../lib/runtime-secrets';
import AdSlot from '../components/AdSlot.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { socialPlatforms } from '../lib/social';
import '../styles/global.css';
interface Props { locale: Locale; title?: string; description?: string; alternate?: string; noindex?: boolean; structuredData?: Record<string, unknown>; ogImage?: string; ogAlt?: string; ogType?: 'article' | 'website'; canonicalOverride?: string; }
const { locale, title, description, alternate, noindex = false, structuredData, ogImage, ogAlt, ogType = 'website', canonicalOverride } = Astro.props;
const t = copy[locale];
const siteTitle = title ? `${title} — Palmarghe` : 'Palmarghe';
const canonical = canonicalOverride && safeExternalUrl(canonicalOverride) ? canonicalOverride : new URL(Astro.url.pathname, 'https://palmarghe.com').href;
const socialImage = ogImage && (safeExternalUrl(ogImage) || ogImage.startsWith('/') && !ogImage.startsWith('//')) ? new URL(ogImage, 'https://palmarghe.com').href : 'https://palmarghe.com/visuals/og-default.webp';
const activePath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => { const path = new URL(href, 'https://palmarghe.com').pathname.replace(/\/$/, '') || '/'; return activePath === path || (path !== '/' && activePath.startsWith(`${path}/`)); };
const alternatePath = alternate;
const db = supabase(Astro.cookies, Astro.request);
// Scheduled publications become visible at their timestamp without a database write.
// The idempotent dispatcher runs with the Worker service key, never through a
// public database function grant. Local E2E keeps using the in-memory adapter.
if (db && localTestRequest(Astro.request)) await db.rpc('dispatch_due_author_follow_notifications');
else {
  const serviceKey = runtimeSecret('SUPABASE_SERVICE_ROLE_KEY');
  const serviceUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  if (serviceKey && serviceUrl) await createClient(serviceUrl, serviceKey, { auth: { persistSession: false } }).rpc('dispatch_due_author_follow_notifications');
}
const [{ data: dbCategories }, { data: dbNav }, { data: appearanceRow }, { data: socialRow }, { data: advertisingRow }] = db ? await Promise.all([
  db.from('categories').select('slug,name_tr,name_en').is('parent_id',null).eq('active',true).order('sort_order').limit(8),
  db.from('navigation').select('label,href').eq('locale',locale).eq('active',true).order('sort_order').limit(50),
  db.from('site_settings').select('value').eq('key','appearance').single(),
  db.from('site_settings').select('value').eq('key','social').single(),
  db.from('site_settings').select('value').eq('key','advertising').single(),
]) : [{ data: null }, { data: null }, { data: null }, { data: null }, { data: null }];
const categories: { slug: string; name_tr: string; name_en: string }[] = dbCategories ?? [];
const publicNav = categories.length ? categories.map((entry) => ({ slug: entry.slug, tr: entry.name_tr, en: entry.name_en })) : nav.slice(0,4);
const mainNav = [...publicNav, nav[4]];
const customNav: { label: string; href: string }[] = dbNav ?? [];
const accent = ({ violet: '#8b5cf6', blue: '#60a5fa', amber: '#fbbf24' } as Record<string,string>)[appearanceRow?.value?.accent] ?? '#8b5cf6';
const radius = appearanceRow?.value?.radius === 'subtle' ? '4px' : '0px';
const socialLinks = socialPlatforms.map((platform) => ({ ...platform, url: String(socialRow?.value?.[platform.key] ?? '') })).filter(({url}) => safeExternalUrl(url));
const pageStructuredData = structuredData ?? (['/', '/en'].includes(activePath) ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://palmarghe.com/#organization',
      name: 'Palmarghe',
      url: 'https://palmarghe.com/',
      ...(socialLinks.length ? { sameAs: socialLinks.map(({url}) => url) } : {}),
    },
    {
      '@type': 'WebSite',
      '@id': 'https://palmarghe.com/#website',
      name: 'Palmarghe',
      url: 'https://palmarghe.com/',
      inLanguage: ['tr', 'en'],
      publisher: { '@id': 'https://palmarghe.com/#organization' },
    },
  ],
} : undefined);
const advertising = advertisingRow?.value ?? {};
const adsEnabled = advertising?.enabled === true && /^ca-pub-\d{10,20}$/.test(String(advertising?.publisher_id ?? ''));
---
<!doctype html>
<html lang={locale}>
  <head><link rel="manifest" href="/manifest.webmanifest"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B0B0D" />
    <title>{siteTitle}</title>
    <meta name="description" content={description ?? t.descriptor} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    {alternatePath && <link rel="alternate" hreflang={locale === 'tr' ? 'en' : 'tr'} href={new URL(alternatePath, 'https://palmarghe.com').href} />}
    {alternatePath && <link rel="alternate" hreflang="x-default" href={new URL(locale === 'tr' ? Astro.url.pathname : alternatePath, 'https://palmarghe.com').href} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Palmarghe" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description ?? t.descriptor} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={ogAlt ?? title ?? 'Palmarghe'} />
    {socialImage.endsWith('/og-default.webp') && <><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/></>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description ?? t.descriptor} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={ogAlt ?? title ?? 'Palmarghe'} />
    {pageStructuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(pageStructuredData).replace(/</g,'\\u003c')}></script>}
    <noscript><style>@media(max-width:900px){.mobile-menu #mobile-nav{top:calc(100% + 10px);right:0;left:auto;display:grid;min-width:min(280px,calc(100vw - 32px));max-height:calc(100dvh - 110px);overflow:auto;opacity:1;visibility:visible;pointer-events:auto;transform:none;box-shadow:0 22px 50px rgba(0,0,0,.35)}}</style></noscript>
    {adsEnabled && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${advertising.publisher_id}`} crossorigin="anonymous"></script>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    {locale === 'tr' && <link rel="preload" href="/fonts/manrope-latin-ext.woff2" as="font" type="font/woff2" crossorigin />}
  </head>
  <body style={`--accent:${accent};--radius:${radius}`}>
    <a class="skip" href="#main">{locale === 'tr' ? 'İçeriğe geç' : 'Skip to content'}</a>
    <header class="site-header wrap">
      <a class="brand" href={pathFor(locale)} aria-label="Palmarghe home">
        <svg viewBox="0 0 48 56" role="img" aria-label="Palmarghe P monogram" width="30" height="35"><path d="M5 3 43 15v26H24V29h7v-5L17 20v34L5 50Z" fill="currentColor"/></svg>
        <span>PALMARGHE</span>
      </a>
      <nav class="desktop-nav" aria-label={locale === 'tr' ? 'Ana menü' : 'Main menu'}>
        {customNav.length ? customNav.map((item) => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{item.label}</a>) : mainNav.map((item) => <a href={pathFor(locale, item.slug)} aria-current={isActive(pathFor(locale,item.slug)) ? 'page' : undefined}>{item[locale]}</a>)}
      </nav>
      <div class="head-actions">
        <button type="button" class="theme-toggle" data-theme-toggle aria-label={locale === 'tr' ? 'Açık modu aç' : 'Enable light mode'} aria-pressed="false">◐</button>
        <button type="button" aria-label={t.search} class="search-icon" data-search-trigger><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg></button>
        <a href={alternatePath ?? pathFor(locale === 'tr' ? 'en' : 'tr')} lang={locale === 'tr' ? 'en' : 'tr'} aria-label={locale === 'tr' ? 'Switch to English' : 'Türkçeye geç'}>{locale === 'tr' ? 'EN' : 'TR'}</a>
        <a href={pathFor(locale, 'account')}>{t.account}</a>
      </div>
      <div class="mobile-menu"><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label={locale === 'tr' ? 'Menüyü aç' : 'Open menu'}><span></span><span></span><span></span></button><nav id="mobile-nav" aria-label={locale === 'tr' ? 'Mobil menü' : 'Mobile menu'}><div class="mobile-nav-sections">{customNav.length ? customNav.map((item) => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{item.label}</a>) : mainNav.map((item) => <a href={pathFor(locale, item.slug)} aria-current={isActive(pathFor(locale,item.slug)) ? 'page' : undefined}>{item[locale]}</a>)}</div><div class="mobile-nav-tools"><a href={pathFor(locale,'search')} data-search-trigger>{t.search}</a><a href={alternatePath ?? pathFor(locale === 'tr' ? 'en' : 'tr')} lang={locale === 'tr' ? 'en' : 'tr'} aria-label={locale === 'tr' ? 'Switch to English' : 'Türkçeye geç'}>{locale === 'tr' ? 'EN' : 'TR'}</a><a href={pathFor(locale,'account')}>{t.account}</a><button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">{locale === 'tr' ? 'Açık mod' : 'Light mode'}</button></div></nav></div>
    </header>
    <AdSlot placement="header" config={advertising} locale={locale}/>
    <main id="main"><slot /></main>
    <AdSlot placement="footer" config={advertising} locale={locale}/>
    <footer class="site-footer wrap"><form class="newsletter-signup" method="post" action="/api/newsletter/"><input type="hidden" name="locale" value={locale}/><label>{locale === 'tr' ? 'Yeni yayınlardan haberdar ol' : 'Get new work by email'}<span><input name="email" type="email" required autocomplete="email" placeholder="email@example.com"/><button type="submit">{locale === 'tr' ? 'Kaydol' : 'Subscribe'}</button></span></label><label class="newsletter-consent"><input name="consent" type="checkbox" required/> {locale === 'tr' ? <><a href={pathFor(locale,'privacy')}>Gizlilik Politikasını</a> okudum; bülten için e-posta adresimin işlenmesini kabul ediyorum.</> : <><a href={pathFor(locale,'privacy')}>Privacy Policy</a> accepted; I consent to processing my email for the newsletter.</>}</label><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"/></label></form><div class="footer-top"><span>PALMARGHE</span><span>{t.descriptor}</span></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Palmarghe</span><nav aria-label="Footer"><a href={pathFor(locale, 'about')}>{t.about}</a><a href={pathFor(locale, 'contact')}>{t.contact}</a><a href={pathFor(locale, 'privacy')}>{t.privacy}</a><a href={pathFor(locale, 'collections')}>{locale === 'tr' ? 'Koleksiyonlar' : 'Collections'}</a></nav>{socialLinks.length > 0 && <nav class="footer-social" aria-label={locale === 'tr' ? 'Sosyal medya' : 'Social media'}>{socialLinks.map(({label,path,url}) => <a href={url} target="_blank" rel="noopener noreferrer" aria-label={label} title={label}><SocialIcon path={path}/></a>)}</nav>}</div></footer>
  <dialog id="search-overlay" class="search-overlay" data-live-search data-locale={locale} aria-label={t.search}><form method="dialog" class="search-overlay-panel"><div class="search-overlay-head"><label class="search-input-label"><span class="sr-only">{t.search}</span><input aria-label={t.search} name="q" type="search" autocomplete="off" placeholder={locale === 'tr' ? 'İçerik, proje, FM modu veya deney ara…' : 'Search content, projects, FM mods or experiments…'}/></label><button type="button" data-search-close aria-label={locale === 'tr' ? 'Aramayı kapat' : 'Close search'}>×</button></div><div class="search-type-chips" aria-label={locale === 'tr' ? 'Yayın türü' : 'Publication type'}>{['','article','project','fm_mod','gallery','lab_entry'].map(type => <button type="button" data-search-type={type} aria-pressed={type === '' ? 'true' : 'false'}>{type === '' ? (locale === 'tr' ? 'Tümü' : 'All') : ({article: locale === 'tr' ? 'Yazı' : 'Article',project: locale === 'tr' ? 'Proje' : 'Project',fm_mod:'FM Mod',gallery:locale === 'tr' ? 'Galeri' : 'Gallery',lab_entry:'Lab'}[type])}</button>)}</div><p data-search-status aria-live="polite">{locale === 'tr' ? 'En az iki karakter yazın.' : 'Enter at least two characters.'}</p><div data-search-results></div><a class="text-link" href={pathFor(locale,'search')}>{locale === 'tr' ? 'Tüm sonuçları görüntüle →' : 'View all results →'}</a></form></dialog>
  <script is:inline src="/scripts/mobile-menu.js" defer></script>
  <script is:inline src="/scripts/mobile-secret.js" defer></script>
  <script is:inline src="/scripts/interactive-search.js?v=20261002-clear" defer></script>
  <script is:inline src="/scripts/comments.js" defer></script>
  <script is:inline src="/scripts/traffic.js" defer></script>
  <script is:inline src="/scripts/engagement.js" defer></script>
  <script is:inline src="/scripts/theme-toggle.js" defer></script>
  <script is:inline src="/scripts/cursor-glow.js?v=20261002-native-modal" defer></script>
  {Astro.url.pathname.includes('/account/') && <script is:inline src="/scripts/password-visibility.js" defer></script>}
  {Astro.url.pathname.includes('/account/') && <script is:inline src="/scripts/profile-editor.js" defer></script>}
  <script is:inline src="/scripts/service-worker-registration.js" defer></script></body>
</html>
