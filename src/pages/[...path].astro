---
import Site from '../layouts/Site.astro';
import { copy, nav, parsePath, pathFor, safeExternalUrl } from '../lib/site';
import { published, type ContentItem } from '../lib/content';
import { supabase, localTestRequest } from '../lib/supabase';
import { parseDocument, renderDocument } from '../lib/blocks';

const { locale, slug } = parsePath(Astro.url.pathname);
const t = copy[locale];
const localMode = localTestRequest(Astro.request);
const basePages = ['', 'ai', 'gaming', 'fm', 'fm/fm26', 'lab', 'archive', 'about', 'contact', 'search', 'account', 'privacy'];
const items = await published(Astro.cookies, Astro.request, locale);
let item: ContentItem | undefined;
if (!basePages.includes(slug)) item = items.find((entry) => entry.slug === slug);
const categoryDb = supabase(Astro.cookies, Astro.request);
const { data: rootCategories } = categoryDb ? await categoryDb.from('categories').select('id,slug,name_tr,name_en,parent_id').eq('active',true).order('sort_order').limit(100) : { data: null };
const allCategories: { id: string; slug: string; name_tr: string; name_en: string; parent_id: string | null }[] = rootCategories ?? [];
const dbCategory = allCategories.find((entry) => entry.slug === slug);
const valid = basePages.includes(slug) || Boolean(item) || Boolean(dbCategory);
if (!valid) Astro.response.status = 404;
const titleMap: Record<string, string> = { ai: 'AI', gaming: 'Gaming', fm: 'Football Manager', 'fm/fm26': 'FM26', lab: 'Lab', archive: locale === 'tr' ? 'Arşiv' : 'Archive', about: t.about, contact: t.contact, search: t.search, account: t.account, privacy: t.privacy };
const title = item?.seo_title ?? item?.title ?? (dbCategory ? dbCategory[locale === 'tr' ? 'name_tr' : 'name_en'] : titleMap[slug]) ?? (valid ? undefined : '404');
const { data: counterpart } = item?.translation_group && categoryDb ? await categoryDb.from('content_items').select('slug').eq('translation_group',item.translation_group).eq('locale',locale === 'tr' ? 'en' : 'tr').in('status',['published','scheduled']).lte('published_at',new Date().toISOString()).limit(1) : { data: null };
const alternate = counterpart?.[0]?.slug;
const alternatePath = alternate ? pathFor(locale === 'tr' ? 'en' : 'tr', alternate) : !item ? pathFor(locale === 'tr' ? 'en' : 'tr', basePages.includes(slug) ? slug : '') : undefined;
const query = Astro.url.searchParams.get('q')?.trim().slice(0, 100) ?? '';
let searchResults: ContentItem[] = [];
if (slug === 'search' && query) {
  const db = supabase(Astro.cookies, Astro.request);
  const safeQuery = query.replace(/[^\p{L}\p{N}\s-]/gu, '').trim();
  if (db && safeQuery) { const { data } = await db.from('content_items').select('id,locale,title,slug,excerpt,type,body,type_data,cover_url,published_at,featured,seo_title,seo_description,translation_group').eq('locale', locale).in('status', ['published','scheduled']).lte('published_at',new Date().toISOString()).or(`title.ilike.%${safeQuery}%,excerpt.ilike.%${safeQuery}%`).limit(30); searchResults = (data ?? []) as ContentItem[]; }
}
const { data: categoryLinks } = dbCategory && categoryDb ? await categoryDb.from('content_categories').select('content_id').eq('category_id',dbCategory.id) : { data: null };
const links: { content_id: string }[] = categoryLinks ?? [];
const linkedIds = new Set(links.map((link) => link.content_id));
const categoryItems = dbCategory ? items.filter((entry) => linkedIds.has(entry.id)) : ['ai','gaming','fm','lab'].includes(slug) ? items.filter((entry) => entry.slug.startsWith(`${slug}/`)) : slug === 'fm/fm26' ? items.filter((entry) => entry.slug.startsWith('fm/fm26/')) : items;
const archived = slug === 'archive' ? categoryItems.filter((entry) => !Astro.url.searchParams.get('type') || entry.type === Astro.url.searchParams.get('type')) : categoryItems;
const homeCategories = allCategories.length ? allCategories.filter((entry) => !entry.parent_id).map((entry) => ({ slug: entry.slug, tr: entry.name_tr, en: entry.name_en })) : nav.slice(0,4);
const { data: homepageRow } = categoryDb ? await categoryDb.from('site_settings').select('value').eq('key','homepage').single() : { data: null };
const homeValue = homepageRow?.value ?? {};
const homeVisible = (section: string) => homeValue?.visible?.[section] !== false;
const homeOrder = (section: string) => Number(homeValue?.order?.[section] ?? ({ featured: 1, categories: 2, latest: 3 } as Record<string,number>)[section]);
const accountDb = slug === 'account' ? supabase(Astro.cookies, Astro.request) : null;
const currentUser = accountDb ? (await accountDb.auth.getUser()).data.user : null;
const accountProfile = currentUser && accountDb ? (await accountDb.from('profiles').select('display_name').eq('id',currentUser.id).single()).data : null;
const articleBody = item?.body && typeof item.body === 'object' ? parseDocument(JSON.stringify(item.body)) : null;
const typeData = item?.type_data ?? {};
const structuredData = item ? { '@context': 'https://schema.org', '@type': item.type === 'article' ? 'Article' : 'CreativeWork', headline: item.title, description: item.excerpt ?? undefined, inLanguage: locale, datePublished: item.published_at ?? undefined, url: new URL(pathFor(locale,item.slug),'https://palmarghe.com').href, publisher: { '@type':'Organization', name:'Palmarghe' } } : undefined;
---
<Site locale={locale} title={title} description={item?.seo_description ?? item?.excerpt ?? undefined} alternate={alternatePath} noindex={['account','search'].includes(slug) || item?.indexable === false} structuredData={structuredData}>
  {slug === '' && <>
    <section class="hero wrap"><img class="hero-art" src="/visuals/hero-glass.webp" alt="" width="1600" height="900" fetchpriority="high" decoding="async"/><div class="hero-copy"><span class="eyebrow">PALMARGHE — INDEPENDENT DIGITAL JOURNAL</span><h1>{t.title}</h1><p>{t.descriptor}</p></div></section>
    <div class="home-sections">
      {homeVisible('featured') && <section class="section wrap" style={`order:${homeOrder('featured')}`}><div class="section-heading"><h2>{t.selected}</h2><span>01 / 03</span></div>{items.filter((entry) => entry.featured).length ? <div class="card-grid">{items.filter((entry) => entry.featured).slice(0,3).map((entry) => <a class="entry-card" href={pathFor(locale,entry.slug)}>{entry.cover_url && <img src={entry.cover_url} alt="" width="800" height="500" loading="lazy"/>}<span class="eyebrow">{entry.type.replace('_',' ')}</span><h3>{entry.title}</h3><p>{entry.excerpt}</p></a>)}</div> : <div class="empty">{t.empty}</div>}</section>}
      {homeVisible('categories') && <section class="section wrap" style={`order:${homeOrder('categories')}`}><div class="section-heading"><h2>{t.explore}</h2><span>AI / GAMING / FM / LAB</span></div><div class="categories">{homeCategories.map((entry,index) => <a class="category" href={pathFor(locale,entry.slug)}>{['ai','gaming','fm','lab'].includes(entry.slug) && <img src={`/visuals/category-${entry.slug}.webp`} alt="" width="720" height="720" loading="lazy" decoding="async"/>}<span>0{index+1} / {entry.slug.toUpperCase()}</span><strong>{entry[locale]} ↗</strong></a>)}</div></section>}
      {homeVisible('latest') && <section class="section wrap" style={`order:${homeOrder('latest')}`}><div class="section-heading"><h2>{t.latest}</h2><a class="text-link" href={pathFor(locale,'archive')}>{t.explore} ↗</a></div>{items.length ? <div class="card-grid">{items.slice(0,6).map((entry) => <a class="entry-card" href={pathFor(locale,entry.slug)}><span class="eyebrow">{entry.type.replace('_',' ')}</span><h3>{entry.title}</h3><p>{entry.excerpt}</p></a>)}</div> : <div class="empty">{t.empty}</div>}</section>}
    </div>
  </>}
  {slug !== '' && <div class="wrap"><header class="page-head"><span class="eyebrow">PALMARGHE / {slug.toUpperCase()}</span><h1>{title}</h1></header>
    {item && <article class="page-content">{item.cover_url && <img src={item.cover_url} alt="" width="1200" height="750"/>}<p>{item.excerpt}</p>{item.type === 'fm_mod' && <div class="filters"><span>{String(typeData.compatibility ?? '')}</span><span>{String(typeData.mod_version ?? '')}</span><span>{String(typeData.size_label ?? '')}</span></div>}{articleBody ? <div set:html={renderDocument(articleBody)}/> : typeof item.body === 'string' && <p>{item.body}</p>}{item.type === 'fm_mod' && <section><h2>{locale === 'tr' ? 'Kurulum' : 'Installation'}</h2><p>{String(typeData.installation ?? '')}</p><h2>{locale === 'tr' ? 'Değişiklikler' : 'Changelog'}</h2><p>{String(typeData.changelog ?? '')}</p><p>{String(typeData.compatibility_notes ?? '')}</p>{safeExternalUrl(String(typeData.download_url ?? '')) && <a class="button" href={String(typeData.download_url)} target="_blank" rel="noopener noreferrer" data-download={item.id}>{locale === 'tr' ? 'Harici indirme' : 'External download'} ↗</a>}</section>}{item.type === 'project' && safeExternalUrl(String(typeData.project_url ?? '')) && <p><a class="button" href={String(typeData.project_url)} target="_blank" rel="noopener noreferrer">{locale === 'tr' ? 'Projeyi aç' : 'Open project'} ↗</a></p>}{item.type === 'lab_entry' && <section><p>{String(typeData.experiment_note ?? '')}</p>{safeExternalUrl(String(typeData.experiment_url ?? '')) && <a class="text-link" href={String(typeData.experiment_url)} target="_blank" rel="noopener noreferrer">{locale === 'tr' ? 'Deneyi aç' : 'Open experiment'} ↗</a>}</section>}{item.type === 'gallery' && <p class="eyebrow">{locale === 'tr' ? 'Görsel çalışma' : 'Visual work'}</p>}</article>}
    {(Boolean(dbCategory) || ['ai','gaming','fm','fm/fm26','lab','archive'].includes(slug)) && <section class="section">{slug === 'fm' && <p><a class="text-link" href={pathFor(locale,'fm/fm26')}>FM26 ↗</a></p>}{slug === 'archive' && <form class="filters" method="get"><label for="type">{locale === 'tr' ? 'Tür' : 'Type'}</label><select id="type" name="type"><option value="">{locale === 'tr' ? 'Tümü' : 'All'}</option>{['article','project','fm_mod','gallery','lab_entry'].map((type) => <option value={type} selected={Astro.url.searchParams.get('type') === type}>{type.replace('_',' ')}</option>)}</select><button class="button" type="submit">{locale === 'tr' ? 'Filtrele' : 'Filter'}</button></form>}{archived.length ? <div class="card-grid">{archived.map((entry) => <a class="entry-card" href={pathFor(locale,entry.slug)}><span class="eyebrow">{entry.type.replace('_',' ')}</span><h3>{entry.title}</h3><p>{entry.excerpt}</p></a>)}</div> : <div class="empty">{t.empty}</div>}</section>}
    {slug === 'search' && <section class="page-content"><form method="get"><label class="field" for="q">{t.searchPlaceholder}<input id="q" type="search" name="q" value={query} maxlength="100"/></label><button class="button" type="submit">{t.searchButton}</button></form>{query && <section class="section"><h2>{t.search}</h2>{searchResults.length ? searchResults.map((entry) => <p><a class="text-link" href={pathFor(locale,entry.slug)}>{entry.title}</a></p>) : <p>{t.noResults}</p>}</section>}</section>}
    {slug === 'about' && <section class="page-content"><p>{t.descriptor}</p></section>}
    {slug === 'contact' && <section class="page-content">{Astro.url.searchParams.get('sent') === '1' && <p class="alert">{locale === 'tr' ? 'Mesaj alındı.' : 'Message received.'}</p>}{(import.meta.env.TURNSTILE_SITE_KEY || localMode) ? <form method="post" action="/api/contact/"><input type="hidden" name="locale" value={locale}/><div class="field" style="display:none"><label>Website<input name="website" tabindex="-1" autocomplete="off"/></label></div><label class="field">{locale === 'tr' ? 'Ad' : 'Name'}<input name="name" required maxlength="100" autocomplete="name"/></label><label class="field">Email<input name="email" type="email" required maxlength="254" autocomplete="email"/></label><label class="field">{locale === 'tr' ? 'Mesaj' : 'Message'}<textarea name="message" required minlength="10" maxlength="5000"></textarea></label><label class="field"><span><input type="checkbox" name="consent" required/> {locale === 'tr' ? 'Gizlilik açıklamasını okudum.' : 'I have read the privacy notice.'}</span></label>{localMode ? <input type="hidden" name="cf-turnstile-response" value="local-test-token"/> : <><div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY}></div><script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script></>}<button class="button" type="submit">{locale === 'tr' ? 'Gönder' : 'Send'}</button></form> : <p class="alert">{locale === 'tr' ? 'İletişim formu henüz yapılandırılmadı.' : 'Contact form is not configured yet.'}</p>}</section>}
    {slug === 'privacy' && <section class="page-content"><p>{locale === 'tr' ? 'İletişim formundaki bilgiler, mesajınıza yanıt vermek için saklanır. Üyelik bilgileri hesap hizmeti için işlenir. Talep için iletişim formunu kullanın.' : 'Contact form information is stored to respond to your message. Account information is processed to provide the account service. Use the contact form for requests.'}</p></section>}
    {slug === 'account' && <section class="page-content">{!accountDb ? <p class="alert">{locale === 'tr' ? 'Üyelik henüz yapılandırılmadı.' : 'Account access is not configured yet.'}</p> : currentUser ? <><p>{currentUser.email}</p><form method="post" action="/api/auth/"><input type="hidden" name="action" value="profile"/><input type="hidden" name="locale" value={locale}/><label class="field">{locale === 'tr' ? 'Görünen ad' : 'Display name'}<input name="display_name" maxlength="100" value={accountProfile?.display_name ?? ''}/></label><button class="button" type="submit">{locale === 'tr' ? 'Profili kaydet' : 'Save profile'}</button></form>{Astro.url.searchParams.get('reset') === '1' && <form method="post" action="/api/auth/"><input type="hidden" name="action" value="update_password"/><input type="hidden" name="locale" value={locale}/><label class="field">{locale === 'tr' ? 'Yeni şifre' : 'New password'}<input name="password" type="password" minlength="8" required autocomplete="new-password"/></label><button class="button" type="submit">{locale === 'tr' ? 'Şifreyi güncelle' : 'Update password'}</button></form>}<form method="post" action="/api/auth/"><input type="hidden" name="action" value="logout"/><input type="hidden" name="locale" value={locale}/><button class="button" type="submit">{locale === 'tr' ? 'Çıkış yap' : 'Log out'}</button></form><form class="section" method="post" action="/api/auth/"><input type="hidden" name="action" value="logout_all"/><input type="hidden" name="locale" value={locale}/><button class="button" type="submit">{locale === 'tr' ? 'Tüm oturumlardan çık' : 'Log out everywhere'}</button></form><form class="section" method="post" action="/api/auth/"><input type="hidden" name="action" value="delete_request"/><input type="hidden" name="locale" value={locale}/><p>{locale === 'tr' ? 'Hesap silme talebi yönetici incelemesine gönderilir.' : 'Account deletion requests are reviewed by an administrator.'}</p><button class="button" type="submit">{locale === 'tr' ? 'Hesap silme talebi gönder' : 'Request account deletion'}</button></form></> : <><form method="post" action="/api/auth/"><input type="hidden" name="action" value="login"/><input type="hidden" name="locale" value={locale}/><h2>{locale === 'tr' ? 'Giriş' : 'Log in'}</h2><label class="field">Email<input type="email" name="email" autocomplete="email" required/></label><label class="field">{locale === 'tr' ? 'Şifre' : 'Password'}<input type="password" name="password" autocomplete="current-password" required minlength="8"/></label><button class="button" type="submit">{locale === 'tr' ? 'Giriş yap' : 'Log in'}</button></form><form class="section" method="post" action="/api/auth/"><input type="hidden" name="action" value="signup"/><input type="hidden" name="locale" value={locale}/><h2>{locale === 'tr' ? 'Kayıt ol' : 'Sign up'}</h2><label class="field">Email<input type="email" name="email" autocomplete="email" required/></label><label class="field">{locale === 'tr' ? 'Şifre' : 'Password'}<input type="password" name="password" autocomplete="new-password" required minlength="8"/></label><label class="field"><span><input type="checkbox" name="consent" required/> {locale === 'tr' ? 'Gizlilik açıklamasını okudum.' : 'I have read the privacy notice.'}</span></label><button class="button" type="submit">{locale === 'tr' ? 'Kayıt ol' : 'Sign up'}</button></form><form class="section" method="post" action="/api/auth/"><input type="hidden" name="action" value="reset"/><input type="hidden" name="locale" value={locale}/><h2>{locale === 'tr' ? 'Şifremi unuttum' : 'Forgot password'}</h2><label class="field">Email<input type="email" name="email" required/></label><button class="button" type="submit">{locale === 'tr' ? 'Sıfırlama isteği' : 'Request reset'}</button></form></>}{Astro.url.searchParams.get('notice') && <p class="alert">{locale === 'tr' ? 'E-postanızı kontrol edin.' : 'Check your email.'}</p>}</section>}
    {!valid && <section class="page-content"><p>{locale === 'tr' ? 'Sayfa bulunamadı.' : 'Page not found.'}</p><a class="text-link" href={pathFor(locale)}>{locale === 'tr' ? 'Ana sayfa' : 'Home'}</a></section>}
  </div>}
</Site>
