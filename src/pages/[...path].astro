---
import Site from '../layouts/Site.astro';
import FMModDetail from '../components/FMModDetail.astro';
import { copy, contentTypeLabel, nav, parsePath, pathFor, safeExternalUrl } from '../lib/site';
import { published, type ContentItem } from '../lib/content';
import { supabase, localTestRequest } from '../lib/supabase';
import { parseDocument, renderDocument } from '../lib/blocks';

const { locale, slug } = parsePath(Astro.url.pathname);
const t = copy[locale];
const localMode = localTestRequest(Astro.request);
const basePages = ['', 'ai', 'gaming', 'fm', 'fm/fm26', 'lab', 'archive', 'about', 'contact', 'search', 'account', 'privacy', 'kvkk'];
const items = await published(Astro.cookies, Astro.request, locale);
let item: ContentItem | undefined;
if (!basePages.includes(slug)) item = items.find((entry) => entry.slug === slug);
const categoryDb = supabase(Astro.cookies, Astro.request);
const { data: rootCategories } = categoryDb ? await categoryDb.from('categories').select('id,slug,name_tr,name_en,parent_id,description_tr,description_en,seo').eq('active',true).order('sort_order').limit(100) : { data: null };
const allCategories: { id: string; slug: string; name_tr: string; name_en: string; parent_id: string | null; description_tr: string | null; description_en: string | null; seo: Record<string, unknown> }[] = rootCategories ?? [];
const dbCategory = allCategories.find((entry) => entry.slug === slug);
const categoryFallback: Record<string,{tr:string;en:string}> = {
  ai: {tr:'Yapay zekâ ile görsel üretim, hareketli anlatım ve üretim süreçlerinden seçilen çalışmalar.',en:'Selected work in AI image making, moving image and creative process.'},
  gaming: {tr:'Oyun dünyalarına, deneyimlerine ve üretimlerine dair notlar ve projeler.',en:'Notes and projects around game worlds, experiences and making.'},
  fm: {tr:'Football Manager için modlar, taktikler ve proje notları.',en:'Mods, tactics and project notes for Football Manager.'},
  lab: {tr:'Küçük prototipler, arayüz denemeleri ve açık uçlu dijital fikirler.',en:'Small prototypes, interface experiments and open-ended digital ideas.'},
};
const categoryDescription = dbCategory?.[locale === 'tr' ? 'description_tr' : 'description_en'] || categoryFallback[slug]?.[locale] || undefined;
const categorySeoTitle = typeof dbCategory?.seo?.[`title_${locale}`] === 'string' ? String(dbCategory.seo[`title_${locale}`]) : undefined;
const categorySeoDescription = typeof dbCategory?.seo?.[`description_${locale}`] === 'string' ? String(dbCategory.seo[`description_${locale}`]) : undefined;
const valid = basePages.includes(slug) || Boolean(item) || Boolean(dbCategory);
if (!valid) Astro.response.status = 404;
const titleMap: Record<string, string> = { ai: 'AI', gaming: 'Gaming', fm: 'Football Manager', 'fm/fm26': 'FM26', lab: 'Lab', archive: locale === 'tr' ? 'Arşiv' : 'Archive', about: t.about, contact: t.contact, search: t.search, account: t.account, privacy: t.privacy, kvkk: locale === 'tr' ? 'KVKK Aydınlatma Metni' : 'Personal Data Notice' };
const title = item?.seo_title ?? item?.title ?? categorySeoTitle ?? (dbCategory ? dbCategory[locale === 'tr' ? 'name_tr' : 'name_en'] : titleMap[slug]) ?? (valid ? undefined : '404');
const breadcrumbParts = slug.split('/').filter(Boolean);
const breadcrumbText = ['Palmarghe', ...breadcrumbParts.map((part,index) => {
  if (item && index === breadcrumbParts.length - 1) return item.title;
  const category = allCategories.find((entry) => entry.slug === part);
  return category?.[locale === 'tr' ? 'name_tr' : 'name_en'] ?? (index === breadcrumbParts.length - 1 ? title ?? part : part);
})].join(' / ');
const { data: counterpart } = item?.translation_group && categoryDb ? await categoryDb.from('content_items').select('slug').eq('translation_group',item.translation_group).eq('locale',locale === 'tr' ? 'en' : 'tr').in('status',['published','scheduled']).lte('published_at',new Date().toISOString()).limit(1) : { data: null };
const alternate = counterpart?.[0]?.slug;
const alternatePath = alternate ? pathFor(locale === 'tr' ? 'en' : 'tr', alternate) : !item ? pathFor(locale === 'tr' ? 'en' : 'tr', basePages.includes(slug) ? slug : '') : undefined;
const query = Astro.url.searchParams.get('q')?.trim().slice(0, 100) ?? '';
const searchType = Astro.url.searchParams.get('type') ?? '';
const contentTypes: ContentItem['type'][] = ['article','project','fm_mod','gallery','lab_entry'];
let searchResults: ContentItem[] = [];
if (slug === 'search' && query) {
  const db = supabase(Astro.cookies, Astro.request);
  const safeQuery = query.replace(/[^\p{L}\p{N}\s-]/gu, '').trim();
  if (db && safeQuery) { let request = db.from('content_items').select('id,locale,title,slug,excerpt,type,body,type_data,cover_url,cover_media_id,published_at,featured,seo_title,seo_description,canonical_override,og_media_id,translation_group').eq('locale', locale).in('status', ['published','scheduled']).lte('published_at',new Date().toISOString()).or(`title.ilike.%${safeQuery}%,excerpt.ilike.%${safeQuery}%`).limit(30); if (contentTypes.includes(searchType as ContentItem['type'])) request = request.eq('type', searchType); const { data } = await request; searchResults = (data ?? []) as ContentItem[]; }
}
const { data: categoryLinks } = dbCategory && categoryDb ? await categoryDb.from('content_categories').select('content_id').eq('category_id',dbCategory.id) : { data: null };
const links: { content_id: string }[] = categoryLinks ?? [];
const linkedIds = new Set(links.map((link) => link.content_id));
const categoryItems = dbCategory ? items.filter((entry) => linkedIds.has(entry.id)) : ['ai','gaming','fm','lab'].includes(slug) ? items.filter((entry) => entry.slug.startsWith(`${slug}/`)) : slug === 'fm/fm26' ? items.filter((entry) => entry.slug.startsWith('fm/fm26/')) : items;
const archiveType = Astro.url.searchParams.get('type') ?? '';
const archiveCategory = Astro.url.searchParams.get('category') ?? '';
const archiveYear = Astro.url.searchParams.get('year') ?? '';
const archiveYears = [...new Set(items.map((entry) => entry.published_at?.slice(0,4)).filter((year): year is string => Boolean(year)))].sort().reverse();
const { data: archiveLinks } = slug === 'archive' && categoryDb && items.length ? await categoryDb.from('content_categories').select('content_id,category_id').in('content_id',items.map((entry) => entry.id)) : { data: null };
const archiveCategoryId = allCategories.find((entry) => entry.slug === archiveCategory)?.id;
const archived = slug === 'archive' ? categoryItems.filter((entry) => (!archiveType || entry.type === archiveType) && (!archiveCategory || Boolean(archiveCategoryId && archiveLinks?.some((link: {content_id:string;category_id:string}) => link.content_id === entry.id && link.category_id === archiveCategoryId))) && (!archiveYear || entry.published_at?.startsWith(archiveYear))) : categoryItems;
const homeCategories = allCategories.length ? allCategories.filter((entry) => !entry.parent_id).map((entry) => ({ slug: entry.slug, tr: entry.name_tr, en: entry.name_en })) : nav.slice(0,4);
const featuredItems = items.filter((entry) => entry.featured).slice(0,3);
const nowItems = items.slice(0,5);
const fmSpotlight = items.find((entry) => entry.type === 'fm_mod' || entry.slug.startsWith('fm/'));
const labNotes = items.filter((entry) => entry.type === 'lab_entry' || entry.slug.startsWith('lab/')).slice(0,3);
const visualReel = items.filter((entry) => Boolean(entry.cover_url)).slice(0,6);
const { data: homepageRow } = categoryDb ? await categoryDb.from('site_settings').select('value').eq('key','homepage').single() : { data: null };
const homeValue = homepageRow?.value ?? {};
const homeVisible = (section: string) => homeValue?.visible?.[section] !== false;
const homeOrder = (section: string) => Number(homeValue?.order?.[section] ?? ({ now: 1, featured: 2, categories: 3, latest: 4, fm_spotlight: 5, lab_notes: 6, visual_reel: 7, archive_cta: 8 } as Record<string,number>)[section] ?? 99);
const emptyMessage = locale === 'tr' ? 'Bu alanda henüz yayımlanmış bir çalışma yok. Yeni çalışmalar hazırlandıkça burada yer alacak.' : 'No work has been published here yet. New work will appear here as it is ready.';
const accountDb = slug === 'account' ? supabase(Astro.cookies, Astro.request) : null;
const currentUser = accountDb ? (await accountDb.auth.getUser()).data.user : null;
const accountProfile = currentUser && accountDb ? (await accountDb.from('profiles').select('display_name').eq('id',currentUser.id).single()).data : null;
const articleBody = item?.body && typeof item.body === 'object' ? parseDocument(JSON.stringify(item.body)) : null;
const typeData = item?.type_data ?? {};
const galleryMediaIds = item?.type === 'gallery' && Array.isArray(typeData.gallery_media_ids) ? typeData.gallery_media_ids.filter((id): id is string => typeof id === 'string' && /^[0-9a-f-]{36}$/i.test(id)).slice(0,24) : [];
const { data: galleryRows } = galleryMediaIds.length && categoryDb ? await categoryDb.from('media').select('id,alt_tr,alt_en,caption_tr,caption_en').in('id',galleryMediaIds) : { data: null };
const galleryMedia = galleryMediaIds.map((id) => galleryRows?.find((row: {id:string}) => row.id === id)).filter((row): row is NonNullable<typeof row> => Boolean(row));
const coverIds = [...new Set(items.map((entry) => entry.cover_media_id).filter((id): id is string => Boolean(id)))];
const { data: coverRows } = coverIds.length && categoryDb ? await categoryDb.from('media').select('id,alt_tr,alt_en').in('id',coverIds) : { data: null };
const coverAlt = (entry: ContentItem) => { const row = coverRows?.find((media: {id:string}) => media.id === entry.cover_media_id); return (locale === 'tr' ? row?.alt_tr : row?.alt_en) || row?.alt_tr || entry.title; };
const [{ data: itemCategoryLinks }, { data: itemTagLinks }] = item && categoryDb ? await Promise.all([
  categoryDb.from('content_categories').select('category_id').eq('content_id',item.id),
  categoryDb.from('content_tags').select('tag_id').eq('content_id',item.id),
]) : [{ data: null }, { data: null }];
const itemCategories = (itemCategoryLinks ?? []).map((link: {category_id:string}) => allCategories.find((entry) => entry.id === link.category_id)).filter(Boolean) as typeof allCategories;
const relatedItems = item ? items.filter((entry) => entry.id !== item.id && (entry.type === item.type || entry.slug.split('/')[0] === item.slug.split('/')[0])).slice(0,3) : [];
const categoryHref = (entry: typeof allCategories[number]) => pathFor(locale, entry.parent_id ? `${allCategories.find((parent) => parent.id === entry.parent_id)?.slug ?? ''}/${entry.slug}` : entry.slug);
const { data: itemTagRows } = itemTagLinks?.length && categoryDb ? await categoryDb.from('tags').select('id,name_tr,name_en').in('id',itemTagLinks.map((link: {tag_id:string}) => link.tag_id)) : { data: null };
const structuredData = item ? { '@context': 'https://schema.org', '@type': item.type === 'article' ? 'Article' : 'CreativeWork', headline: item.title, description: item.excerpt ?? undefined, inLanguage: locale, datePublished: item.published_at ?? undefined, url: new URL(pathFor(locale,item.slug),'https://palmarghe.com').href, publisher: { '@type':'Organization', name:'Palmarghe' } } : undefined;
---
<Site locale={locale} title={title} description={item?.seo_description ?? item?.excerpt ?? categorySeoDescription ?? categoryDescription ?? undefined} alternate={alternatePath} canonicalOverride={item?.canonical_override ?? undefined} noindex={['account','search'].includes(slug) || item?.indexable === false || !valid} structuredData={structuredData} ogImage={item?.og_media_id ? `/api/media/${item.og_media_id}/` : item?.cover_url ?? undefined} ogAlt={item?.title} ogType={item?.type === 'article' ? 'article' : 'website'}>
  {slug === '' && <>
    <section class="hero wrap"><img class="hero-art" src="/visuals/hero-glass.webp" alt="" width="1600" height="900" fetchpriority="high" decoding="async"/><div class="hero-copy"><span class="eyebrow">{locale === 'tr' ? 'PALMARGHE — BAĞIMSIZ DİJİTAL YAYIN' : 'PALMARGHE — INDEPENDENT DIGITAL PUBLICATION'}</span><h1>{t.title}</h1><p>{t.descriptor}</p></div></section>
    <div class="home-sections">
      {homeVisible('now') && nowItems.length > 0 && <section class="now-strip wrap" style={`order:${homeOrder('now')}`} aria-label={locale === 'tr' ? 'Şu anda' : 'Now'}><span class="eyebrow">{locale === 'tr' ? 'ŞU ANDA' : 'NOW'}</span><div>{nowItems.map((entry) => <a href={pathFor(locale,entry.slug)}><span>{contentTypeLabel(locale,entry.type)}</span><strong>{entry.title}</strong></a>)}</div></section>}
      {homeVisible('featured') && featuredItems.length > 0 && <section class="section wrap featured-section" style={`order:${homeOrder('featured')}`}><div class="section-heading"><h2>{t.selected}</h2><span>{String(featuredItems.length).padStart(2,'0')} {locale === 'tr' ? 'çalışma' : 'works'}</span></div><div class="featured-grid">{featuredItems.map((entry,index) => <a class={`entry-card featured-card featured-card--${index + 1}`} href={pathFor(locale,entry.slug)}>{entry.cover_url && <img src={entry.cover_url} alt={coverAlt(entry)} width="1000" height="625" loading="lazy"/>}<div><span class="eyebrow">{contentTypeLabel(locale,entry.type)}</span><h3>{entry.title}</h3><p>{entry.excerpt}</p></div></a>)}</div></section>}
      {homeVisible('categories') && <section class="section wrap" style={`order:${homeOrder('categories')}`}><div class="section-heading"><h2>{t.explore}</h2><span>{homeCategories.map((entry) => entry[locale]).join(' / ')}</span></div><div class="categories">{homeCategories.map((entry,index) => <a class="category" href={pathFor(locale,entry.slug)}>{['ai','gaming','fm','lab'].includes(entry.slug) && <img src={`/visuals/editorial-${entry.slug}.webp`} alt="" width="1440" height="900" loading="lazy" decoding="async"/>}<span>{String(index+1).padStart(2,'0')} / {entry.slug.toUpperCase()}</span><strong>{entry[locale]} →</strong></a>)}</div></section>}
      {homeVisible('latest') && items.length > 0 && <section class="section wrap latest-section" style={`order:${homeOrder('latest')}`}><div class="section-heading"><h2>{t.latest}</h2><a class="text-link" href={pathFor(locale,'archive')}>{locale === 'tr' ? 'Tümünü gör' : 'View all'} →</a></div><div class="card-grid">{items.slice(0,6).map((entry) => <a class="entry-card" href={pathFor(locale,entry.slug)}>{entry.cover_url && <img src={entry.cover_url} alt={coverAlt(entry)} width="800" height="500" loading="lazy"/>}<span class="eyebrow">{contentTypeLabel(locale,entry.type)}</span><h3>{entry.title}</h3><p>{entry.excerpt}</p></a>)}</div></section>}
      {homeVisible('fm_spotlight') && fmSpotlight && <section class="spotlight wrap" style={`order:${homeOrder('fm_spotlight')}`}><span class="eyebrow">FM / SPOTLIGHT</span><a href={pathFor(locale,fmSpotlight.slug)}><div><span>{contentTypeLabel(locale,fmSpotlight.type)}</span><h2>{fmSpotlight.title}</h2><p>{fmSpotlight.excerpt}</p></div><strong>{locale === 'tr' ? 'Çalışmayı aç →' : 'Open work →'}</strong></a></section>}
      {homeVisible('lab_notes') && labNotes.length > 0 && <section class="section wrap lab-notes" style={`order:${homeOrder('lab_notes')}`}><div class="section-heading"><h2>{locale === 'tr' ? 'Lab notları' : 'Lab notes'}</h2></div>{labNotes.map((entry) => <a href={pathFor(locale,entry.slug)}><time>{entry.published_at && new Date(entry.published_at).toLocaleDateString(locale === 'tr' ? 'tr-TR' : 'en-US')}</time><strong>{entry.title}</strong></a>)}</section>}
      {homeVisible('visual_reel') && visualReel.length > 0 && <section class="visual-reel wrap" style={`order:${homeOrder('visual_reel')}`} aria-label={locale === 'tr' ? 'Görsel akış' : 'Visual reel'}><div class="section-heading"><h2>{locale === 'tr' ? 'Görsel akış' : 'Visual reel'}</h2></div><div>{visualReel.map((entry) => <a href={pathFor(locale,entry.slug)}><img src={entry.cover_url!} alt={coverAlt(entry)} width="640" height="480" loading="lazy"/><span>{entry.title}</span></a>)}</div></section>}
      {homeVisible('archive_cta') && <section class="archive-cta wrap" style={`order:${homeOrder('archive_cta')}`}><span class="eyebrow">{locale === 'tr' ? 'TÜM ÇALIŞMALAR' : 'ALL WORK'}</span><h2>{locale === 'tr' ? 'Arşivde daha fazla bağlam bulun.' : 'Find more context in the archive.'}</h2><a class="button" href={pathFor(locale,'archive')}>{locale === 'tr' ? 'Arşivi keşfet' : 'Explore archive'} →</a></section>}
    </div>
  </>}
  {slug !== '' && <div class="wrap"><header class="page-head"><span class="eyebrow">{breadcrumbText}</span><h1>{title}</h1></header>
    {item && <article class="page-content content-detail"><div class="content-meta"><span>{contentTypeLabel(locale,item.type)}</span>{item.published_at && <time datetime={item.published_at}>{new Date(item.published_at).toLocaleDateString(locale === 'tr' ? 'tr-TR' : 'en-US', { year:'numeric', month:'long', day:'numeric' })}</time>}{itemCategories.map((entry) => <a href={categoryHref(entry)}>{entry[locale === 'tr' ? 'name_tr' : 'name_en']}</a>)}</div>{item.cover_url && <img src={item.cover_url} alt={coverAlt(item)} width="1200" height="750"/>}<p>{item.excerpt}</p>{item.type === 'fm_mod' ? <FMModDetail locale={locale} typeData={typeData} itemId={item.id}>{articleBody ? <div set:html={renderDocument(articleBody)}/> : typeof item.body === 'string' && <p>{item.body}</p>}</FMModDetail> : articleBody ? <div set:html={renderDocument(articleBody)}/> : typeof item.body === 'string' && <p>{item.body}</p>}{item.type === 'project' && safeExternalUrl(String(typeData.project_url ?? '')) && <p><a class="button" href={String(typeData.project_url)} target="_blank" rel="noopener noreferrer">{locale === 'tr' ? 'Projeyi aç' : 'Open project'} ↗</a></p>}{item.type === 'lab_entry' && <section><p>{String(typeData.experiment_note ?? '')}</p>{safeExternalUrl(String(typeData.experiment_url ?? '')) && <a class="text-link" href={String(typeData.experiment_url)} target="_blank" rel="noopener noreferrer">{locale === 'tr' ? 'Deneyi aç' : 'Open experiment'} ↗</a>}</section>}{itemTagRows?.length > 0 && <div class="content-tags">{itemTagRows.map((tag: {id:string;name_tr:string;name_en:string}) => <span>#{tag[locale === 'tr' ? 'name_tr' : 'name_en']}</span>)}</div>}{item.type === 'gallery' && <section class="gallery-detail" aria-label={locale === 'tr' ? 'Galeri görselleri' : 'Gallery images'}>{galleryMedia.map((media) => <figure><a href={`/api/media/${media.id}/`} data-gallery-lightbox data-alt={(locale === 'tr' ? media.alt_tr : media.alt_en) || media.alt_tr || item.title} data-caption={(locale === 'tr' ? media.caption_tr : media.caption_en) || ''}><img src={`/api/media/${media.id}/`} alt={(locale === 'tr' ? media.alt_tr : media.alt_en) || media.alt_tr || item.title} loading="lazy" width="1200" height="800"/></a>{(locale === 'tr' ? media.caption_tr : media.caption_en) && <figcaption>{locale === 'tr' ? media.caption_tr : media.caption_en}</figcaption>}</figure>)}</section><dialog class="gallery-lightbox" data-gallery-dialog aria-label={locale === 'tr' ? 'Görsel önizleme' : 'Image preview'}><button type="button" data-gallery-close aria-label={locale === 'tr' ? 'Önizlemeyi kapat' : 'Close preview'}>×</button><img data-gallery-image alt=""/><p data-gallery-caption></p></dialog><script is:inline src="/scripts/gallery-lightbox.js" defer></script>}<footer class="content-detail-footer"><a class="text-link" href={`mailto:?subject=${encodeURIComponent(item.title)}&body=${encodeURIComponent(new URL(pathFor(locale,item.slug),'https://palmarghe.com').href)}`}>{locale === 'tr' ? 'E-postayla paylaş' : 'Share by email'} →</a><a class="text-link" href={pathFor(locale,'archive')}>{locale === 'tr' ? 'Arşivde devam et' : 'Continue in archive'} →</a></footer></article>}{relatedItems.length > 0 && <section class="section related-work"><div class="section-heading"><h2>{locale === 'tr' ? 'İlgili çalışmalar' : 'Related work'}</h2></div><div class="card-grid">{relatedItems.map((entry) => <a class="entry-card" href={pathFor(locale,entry.slug)}><span class="eyebrow">{contentTypeLabel(locale,entry.type)}</span><h3>{entry.title}</h3><p>{entry.excerpt}</p></a>)}</div></section>}
    {(Boolean(dbCategory) || ['ai','gaming','fm','fm/fm26','lab','archive'].includes(slug)) && <section class="section">{categoryDescription && <p class="category-intro">{categoryDescription}</p>}{slug === 'fm' && <p><a class="text-link" href={pathFor(locale,'fm/fm26')}>FM26 →</a></p>}{slug === 'archive' && <><form class="filters archive-filters" method="get"><label>{locale === 'tr' ? 'Tür' : 'Type'}<select name="type"><option value="">{locale === 'tr' ? 'Tümü' : 'All'}</option>{contentTypes.map((type) => <option value={type} selected={archiveType === type}>{contentTypeLabel(locale,type)}</option>)}</select></label><label>{locale === 'tr' ? 'Kategori' : 'Category'}<select name="category"><option value="">{locale === 'tr' ? 'Tümü' : 'All'}</option>{allCategories.map((entry) => <option value={entry.slug} selected={archiveCategory === entry.slug}>{entry[locale === 'tr' ? 'name_tr' : 'name_en']}</option>)}</select></label>{archiveYears.length > 1 && <label>{locale === 'tr' ? 'Yıl' : 'Year'}<select name="year"><option value="">{locale === 'tr' ? 'Tümü' : 'All'}</option>{archiveYears.map((year) => <option value={year} selected={archiveYear === year}>{year}</option>)}</select></label>}<button class="button" type="submit">{locale === 'tr' ? 'Filtrele' : 'Filter'}</button>{(archiveType || archiveCategory || archiveYear) && <a class="text-link" href={pathFor(locale,'archive')}>{locale === 'tr' ? 'Sıfırla' : 'Reset'}</a>}</form><p class="archive-count">{archived.length} {locale === 'tr' ? 'sonuç' : 'results'}</p></>}{archived.length ? <div class="card-grid">{archived.map((entry) => <a class="entry-card" href={pathFor(locale,entry.slug)}><span class="eyebrow">{contentTypeLabel(locale,entry.type)}</span><h3>{entry.title}</h3><p>{entry.excerpt}</p></a>)}</div> : <div class="empty"><span class="eyebrow">PALMARGHE / {title}</span><p>{emptyMessage}</p><a class="text-link" href={pathFor(locale,'archive')}>{locale === 'tr' ? 'Tüm alanları keşfet' : 'Explore all areas'} →</a></div>}</section>}
    {slug === 'search' && <section class="page-content search-content"><form class="search-form" method="get"><label class="field" for="q">{t.searchPlaceholder}<input id="q" type="search" name="q" value={query} maxlength="100" autocomplete="off"/></label><label class="field">{locale === 'tr' ? 'Tür' : 'Type'}<select name="type"><option value="">{locale === 'tr' ? 'Tümü' : 'All'}</option>{contentTypes.map((type) => <option value={type} selected={searchType === type}>{contentTypeLabel(locale,type)}</option>)}</select></label><button class="button" type="submit">{t.searchButton}</button>{(query || searchType) && <a class="text-link" href={pathFor(locale,'search')}>{locale === 'tr' ? 'Sıfırla' : 'Reset'}</a>}</form>{query && <section class="section"><h2>{locale === 'tr' ? 'Arama sonuçları' : 'Search results'}</h2><p class="archive-count">“{query}” · {searchResults.length} {locale === 'tr' ? 'sonuç' : 'results'}</p>{searchResults.length ? <div class="search-results">{searchResults.map((entry) => <a class="search-result" href={pathFor(locale,entry.slug)}>{entry.cover_url && <img src={entry.cover_url} alt={entry.title} width="240" height="150" loading="lazy"/>}<span class="eyebrow">{contentTypeLabel(locale,entry.type)} · {entry.published_at ? new Date(entry.published_at).toLocaleDateString(locale === 'tr' ? 'tr-TR' : 'en-US') : ''}</span><h3>{entry.title}</h3><p>{entry.excerpt}</p></a>)}</div> : <div class="empty"><p>{t.noResults}</p><a class="text-link" href={pathFor(locale,'archive')}>{locale === 'tr' ? 'Arşive göz at' : 'Browse the archive'} →</a></div>}</section>}</section>}
    {slug === 'about' && <section class="page-content about-content"><span class="eyebrow">{locale === 'tr' ? 'BAĞIMSIZ DİJİTAL YAYIN' : 'INDEPENDENT DIGITAL PUBLICATION'}</span><h2>{locale === 'tr' ? 'Üretim, oyun ve deney için bir alan.' : 'A place for making, playing and experimenting.'}</h2><p>{locale === 'tr' ? 'Palmarghe; yapay zekâ ile görsel denemeleri, oyun kültürünü, Football Manager çalışmalarını ve küçük dijital deneyleri bir araya getirir. Burada tamamlanan işler, süreç notları ve yeni fikirler kendi bağlamlarıyla yer alır.' : 'Palmarghe brings together visual experiments with AI, game culture, Football Manager work and small digital experiments. Finished work, process notes and new ideas each have a place here.'}</p><p>{locale === 'tr' ? 'Alanlar genişledikçe yeni çalışmalar yayına alınır. Bir proje hakkında konuşmak veya geri bildirim paylaşmak istersen iletişim sayfasını kullanabilirsin.' : 'New work appears as each area grows. To discuss a project or share feedback, use the contact page.'}</p><div class="about-links"><a class="button" href={pathFor(locale,'archive')}>{locale === 'tr' ? 'Çalışmaları keşfet' : 'Explore the work'} →</a><a class="text-link" href={pathFor(locale,'contact')}>{t.contact} →</a></div></section>}
    {slug === 'contact' && <section class="page-content contact-content">{Astro.url.searchParams.get('sent') === '1' && <p class="alert">{locale === 'tr' ? 'Mesaj alındı.' : 'Message received.'}</p>}{(import.meta.env.TURNSTILE_SITE_KEY || localMode) ? <form method="post" action="/api/contact/"><input type="hidden" name="locale" value={locale}/><div class="field" style="display:none"><label>Website<input name="website" tabindex="-1" autocomplete="off"/></label></div><label class="field">{locale === 'tr' ? 'Ad' : 'Name'}<input name="name" required maxlength="100" autocomplete="name"/></label><label class="field">Email<input name="email" type="email" required maxlength="254" autocomplete="email"/></label><label class="field">{locale === 'tr' ? 'Mesaj' : 'Message'}<textarea name="message" required minlength="10" maxlength="5000"></textarea></label><label class="field"><span><input type="checkbox" name="consent" required/> {locale === 'tr' ? 'Gizlilik açıklamasını okudum.' : 'I have read the privacy notice.'}</span></label>{localMode ? <input type="hidden" name="cf-turnstile-response" value="local-test-token"/> : <><div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY}></div><script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script></>}<button class="button" type="submit">{locale === 'tr' ? 'Gönder' : 'Send'}</button></form> : <p class="alert">{locale === 'tr' ? 'İletişim formu henüz yapılandırılmadı.' : 'Contact form is not configured yet.'}</p>}</section>}
    {slug === 'privacy' && <section class="page-content privacy-content">{locale === 'tr' ? <><p>Palmarghe, yayın ve hesap işlevleri için gereken verileri işler. Bu sayfa kullanılan hizmetleri ve talep yolunu açıklar.</p><h2>Hesap ve içerik</h2><p>Supabase Auth oturum açma, kayıt ve şifre sıfırlama işlemlerini yönetir. Supabase veritabanı profil, içerik ve yönetim kayıtlarını; Storage ise yüklenen medyayı tutar. Yetkili Studio kullanıcılarının işlemleri denetim kaydına yazılır.</p><h2>İletişim</h2><p>İletişim formundaki ad, e-posta ve mesaj yanıt verebilmek için saklanır. Formun kötüye kullanılmasını önlemek için Cloudflare Turnstile ve hız sınırı uygulanır.</p><h2>Barındırma ve dış bağlantılar</h2><p>Site Cloudflare Workers üzerinden sunulur. Dış indirme ve sosyal bağlantılar açıldığında ilgili üçüncü tarafın gizlilik kuralları geçerli olur. Palmarghe bu sayfalardaki işlemleri yönetmez.</p><h2>Talep ve saklama</h2><p>Hesap sayfasından silme talebi gönderebilirsiniz; talep yönetici tarafından incelenir. Veriler hizmet ve güvenlik ihtiyacı sürdüğü sürece tutulur. Erişim, düzeltme veya silme soruları için iletişim formunu kullanın.</p></> : <><p>Palmarghe processes the information needed to run the publication and account features. This page describes the services in use and how to make a request.</p><h2>Accounts and content</h2><p>Supabase Auth handles sign-in, registration and password resets. Supabase stores profiles, publication data and administration records; Storage holds uploaded media. Authorized Studio activity is recorded in an audit log.</p><h2>Contact</h2><p>The name, email address and message you submit are stored so we can respond. Cloudflare Turnstile and rate limits help prevent abuse.</p><h2>Hosting and external links</h2><p>Cloudflare Workers serves the site. External downloads and social links lead to third parties with their own privacy practices. Palmarghe does not control those destinations.</p><h2>Requests and retention</h2><p>You can request account deletion from the account page; an administrator reviews the request. Data is retained while needed to provide the service and protect it. Use the contact form for access, correction or deletion questions.</p></>}</section>}
    {slug === 'kvkk' && <section class="page-content privacy-content">{locale === 'tr' ? <><p>Bu aydınlatma metni, 6698 sayılı Kişisel Verilerin Korunması Kanunu kapsamında Palmarghe üyelik ve topluluk özelliklerinde işlenen kişisel verileri açıklar.</p><h2>Veri sorumlusu ve işlenen veriler</h2><p>Üyelik sırasında e-posta adresi, güvenli parola özeti, seçtiğiniz görünen ad ve hazır avatar tercihi işlenir. İçeriklere yazdığınız yorumlar hesabınızla ilişkilendirilir. Güvenlik amacıyla oturum ve işlem kayıtları tutulabilir.</p><h2>İşleme amaçları ve hukuki sebep</h2><p>Veriler hesabı oluşturmak, kimlik doğrulamak, profil ve yorum özelliklerini sunmak, kötüye kullanımı önlemek ve yasal talepleri karşılamak için; sözleşmenin kurulması, meşru menfaat, hukuki yükümlülük ve açık rıza sebeplerine dayanılarak işlenir.</p><h2>Aktarım, saklama ve güvenlik</h2><p>Cloudflare barındırma ve güvenlik; Supabase ise kimlik, veritabanı ve depolama altyapısı sağlar. Veriler hizmet için gerekli süre ve yasal saklama süreleri boyunca korunur; erişim yetkileri ve satır düzeyi güvenlik politikalarıyla sınırlandırılır.</p><h2>Haklarınız</h2><p>Verilerinize erişme, düzeltme, silme, işlemeyi sınırlama ve rızanızı geri çekme taleplerinizi iletişim sayfasından iletebilirsiniz. Hesap silme talebi hesap sayfasından da gönderilebilir.</p></> : <><p>This notice explains the personal data processed for Palmarghe accounts and community features.</p><h2>Data processed</h2><p>Your email address, protected password data, display name, preset avatar choice, comments and relevant security records are processed.</p><h2>Purposes and legal grounds</h2><p>Data is used to create and secure your account, provide profile and comment features, prevent abuse and respond to legal requests under contract, legitimate interest, legal obligation and consent grounds.</p><h2>Processors and retention</h2><p>Cloudflare provides hosting and security; Supabase provides authentication, database and storage infrastructure. Data is retained only as needed for the service and applicable legal periods, with access controls and row level security.</p><h2>Your rights</h2><p>Use the contact page to request access, correction, deletion, restriction or withdrawal of consent. You can also submit an account deletion request from your account page.</p></>}</section>}
    {slug === 'account' && <section class="page-content account-content">{!accountDb ? <p class="alert">{locale === 'tr' ? 'Üyelik henüz yapılandırılmadı.' : 'Account access is not configured yet.'}</p> : currentUser ? <><p>{currentUser.email}</p><form method="post" action="/api/auth/"><input type="hidden" name="action" value="profile"/><input type="hidden" name="locale" value={locale}/><label class="field">{locale === 'tr' ? 'Görünen ad' : 'Display name'}<input name="display_name" maxlength="100" value={accountProfile?.display_name ?? ''}/></label><button class="button" type="submit">{locale === 'tr' ? 'Profili kaydet' : 'Save profile'}</button></form>{Astro.url.searchParams.get('reset') === '1' && <form method="post" action="/api/auth/"><input type="hidden" name="action" value="update_password"/><input type="hidden" name="locale" value={locale}/><label class="field">{locale === 'tr' ? 'Yeni şifre' : 'New password'}<input name="password" type="password" minlength="8" required autocomplete="new-password"/></label><button class="button" type="submit">{locale === 'tr' ? 'Şifreyi güncelle' : 'Update password'}</button></form>}<form method="post" action="/api/auth/"><input type="hidden" name="action" value="logout"/><input type="hidden" name="locale" value={locale}/><button class="button" type="submit">{locale === 'tr' ? 'Çıkış yap' : 'Log out'}</button></form><form class="section" method="post" action="/api/auth/"><input type="hidden" name="action" value="logout_all"/><input type="hidden" name="locale" value={locale}/><button class="button" type="submit">{locale === 'tr' ? 'Tüm oturumlardan çık' : 'Log out everywhere'}</button></form><form class="section" method="post" action="/api/auth/"><input type="hidden" name="action" value="delete_request"/><input type="hidden" name="locale" value={locale}/><p>{locale === 'tr' ? 'Hesap silme talebi yönetici incelemesine gönderilir.' : 'Account deletion requests are reviewed by an administrator.'}</p><button class="button" type="submit">{locale === 'tr' ? 'Hesap silme talebi gönder' : 'Request account deletion'}</button></form></> : <><form method="post" action="/api/auth/"><input type="hidden" name="action" value="login"/><input type="hidden" name="locale" value={locale}/><h2>{locale === 'tr' ? 'Giriş' : 'Log in'}</h2><label class="field">Email<input type="email" name="email" autocomplete="email" required/></label><label class="field">{locale === 'tr' ? 'Şifre' : 'Password'}<input type="password" name="password" autocomplete="current-password" required minlength="8"/></label><button class="button" type="submit">{locale === 'tr' ? 'Giriş yap' : 'Log in'}</button></form><details class="account-disclosure"><summary>{locale === 'tr' ? 'Hesap oluştur' : 'Create an account'}</summary><form method="post" action="/api/auth/"><input type="hidden" name="action" value="signup"/><input type="hidden" name="locale" value={locale}/><h2>{locale === 'tr' ? 'Kayıt ol' : 'Sign up'}</h2><label class="field">Email<input type="email" name="email" autocomplete="email" required/></label><label class="field">{locale === 'tr' ? 'Şifre' : 'Password'}<input type="password" name="password" autocomplete="new-password" required minlength="8"/></label><label class="legal-consent"><input type="checkbox" name="privacy_consent" required/><span>{locale === 'tr' ? <> <a href="/privacy/" target="_blank">Gizlilik Politikasını</a> okudum ve kabul ediyorum.</> : <>I have read and accept the <a href="/en/privacy/" target="_blank">Privacy Policy</a>.</>}</span></label><label class="legal-consent"><input type="checkbox" name="kvkk_consent" required/><span>{locale === 'tr' ? <> <a href="/kvkk/" target="_blank">KVKK Aydınlatma Metnini</a> okudum; kişisel verilerimin açıklanan şekilde işlenmesini kabul ediyorum.</> : <>I have read the <a href="/en/kvkk/" target="_blank">Personal Data Notice</a> and consent to the described processing.</>}</span></label><button class="button" type="submit">{locale === 'tr' ? 'Kayıt ol' : 'Sign up'}</button></form></details><details class="account-disclosure"><summary>{locale === 'tr' ? 'Şifremi unuttum' : 'Forgot password'}</summary><form method="post" action="/api/auth/"><input type="hidden" name="action" value="reset"/><input type="hidden" name="locale" value={locale}/><h2>{locale === 'tr' ? 'Şifremi unuttum' : 'Forgot password'}</h2><label class="field">Email<input type="email" name="email" required/></label><button class="button" type="submit">{locale === 'tr' ? 'Sıfırlama isteği' : 'Request reset'}</button></form></details></>}{Astro.url.searchParams.get('notice') && <p class="alert">{locale === 'tr' ? 'E-postanızı kontrol edin.' : 'Check your email.'}</p>}</section>}
