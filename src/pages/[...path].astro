---
import Site from '../layouts/Site.astro';
import FMModDetail from '../components/FMModDetail.astro';
import AdSlot from '../components/AdSlot.astro';
import { copy, contentTypeLabel, nav, parsePath, pathFor, safeExternalUrl } from '../lib/site';
import { published, publishedBySlug, type ContentItem } from '../lib/content';
import { categoryPath, pageDescription } from '../lib/seo';
import { supabase, localTestRequest } from '../lib/supabase';
import { parseDocument, renderDocument, type Block } from '../lib/blocks';
import { mediaImageDimensions, publicImageDimensions, publicImageSrcSet, publicImageUrl } from '../lib/public-image';

const { locale, slug } = parsePath(Astro.url.pathname);
const t = copy[locale];
const localMode = localTestRequest(Astro.request);
const basePages = ['', 'ai', 'gaming', 'fm', 'fm/fm26', 'lab', 'archive', 'about', 'contact', 'search', 'account', 'privacy', 'kvkk', 'collections', 'tags', 'authors'];
const items = await published(Astro.cookies, Astro.request, locale);
const categoryDb = supabase(Astro.cookies, Astro.request);
// Independent reads share a request window; permissions, filters and fallbacks are unchanged.
const [{ data: rootCategories }, { data: advertisingRow }, { data: publishedCollections }, { data: publicTags }, { data: homepageRow }] = await Promise.all([
  categoryDb ? categoryDb.from('categories').select('id,slug,name_tr,name_en,parent_id,description_tr,description_en,seo').eq('active',true).order('sort_order').limit(100) : { data: null },
  categoryDb ? categoryDb.from('site_settings').select('value').eq('key','advertising').single() : { data: null },
  categoryDb ? categoryDb.from('editorial_collections').select('id,locale,slug,title,description,cover_media_id,sort_order').eq('locale',locale).eq('published',true).order('sort_order').limit(50) : { data: null },
  categoryDb ? categoryDb.from('tags').select('id,slug,name_tr,name_en').order('slug').limit(200) : { data: null },
  categoryDb ? categoryDb.from('site_settings').select('value').eq('key','homepage').single() : { data: null },
]);
let item: ContentItem | undefined;
if (!basePages.includes(slug)) item = items.find((entry) => entry.slug === slug) ?? await publishedBySlug(Astro.cookies, Astro.request, locale, slug);
const advertising = advertisingRow?.value ?? {};
const collections = publishedCollections ?? [];
const collectionSlug = slug.startsWith('collections/') ? slug.slice('collections/'.length) : '';
const selectedPublicCollection = collectionSlug ? collections.find((entry:{slug:string}) => entry.slug === collectionSlug) : undefined;
const { data: publicCollectionLinks } = selectedPublicCollection && categoryDb ? await categoryDb.from('editorial_collection_items').select('content_id,sort_order').eq('collection_id',selectedPublicCollection.id).order('sort_order') : { data: null };
const publicCollectionItems = (publicCollectionLinks ?? []).map((link:{content_id:string}) => items.find((entry)=>entry.id===link.content_id)).filter(Boolean) as ContentItem[];
const authorSlug = slug.startsWith('authors/') ? slug.slice('authors/'.length) : '';
const { data: publicAuthor } = authorSlug && categoryDb ? await categoryDb.rpc('get_public_author',{p_slug:authorSlug}) : { data: null };
const selectedPublicAuthor = Array.isArray(publicAuthor) ? publicAuthor[0] : publicAuthor;
const { data: publicAuthorItems } = selectedPublicAuthor && categoryDb ? await categoryDb.rpc('get_public_author_content',{p_slug:authorSlug,p_limit:20}) : { data: null };
const { data: publicAuthorViewer } = selectedPublicAuthor && categoryDb ? await categoryDb.auth.getUser() : { data: { user:null } };
const { data: publicAuthorFollowRows } = selectedPublicAuthor && publicAuthorViewer?.user && categoryDb ? await categoryDb.from('content_follows').select('target_id').eq('user_id',publicAuthorViewer.user.id).eq('target_kind','author').eq('target_id',selectedPublicAuthor.id).limit(1) : { data: null };
const followsPublicAuthor = Boolean(publicAuthorFollowRows?.length);const tagSlug = slug.startsWith('tags/') ? slug.slice('tags/'.length) : '';

const selectedPublicTag = tagSlug ? (publicTags ?? []).find((entry:{slug:string}) => entry.slug === tagSlug) : undefined;
const { data: publicTagLinks } = selectedPublicTag && categoryDb ? await categoryDb.from('content_tags').select('content_id').eq('tag_id',selectedPublicTag.id) : { data: null };
const publicTagIds = new Set((publicTagLinks ?? []).map((link:{content_id:string}) => link.content_id));
const publicTagItems = selectedPublicTag ? items.filter((entry) => publicTagIds.has(entry.id)) : [];
const allCategories: { id: string; slug: string; name_tr: string; name_en: string; parent_id: string | null; description_tr: string | null; description_en: string | null; seo: Record<string, unknown> }[] = rootCategories ?? [];
const dbCategory = allCategories.find((entry) => categoryPath(entry, allCategories) === slug);
const categoryFallback: Record<string,{tr:string;en:string}> = {
  ai: {tr:'Yapay zekâ ile görsel üretim, hareketli anlatım ve üretim süreçlerinden seçilen çalışmalar.',en:'Selected work in AI image making, moving image and creative process.'},
  gaming: {tr:'Oyun dünyalarına, deneyimlerine ve üretimlerine dair notlar ve projeler.',en:'Notes and projects around game worlds, experiences and making.'},
  fm: {tr:'Football Manager için modlar, taktikler ve proje notları.',en:'Mods, tactics and project notes for Football Manager.'},
  lab: {tr:'Küçük prototipler, arayüz denemeleri ve açık uçlu dijital fikirler.',en:'Small prototypes, interface experiments and open-ended digital ideas.'},
};
const categoryDescription = dbCategory?.[locale === 'tr' ? 'description_tr' : 'description_en'] || categoryFallback[slug]?.[locale] || undefined;
const categorySeoTitle = typeof dbCategory?.seo?.[`title_${locale}`] === 'string' ? String(dbCategory.seo[`title_${locale}`]).trim() || undefined : undefined;
const categorySeoDescription = typeof dbCategory?.seo?.[`description_${locale}`] === 'string' ? String(dbCategory.seo[`description_${locale}`]).trim() || undefined : undefined;
const valid = basePages.includes(slug) || Boolean(item) || Boolean(dbCategory) || Boolean(selectedPublicCollection) || Boolean(selectedPublicTag) || Boolean(selectedPublicAuthor);
if (!valid) Astro.response.status = 404;
const titleMap: Record<string, string> = { ai: 'AI', gaming: 'Gaming', fm: 'Football Manager', 'fm/fm26': 'FM26', lab: 'Lab', archive: locale === 'tr' ? 'Arşiv' : 'Archive', about: t.about, contact: t.contact, search: t.search, account: t.account, privacy: t.privacy, kvkk: locale === 'tr' ? 'KVKK Aydınlatma Metni' : 'Personal Data Notice', collections: locale === 'tr' ? 'Koleksiyonlar' : 'Collections', tags: locale === 'tr' ? 'Etiketler' : 'Tags' };
const title = item?.seo_title ?? item?.title ?? selectedPublicCollection?.title ?? (selectedPublicAuthor ? selectedPublicAuthor.display_name : undefined) ?? (selectedPublicTag ? `#${selectedPublicTag[locale === 'tr' ? 'name_tr' : 'name_en']}` : undefined) ?? categorySeoTitle ?? (dbCategory ? dbCategory[locale === 'tr' ? 'name_tr' : 'name_en'] : titleMap[slug]) ?? (valid ? undefined : '404');
const breadcrumbParts = slug.split('/').filter(Boolean);
const breadcrumbText = ['Palmarghe', ...breadcrumbParts.map((part,index) => {
  if (item && index === breadcrumbParts.length - 1) return item.title;
  const category = allCategories.find((entry) => entry.slug === part);
  return category?.[locale === 'tr' ? 'name_tr' : 'name_en'] ?? (index === breadcrumbParts.length - 1 ? title ?? part : part);
})].join(' / ');
const { data: counterpart } = item?.translation_group && categoryDb ? await categoryDb.from('content_items').select('slug').eq('translation_group',item.translation_group).eq('locale',locale === 'tr' ? 'en' : 'tr').in('status',['published','scheduled']).lte('published_at',new Date().toISOString()).limit(1) : { data: null };
const alternate = counterpart?.[0]?.slug;
const otherLocale = locale === 'tr' ? 'en' : 'tr';
const { data: alternateCollection } = selectedPublicCollection && categoryDb ? await categoryDb.from('editorial_collections').select('slug').eq('slug',collectionSlug).eq('locale',otherLocale).eq('published',true).limit(1) : { data: null };
const alternatePath = alternate ? pathFor(otherLocale, alternate) : !item && valid && (basePages.includes(slug) || dbCategory || selectedPublicTag || selectedPublicAuthor || alternateCollection?.length) ? pathFor(otherLocale,slug) : undefined;
const metadataDescription = item?.seo_description?.trim() || item?.excerpt?.trim() || selectedPublicCollection?.description?.trim() || selectedPublicAuthor?.bio?.trim() || categorySeoDescription?.trim() || categoryDescription?.trim() || pageDescription(locale,slug,title);
const query = Astro.url.searchParams.get('q')?.trim().slice(0, 100) ?? '';
const searchType = Astro.url.searchParams.get('type') ?? '';
const contentTypes: ContentItem['type'][] = ['article','project','fm_mod','gallery','lab_entry'];
let searchResults: ContentItem[] = [];
if (slug === 'search' && query) {
  const db = supabase(Astro.cookies, Astro.request);
  const safeQuery = query.replace(/[^\p{L}\p{N}\s-]/gu, '').trim();
  if (db && safeQuery) { let request = db.from('content_items').select('id,locale,title,slug,excerpt,type,body,type_data,cover_url,cover_media_id,published_at,featured,seo_title,seo_description,canonical_override,og_media_id,translation_group').eq('locale', locale).in('status', ['published','scheduled']).lte('published_at',new Date().toISOString()).or(`title.ilike.%${safeQuery}%,excerpt.ilike.%${safeQuery}%`).limit(30); if (contentTypes.includes(searchType as ContentItem['type'])) request = request.eq('type', searchType); const { data } = await request; searchResults = (data ?? []) as ContentItem[]; }
}
const { data: categoryLinks } = dbCategory && categoryDb ? await categoryDb.from('content_categories').select('content_id').eq('category_id',dbCategory.id) : { data: null };
const links: { content_id: string }[] = categoryLinks ?? [];
const linkedIds = new Set(links.map((link) => link.content_id));
const categoryItems = dbCategory ? items.filter((entry) => linkedIds.has(entry.id)) : ['ai','gaming','fm','lab'].includes(slug) ? items.filter((entry) => entry.slug.startsWith(`${slug}/`)) : slug === 'fm/fm26' ? items.filter((entry) => entry.slug.startsWith('fm/fm26/')) : items;
const archiveType = Astro.url.searchParams.get('type') ?? '';
const archiveCategory = Astro.url.searchParams.get('category') ?? '';
const archiveYear = Astro.url.searchParams.get('year') ?? '';
const archiveYears = [...new Set(items.map((entry) => entry.published_at?.slice(0,4)).filter((year): year is string => Boolean(year)))].sort().reverse();
const { data: archiveLinks } = slug === 'archive' && categoryDb && items.length ? await categoryDb.from('content_categories').select('content_id,category_id').in('content_id',items.map((entry) => entry.id)) : { data: null };
const archiveCategoryId = allCategories.find((entry) => entry.slug === archiveCategory)?.id;
const archived = slug === 'archive' ? categoryItems.filter((entry) => (!archiveType || entry.type === archiveType) && (!archiveCategory || Boolean(archiveCategoryId && archiveLinks?.some((link: {content_id:string;category_id:string}) => link.content_id === entry.id && link.category_id === archiveCategoryId))) && (!archiveYear || entry.published_at?.startsWith(archiveYear))) : categoryItems;
const homeCategories = allCategories.length ? allCategories.filter((entry) => !entry.parent_id).map((entry) => ({ slug: entry.slug, tr: entry.name_tr, en: entry.name_en })) : nav.slice(0,4);
let featuredItems = items.filter((entry) => entry.featured).slice(0,3);
let nowItems = items.slice(0,5);
let fmSpotlight = items.find((entry) => entry.type === 'fm_mod' || entry.slug.startsWith('fm/'));
const labNotes = items.filter((entry) => entry.type === 'lab_entry' || entry.slug.startsWith('lab/')).slice(0,3);
const fallbackCover: Record<string, string> = {
  ai: '/visuals/editorial-ai.webp',
  gaming: '/visuals/editorial-gaming.webp',
  fm: '/visuals/editorial-fm.webp',
  lab: '/visuals/editorial-lab.webp',
  music: '/visuals/music/anatolian-sub-ritual.webp',
};
const coverFor = (entry: ContentItem) => publicImageUrl(entry.cover_url) || fallbackCover[entry.slug.split('/')[0]] || '/visuals/hero-glass.webp';
let visualReel = items.slice(0,6);

const homeValue = homepageRow?.value ?? {};
const homeVisible = (section: string) => homeValue?.visible?.[section] !== false;
const heroSetting = homeValue?.hero ?? {};
const heroVisible = heroSetting.visible !== false;
const heroTitle = typeof heroSetting[`title_${locale}`] === 'string' && heroSetting[`title_${locale}`].trim() ? heroSetting[`title_${locale}`].trim() : t.title;
const heroDescriptor = typeof heroSetting[`descriptor_${locale}`] === 'string' && heroSetting[`descriptor_${locale}`].trim() ? heroSetting[`descriptor_${locale}`].trim() : t.descriptor;
const heroEyebrow = typeof heroSetting[`eyebrow_${locale}`] === 'string' && heroSetting[`eyebrow_${locale}`].trim() ? heroSetting[`eyebrow_${locale}`].trim() : (locale === 'tr' ? 'PALMARGHE — BAĞIMSIZ DİJİTAL YAYIN' : 'PALMARGHE — INDEPENDENT DIGITAL PUBLICATION');
const heroImage = typeof heroSetting.image_url === 'string' && (/^\/(visuals|api\/media)\//.test(heroSetting.image_url) || /^https:\/\//.test(heroSetting.image_url)) ? heroSetting.image_url : '/visuals/hero-glass.webp';
const heroMode = ['compact','editorial','text'].includes(heroSetting.mode) ? heroSetting.mode : 'compact';
const curation = homeValue?.curation ?? {};
const idsFor = (key:string, maximum:number) => Array.isArray(curation[key]) ? curation[key].filter((id:unknown):id is string => typeof id === 'string' && items.some((entry) => entry.id === id)).slice(0,maximum) : [];
const inConfiguredOrder = (ids:string[]) => ids.map((id) => items.find((entry) => entry.id === id)).filter((entry): entry is ContentItem => Boolean(entry));
const configuredFeatured = inConfiguredOrder(idsFor('featured_ids',3));
if (configuredFeatured.length) featuredItems = configuredFeatured;
const configuredSpotlight = typeof curation.spotlight_id === 'string' ? items.find((entry) => entry.id === curation.spotlight_id) : undefined;
if (configuredSpotlight) fmSpotlight = configuredSpotlight;
const reservedHomeIds = new Set([...featuredItems.map((entry) => entry.id), fmSpotlight?.id].filter(Boolean));
const latestItems = items.filter((entry) => !reservedHomeIds.has(entry.id)).slice(0,6);
const configuredReel = inConfiguredOrder(idsFor('visual_reel_ids',6));
visualReel = configuredReel.length ? configuredReel.filter((entry) => !reservedHomeIds.has(entry.id)) : items.filter((entry) => !reservedHomeIds.has(entry.id) && !latestItems.some((latest) => latest.id === entry.id)).slice(0,6);
nowItems = items.filter((entry) => !reservedHomeIds.has(entry.id)).slice(0,5);
const homeOrder = (section: string) => Number(homeValue?.order?.[section] ?? ({ now: 1, featured: 2, categories: 3, latest: 4, fm_spotlight: 5, lab_notes: 6, visual_reel: 7, archive_cta: 8 } as Record<string,number>)[section] ?? 99);
const emptyMessage = locale === 'tr' ? 'Bu alanda henüz yayımlanmış bir çalışma yok. Yeni çalışmalar hazırlandıkça burada yer alacak.' : 'No work has been published here yet. New work will appear here as it is ready.';
const accountDb = slug === 'account' ? supabase(Astro.cookies, Astro.request) : null;
const currentUser = accountDb ? (await accountDb.auth.getUser()).data.user : null;
const accountProfile = currentUser && accountDb ? (await accountDb.from('profiles').select('display_name,role,bio,avatar_key').eq('id',currentUser.id).single()).data : null;
const { data: itemAuthorRows } = item?.author_id && categoryDb ? await categoryDb.rpc('get_public_author_by_id',{p_id:item.author_id}) : { data: null };
const itemAuthor = Array.isArray(itemAuthorRows) ? itemAuthorRows[0] : itemAuthorRows;
const savedBookmarks = currentUser && accountDb ? (await accountDb.from('content_bookmarks').select('content_id,created_at').eq('user_id',currentUser.id).order('created_at',{ascending:false}).limit(30)).data ?? [] : [];
const accountNotifications = currentUser && accountDb ? (await accountDb.from('content_notifications').select('id,kind,title,href,created_at,read_at').eq('user_id',currentUser.id).order('created_at',{ascending:false}).limit(30)).data ?? [] : [];
const savedBookmarkIds = savedBookmarks.map((entry:{content_id:string})=>entry.content_id);
const { data: savedContentRows } = savedBookmarkIds.length && accountDb ? await accountDb.from('content_items').select('id,title,slug,locale,excerpt,type').in('id',savedBookmarkIds).in('status',['published','scheduled']).lte('published_at',new Date().toISOString()) : { data: null };
const savedContent = savedBookmarkIds.map((id:string)=>savedContentRows?.find((entry:{id:string})=>entry.id===id)).filter(Boolean) as {id:string;title:string;slug:string;locale:string;excerpt:string;type:ContentItem['type']}[];
const articleBody = item?.body && typeof item.body === 'object' ? parseDocument(JSON.stringify(item.body)) : null;
const containsEmbed = (block: Block): boolean => block.type === 'embed' || Boolean(block.content?.some(containsEmbed));
const articleHasEmbed = Boolean(articleBody?.content.some(containsEmbed));
const typeData = item?.type_data ?? {};
const galleryMediaIds = item?.type === 'gallery' && Array.isArray(typeData.gallery_media_ids) ? typeData.gallery_media_ids.filter((id): id is string => typeof id === 'string' && /^[0-9a-f-]{36}$/i.test(id)).slice(0,24) : [];
const { data: galleryRows } = galleryMediaIds.length && categoryDb ? await categoryDb.from('media').select('id,width,height,alt_tr,alt_en,caption_tr,caption_en').in('id',galleryMediaIds) : { data: null };
const galleryMedia = galleryMediaIds.map((id) => galleryRows?.find((row: {id:string}) => row.id === id)).filter((row): row is NonNullable<typeof row> => Boolean(row));
const coverIds = [...new Set([...items, ...(item ? [item] : [])].map((entry) => entry.cover_media_id).filter((id): id is string => Boolean(id)))];
const { data: coverRows } = coverIds.length && categoryDb ? await categoryDb.from('media').select('id,width,height,alt_tr,alt_en').in('id',coverIds) : { data: null };
const coverAlt = (entry: ContentItem) => { const row = coverRows?.find((media: {id:string}) => media.id === entry.cover_media_id); return (locale === 'tr' ? row?.alt_tr : row?.alt_en) || row?.alt_tr || entry.title; };
const coverDimensions = (entry: ContentItem) => {
  const source = coverFor(entry);
  const measured = publicImageDimensions(source);
  if (measured) return measured;
  // Only use a media row for its own authenticated/public proxy URL.
  let url: URL;
  try { url = new URL(source, 'https://palmarghe.com'); } catch { return {}; }
  if (url.origin !== 'https://palmarghe.com' || url.pathname !== `/api/media/${entry.cover_media_id}/`) return {};
  return mediaImageDimensions(coverRows?.find((row: {id:string}) => row.id === entry.cover_media_id)) ?? {};
};
const [{ data: itemCategoryLinks }, { data: itemTagLinks }] = item && categoryDb ? await Promise.all([
  categoryDb.from('content_categories').select('category_id').eq('content_id',item.id),
  categoryDb.from('content_tags').select('tag_id').eq('content_id',item.id),
]) : [{ data: null }, { data: null }];
const itemCategories = (itemCategoryLinks ?? []).map((link: {category_id:string}) => allCategories.find((entry) => entry.id === link.category_id)).filter(Boolean) as typeof allCategories;
const { data: relatedTagLinks } = itemTagLinks?.length && categoryDb ? await categoryDb.from('content_tags').select('content_id,tag_id').in('tag_id',itemTagLinks.map((link:{tag_id:string})=>link.tag_id)) : { data: null };
const relatedTagIds = new Set((relatedTagLinks ?? []).filter((link:{content_id:string})=>link.content_id !== item?.id).map((link:{content_id:string})=>link.content_id));
const relatedItems = item ? [...items.filter((entry) => relatedTagIds.has(entry.id)), ...items.filter((entry) => entry.id !== item.id && !relatedTagIds.has(entry.id) && (entry.type === item.type || entry.slug.split('/')[0] === item.slug.split('/')[0]))].slice(0,3) : [];
const categoryHref = (entry: typeof allCategories[number]) => pathFor(locale, categoryPath(entry, allCategories) ?? entry.slug);
const { data: itemTagRows } = itemTagLinks?.length && categoryDb ? await categoryDb.from('tags').select('id,slug,name_tr,name_en').in('id',itemTagLinks.map((link: {tag_id:string}) => link.tag_id)) : { data: null };
const itemViewer = item && categoryDb ? (await categoryDb.auth.getUser()).data.user : null;
const { data: savedRows } = item && itemViewer && categoryDb ? await categoryDb.from('content_bookmarks').select('content_id').eq('user_id',itemViewer.id).eq('content_id',item.id).limit(1) : { data: null };
const itemIsSaved = Boolean(savedRows?.length);
const pageUrl = new URL(pathFor(locale,slug),'https://palmarghe.com').href;
const breadcrumbEntries = valid && slug && !['account','search'].includes(slug) ? [
  { name:'Palmarghe', url:new URL(pathFor(locale),'https://palmarghe.com').href },
  ...breadcrumbParts.map((part,index) => {
    const ancestorPath = breadcrumbParts.slice(0,index+1).join('/');
    const ancestorCategory = allCategories.find(entry => categoryPath(entry,allCategories) === ancestorPath);
    const isCurrent = index === breadcrumbParts.length-1;
    if (!isCurrent && !ancestorCategory && !basePages.includes(ancestorPath)) return undefined;
    return { name:isCurrent ? item?.title ?? title ?? part : ancestorCategory?.[locale === 'tr' ? 'name_tr' : 'name_en'] ?? titleMap[ancestorPath] ?? part, url:new URL(pathFor(locale,ancestorPath),'https://palmarghe.com').href };
  }).filter((entry):entry is {name:string;url:string} => Boolean(entry)),
] : [];
const breadcrumbSchema = breadcrumbEntries.length > 1 ? { '@type':'BreadcrumbList', itemListElement:breadcrumbEntries.map((entry,index) => ({'@type':'ListItem',position:index+1,name:entry.name,item:entry.url})) } : undefined;
const contentSchema = item ? {
  '@type':item.type === 'article' ? 'Article' : 'CreativeWork', headline:item.title, description:item.excerpt ?? undefined,
  inLanguage:locale, datePublished:item.published_at ?? undefined, url:pageUrl,
  mainEntityOfPage:{'@type':'WebPage','@id':pageUrl},
  ...(item.cover_url ? {image:new URL(publicImageUrl(item.cover_url)!,'https://palmarghe.com').href} : {}),
  ...(itemAuthor?.display_name ? {author:{'@type':'Person',name:itemAuthor.display_name,...(itemAuthor.author_slug ? {url:new URL(pathFor(locale,`authors/${itemAuthor.author_slug}`),'https://palmarghe.com').href} : {})}} : {}),
  publisher:{'@type':'Organization',name:'Palmarghe',url:'https://palmarghe.com/'},
} : undefined;
const structuredData = contentSchema || breadcrumbSchema ? {'@context':'https://schema.org','@graph':[contentSchema,breadcrumbSchema].filter(Boolean)} : undefined;
---
<Site locale={locale} title={title} description={metadataDescription} alternate={alternatePath} canonicalOverride={item?.canonical_override ?? undefined} noindex={['account','search'].includes(slug) || item?.indexable === false || !valid} structuredData={structuredData} ogImage={item?.og_media_id ? `/api/media/${item.og_media_id}/` : publicImageUrl(item?.cover_url)} ogAlt={item?.title} ogType={item?.type === 'article' ? 'article' : 'website'}>
  {String(slug) === '' && <>
    {Astro.url.searchParams.get('newsletter') === '1' && <p class="alert wrap">{locale === 'tr' ? 'Bülten listesine kaydın alındı.' : 'You are on the newsletter list.'}</p>}
    {heroVisible && <section class={`hero hero--${heroMode} wrap`} data-hero-editable><img class="hero-art" src={heroImage} alt="" width="1600" height="900" fetchpriority="high" decoding="async"/><div class="hero-copy"><span class="eyebrow">{heroEyebrow}</span><h1>{heroTitle}</h1><p>{heroDescriptor}</p></div></section>}
    {String(slug) === '' && <AdSlot placement="article" config={advertising} locale={locale}/>} 
    <div class="home-sections">
