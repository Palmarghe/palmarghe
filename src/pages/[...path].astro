---
import Site from '../layouts/Site.astro';
import { copy, nav, parsePath, pathFor } from '../lib/site';
import { published, type ContentItem } from '../lib/content';
import { supabase } from '../lib/supabase';

const { locale, slug } = parsePath(Astro.url.pathname);
const t = copy[locale];
const basePages = ['', 'ai', 'gaming', 'fm', 'fm/fm26', 'lab', 'archive', 'about', 'contact', 'search', 'account', 'privacy'];
const items = await published(Astro.cookies, Astro.request, locale);
let item: ContentItem | undefined;
if (!basePages.includes(slug)) item = items.find((entry) => entry.slug === slug);
const valid = basePages.includes(slug) || Boolean(item);
if (!valid) Astro.response.status = 404;
const titleMap: Record<string, string> = { ai: 'AI', gaming: 'Gaming', fm: 'Football Manager', 'fm/fm26': 'FM26', lab: 'Lab', archive: locale === 'tr' ? 'Arşiv' : 'Archive', about: t.about, contact: t.contact, search: t.search, account: t.account, privacy: t.privacy };
const title = item?.seo_title ?? item?.title ?? titleMap[slug] ?? (valid ? undefined : '404');
const alternate = item?.translation_group ? items.find((other) => other.translation_group === item?.translation_group && other.locale !== locale)?.slug : undefined;
const alternatePath = alternate ? pathFor(locale === 'tr' ? 'en' : 'tr', alternate) : pathFor(locale === 'tr' ? 'en' : 'tr', basePages.includes(slug) ? slug : '');
const query = Astro.url.searchParams.get('q')?.trim().slice(0, 100) ?? '';
let searchResults: ContentItem[] = [];
if (slug === 'search' && query) {
  const db = supabase(Astro.cookies, Astro.request);
  if (db) { const { data } = await db.from('content_items').select('id,locale,title,slug,excerpt,type,body,cover_url,published_at,featured,seo_title,seo_description,translation_group').eq('locale', locale).eq('status', 'published').or(`title.ilike.%${query.replaceAll(',', '')}%,excerpt.ilike.%${query.replaceAll(',', '')}%`).limit(30); searchResults = (data ?? []) as ContentItem[]; }
}
const categoryItems = ['ai','gaming','fm','lab'].includes(slug) ? items.filter((entry) => entry.slug.startsWith(`${slug}/`)) : slug === 'fm/fm26' ? items.filter((entry) => entry.slug.startsWith('fm/fm26/')) : items;
const archived = slug === 'archive' ? categoryItems.filter((entry) => !Astro.url.searchParams.get('type') || entry.type === Astro.url.searchParams.get('type')) : categoryItems;
const accountDb = slug === 'account' ? supabase(Astro.cookies, Astro.request) : null;
const currentUser = accountDb ? (await accountDb.auth.getUser()).data.user : null;
---
<Site locale={locale} title={title} description={item?.seo_description ?? item?.excerpt ?? undefined} alternate={alternatePath} noindex={['account','search'].includes(slug)}>
  {slug === '' && <>
    <section class="hero wrap"><span class="eyebrow">PALMARGHE — INDEPENDENT DIGITAL JOURNAL</span><h1>{t.title}</h1><p>{t.descriptor}</p></section>
    <section class="section wrap"><div class="section-heading"><h2>{t.selected}</h2><span>01 / 03</span></div>{items.filter((entry) => entry.featured).length ? <div class="card-grid">{items.filter((entry) => entry.featured).slice(0,3).map((entry) => <a class="entry-card" href={pathFor(locale,entry.slug)}>{entry.cover_url && <img src={entry.cover_url} alt="" width="800" height="500" loading="lazy"/>}<span class="eyebrow">{entry.type.replace('_',' ')}</span><h3>{entry.title}</h3><p>{entry.excerpt}</p></a>)}</div> : <div class="empty">{t.empty}</div>}</section>
    <section class="section wrap"><div class="section-heading"><h2>{t.explore}</h2><span>AI / GAMING / FM / LAB</span></div><div class="categories">{nav.slice(0,4).map((entry,index) => <a class="category" href={pathFor(locale,entry.slug)}><span>0{index+1} / {entry.slug.toUpperCase()}</span><strong>{entry[locale]} ↗</strong></a>)}</div></section>
    <section class="section wrap"><div class="section-heading"><h2>{t.latest}</h2><a class="text-link" href={pathFor(locale,'archive')}>{t.explore} ↗</a></div>{items.length ? <div class="card-grid">{items.slice(0,6).map((entry) => <a class="entry-card" href={pathFor(locale,entry.slug)}><span class="eyebrow">{entry.type.replace('_',' ')}</span><h3>{entry.title}</h3><p>{entry.excerpt}</p></a>)}</div> : <div class="empty">{t.empty}</div>}</section>
  </>}
  {slug !== '' && <div class="wrap"><header class="page-head"><span class="eyebrow">PALMARGHE / {slug.toUpperCase()}</span><h1>{title}</h1></header>
    {item && <article class="page-content">{item.cover_url && <img src={item.cover_url} alt="" width="1200" height="750"/>}<p>{item.excerpt}</p>{typeof item.body === 'string' && <p>{item.body}</p>}{item.type === 'fm_mod' && <p>{locale === 'tr' ? 'İndirme bağlantıları içerik yayınlandığında görünür.' : 'Download links appear when content is published.'}</p>}</article>}
    {['ai','gaming','fm','fm/fm26','lab','archive'].includes(slug) && <section class="section">{slug === 'fm' && <p><a class="text-link" href={pathFor(locale,'fm/fm26')}>FM26 ↗</a></p>}{slug === 'archive' && <form class="filters" method="get"><label for="type">{locale === 'tr' ? 'Tür' : 'Type'}</label><select id="type" name="type"><option value="">{locale === 'tr' ? 'Tümü' : 'All'}</option>{['article','project','fm_mod','gallery','lab_entry'].map((type) => <option value={type} selected={Astro.url.searchParams.get('type') === type}>{type.replace('_',' ')}</option>)}</select><button class="button" type="submit">{locale === 'tr' ? 'Filtrele' : 'Filter'}</button></form>}{archived.length ? <div class="card-grid">{archived.map((entry) => <a class="entry-card" href={pathFor(locale,entry.slug)}><span class="eyebrow">{entry.type.replace('_',' ')}</span><h3>{entry.title}</h3><p>{entry.excerpt}</p></a>)}</div> : <div class="empty">{t.empty}</div>}</section>}
    {slug === 'search' && <section class="page-content"><form method="get"><label class="field" for="q">{t.searchPlaceholder}<input id="q" type="search" name="q" value={query} maxlength="100"/></label><button class="button" type="submit">{t.searchButton}</button></form>{query && <section class="section"><h2>{t.search}</h2>{searchResults.length ? searchResults.map((entry) => <p><a class="text-link" href={pathFor(locale,entry.slug)}>{entry.title}</a></p>) : <p>{t.noResults}</p>}</section>}</section>}
    {slug === 'about' && <section class="page-content"><p>{t.descriptor}</p></section>}
    {slug === 'contact' && <section class="page-content">{Astro.url.searchParams.get('sent') === '1' && <p class="alert">{locale === 'tr' ? 'Mesaj alındı.' : 'Message received.'}</p>}{import.meta.env.TURNSTILE_SITE_KEY ? <form method="post" action="/api/contact"><input type="hidden" name="locale" value={locale}/><div class="field" style="display:none"><label>Website<input name="website" tabindex="-1" autocomplete="off"/></label></div><label class="field">{locale === 'tr' ? 'Ad' : 'Name'}<input name="name" required maxlength="100" autocomplete="name"/></label><label class="field">Email<input name="email" type="email" required maxlength="254" autocomplete="email"/></label><label class="field">{locale === 'tr' ? 'Mesaj' : 'Message'}<textarea name="message" required minlength="10" maxlength="5000"></textarea></label><label class="field"><span><input type="checkbox" name="consent" required/> {locale === 'tr' ? 'Gizlilik açıklamasını okudum.' : 'I have read the privacy notice.'}</span></label><div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY}></div><script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script><button class="button" type="submit">{locale === 'tr' ? 'Gönder' : 'Send'}</button></form> : <p class="alert">{locale === 'tr' ? 'İletişim formu henüz yapılandırılmadı.' : 'Contact form is not configured yet.'}</p>}</section>}
    {slug === 'privacy' && <section class="page-content"><p>{locale === 'tr' ? 'İletişim formundaki bilgiler, mesajınıza yanıt vermek için saklanır. Üyelik bilgileri hesap hizmeti için işlenir. Talep için iletişim formunu kullanın.' : 'Contact form information is stored to respond to your message. Account information is processed to provide the account service. Use the contact form for requests.'}</p></section>}
    {slug === 'account' && <section class="page-content">{!accountDb ? <p class="alert">{locale === 'tr' ? 'Üyelik henüz yapılandırılmadı.' : 'Account access is not configured yet.'}</p> : currentUser ? <><p>{currentUser.email}</p>{Astro.url.searchParams.get('reset') === '1' && <form method="post" action="/api/auth"><input type="hidden" name="action" value="update_password"/><input type="hidden" name="locale" value={locale}/><label class="field">{locale === 'tr' ? 'Yeni şifre' : 'New password'}<input name="password" type="password" minlength="8" required autocomplete="new-password"/></label><button class="button" type="submit">{locale === 'tr' ? 'Şifreyi güncelle' : 'Update password'}</button></form>}<form method="post" action="/api/auth"><input type="hidden" name="action" value="logout"/><input type="hidden" name="locale" value={locale}/><button class="button" type="submit">{locale === 'tr' ? 'Çıkış yap' : 'Log out'}</button></form></> : <><form method="post" action="/api/auth"><input type="hidden" name="action" value="login"/><input type="hidden" name="locale" value={locale}/><h2>{locale === 'tr' ? 'Giriş' : 'Log in'}</h2><label class="field">Email<input type="email" name="email" autocomplete="email" required/></label><label class="field">{locale === 'tr' ? 'Şifre' : 'Password'}<input type="password" name="password" autocomplete="current-password" required minlength="8"/></label><button class="button" type="submit">{locale === 'tr' ? 'Giriş yap' : 'Log in'}</button></form><form class="section" method="post" action="/api/auth"><input type="hidden" name="action" value="signup"/><input type="hidden" name="locale" value={locale}/><h2>{locale === 'tr' ? 'Kayıt ol' : 'Sign up'}</h2><label class="field">Email<input type="email" name="email" autocomplete="email" required/></label><label class="field">{locale === 'tr' ? 'Şifre' : 'Password'}<input type="password" name="password" autocomplete="new-password" required minlength="8"/></label><label class="field"><span><input type="checkbox" name="consent" required/> {locale === 'tr' ? 'Gizlilik açıklamasını okudum.' : 'I have read the privacy notice.'}</span></label><button class="button" type="submit">{locale === 'tr' ? 'Kayıt ol' : 'Sign up'}</button></form><form class="section" method="post" action="/api/auth"><input type="hidden" name="action" value="reset"/><input type="hidden" name="locale" value={locale}/><h2>{locale === 'tr' ? 'Şifremi unuttum' : 'Forgot password'}</h2><label class="field">Email<input type="email" name="email" required/></label><button class="button" type="submit">{locale === 'tr' ? 'Sıfırlama isteği' : 'Request reset'}</button></form></>}{Astro.url.searchParams.get('notice') && <p class="alert">{locale === 'tr' ? 'E-postanızı kontrol edin.' : 'Check your email.'}</p>}</section>}
    {!valid && <section class="page-content"><p>{locale === 'tr' ? 'Sayfa bulunamadı.' : 'Page not found.'}</p><a class="text-link" href={pathFor(locale)}>{locale === 'tr' ? 'Ana sayfa' : 'Home'}</a></section>}
  </div>}
</Site>
