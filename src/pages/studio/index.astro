---
import { supabase } from '../../lib/supabase';
import '../../styles/global.css';
const db = supabase(Astro.cookies, Astro.request);
const user = db ? (await db.auth.getUser()).data.user : null;
const profile = user && db ? (await db.from('profiles').select('role').eq('id', user.id).single()).data : null;
const staff = profile?.role === 'admin' || profile?.role === 'editor';
const section = Astro.url.searchParams.get('section') ?? 'dashboard';
const sections = ['dashboard','content','categories','tags','media','messages','users','appearance','homepage','navigation','redirects','audit','settings'];
const sectionLabels: Record<string, string> = { dashboard:'Genel bakış', content:'İçerikler', categories:'Kategoriler', tags:'Etiketler', media:'Medya', messages:'Mesajlar', users:'Üyeler', appearance:'Görünüm', homepage:'Ana sayfa', navigation:'Menü', redirects:'Yönlendirmeler', audit:'İşlem geçmişi', settings:'Ayarlar' };
const content: Record<string, any>[] = staff && db ? (await db.from('content_items').select('id,title,locale,type,status,slug,published_at').order('updated_at',{ascending:false}).limit(100)).data ?? [] : [];
const categories: Record<string, any>[] = staff && db ? (await db.from('categories').select('id,slug,name_tr,name_en,parent_id,active,sort_order').order('sort_order')).data ?? [] : [];
const tags: Record<string, any>[] = staff && db ? (await db.from('tags').select('id,slug,name_tr,name_en').order('slug')).data ?? [] : [];
const messages: Record<string, any>[] = staff && db ? (await db.from('contact_messages').select('id,name,email,message,status,created_at').order('created_at',{ascending:false}).limit(50)).data ?? [] : [];
const media: Record<string, any>[] = staff && db ? (await db.from('media').select('id,path,mime,bytes,alt_tr,created_at').order('created_at',{ascending:false}).limit(100)).data ?? [] : [];
const navigation: Record<string, any>[] = staff && db ? (await db.from('navigation').select('id,locale,label,href,sort_order,active').order('sort_order')).data ?? [] : [];
const appearance = staff && db ? (await db.from('site_settings').select('value').eq('key','appearance').single()).data?.value : null;
const homepage = staff && db ? (await db.from('site_settings').select('value').eq('key','homepage').single()).data?.value : null;
const social = staff && db ? (await db.from('site_settings').select('value').eq('key','social').single()).data?.value : null;
const redirects: Record<string, any>[] = staff && db ? (await db.from('redirects').select('id,source_path,target_path,status_code').order('source_path')).data ?? [] : [];
const audit: Record<string, any>[] = profile?.role === 'admin' && db ? (await db.from('audit_logs').select('actor_id,action,entity,entity_id,created_at').order('created_at',{ascending:false}).limit(50)).data ?? [] : [];
const members: Record<string, any>[] = profile?.role === 'admin' && db ? (await db.from('profiles').select('id,display_name,role,created_at').order('created_at',{ascending:false}).limit(100)).data ?? [] : [];
const deletionRequests: Record<string, any>[] = profile?.role === 'admin' && db ? (await db.from('account_deletion_requests').select('id,user_id,status,created_at').order('created_at',{ascending:false}).limit(100)).data ?? [] : [];
const selectedId = Astro.url.searchParams.get('edit');
const selected = selectedId && staff && db ? (await db.from('content_items').select('*').eq('id',selectedId).single()).data : null;
const selectedContentCategory = selected && db ? (await db.from('content_categories').select('category_id').eq('content_id',selected.id).limit(1)).data?.[0]?.category_id : null;
const selectedContentTags: string[] = selected && db ? ((await db.from('content_tags').select('tag_id').eq('content_id',selected.id)).data ?? []).map((row: {tag_id:string}) => row.tag_id) : [];
const selectedCategory = section === 'categories' && selectedId ? categories.find((entry) => entry.id === selectedId) : null;
const selectedTag = section === 'tags' && selectedId ? tags.find((entry) => entry.id === selectedId) : null;
const selectedNav = section === 'navigation' && selectedId ? navigation.find((entry) => entry.id === selectedId) : null;
const selectedRedirect = section === 'redirects' && selectedId ? redirects.find((entry) => entry.id === selectedId) : null;
---
<!doctype html><html lang="tr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Studio — Palmarghe</title></head><body>
<div class="admin-shell"><aside class="admin-side"><a class="brand" href="/studio/"><svg viewBox="0 0 48 56" width="25" height="30" aria-hidden="true"><path d="M5 3 43 15v26H24V29h7v-5L17 20v34L5 50Z" fill="currentColor"/></svg><span>STUDIO</span></a>{staff && <nav aria-label="Studio">{sections.map((name) => <a href={`/studio/?section=${name}`} aria-current={section === name ? 'page' : undefined}>{sectionLabels[name]}</a>)}</nav>}</aside><main class="admin-main">
{!db ? <p class="alert">Supabase bağlantısı yapılandırılmadı.</p> : !user ? <><h1>Studio</h1><p>Yalnızca yetkili hesaplar.</p><form method="post" action="/api/auth/"><input type="hidden" name="action" value="login"/><input type="hidden" name="next" value="studio"/><label class="field">Email<input name="email" type="email" required/></label><label class="field">Şifre<input name="password" type="password" required/></label><button class="button">Giriş</button></form></> : !staff ? <><h1>Erişim yok</h1><p>Bu hesap Studio yetkisine sahip değil.</p></> : <>
<div class="section-heading admin-heading"><div><span class="eyebrow">PALMARGHE / STUDIO</span><h1>{sectionLabels[section] ?? section}</h1></div><span class="admin-role">{profile.role}</span></div>
{section === 'dashboard' && <><p class="admin-intro">Yayınını tek yerden yönet. Taslakları tamamla, gelen mesajları incele ve sitenin görünümünü düzenle.</p><div class="admin-stats"><a href="/studio/?section=content"><span>İçerikler</span><strong>{content.length}</strong><small>{content.filter((entry) => entry.status === 'draft').length} taslak · {content.filter((entry) => entry.status === 'published').length} yayında</small></a><a href="/studio/?section=messages"><span>Mesajlar</span><strong>{messages.filter((entry) => entry.status === 'unread').length}</strong><small>Okunmamış · toplam {messages.length}</small></a><a href="/studio/?section=media"><span>Medya</span><strong>{media.length}</strong><small>Yüklenen dosya</small></a></div><section class="admin-quick"><div><span class="eyebrow">SONRAKİ ADIM</span><h2>Çalışmanı yayına hazırla.</h2><p>Yeni bir içerik oluşturabilir veya mevcut taslağı düzenleyebilirsin.</p></div><a class="button" href="/studio/?section=content">İçerik oluştur ↗</a></section>{content.length > 0 && <section class="admin-recent"><h2>Son içerikler</h2><ul>{content.slice(0,5).map((entry) => <li><a href={`/studio/?section=content&edit=${entry.id}`}>{entry.title}</a><span>{entry.status}</span></li>)}</ul></section>}</>}
{section === 'content' && <><h2>{selected ? 'İçerik düzenle' : 'Yeni içerik'}</h2><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="content"/><input type="hidden" name="id" value={selected?.id ?? ''}/><label class="field">Başlık<input name="title" required maxlength="200" value={selected?.title ?? ''}/></label><label class="field">Slug<input name="slug" required pattern="[a-z0-9/-]+" value={selected?.slug ?? ''}/></label><label class="field">Çeviri grup UUID (TR/EN eşleştirme)<input name="translation_group" type="text" value={selected?.translation_group ?? ''} placeholder="Aynı UUID iki içerikte"/></label><label class="field">Dil<select name="locale"><option value="tr" selected={selected?.locale !== 'en'}>Türkçe</option><option value="en" selected={selected?.locale === 'en'}>English</option></select></label><label class="field">Kategori<select name="category_id"><option value="">Yok</option>{categories.map((entry) => <option value={entry.id} selected={selectedContentCategory === entry.id}>{entry.name_tr}</option>)}</select></label><label class="field">Etiketler (çoklu seçim)<select name="tag_ids" multiple size="5">{tags.map((entry) => <option value={entry.id} selected={selectedContentTags.includes(entry.id)}>{entry.name_tr}</option>)}</select></label><label class="field">Kapak görseli<select name="cover_media_id"><option value="">Yok</option>{media.map((entry) => <option value={entry.id} selected={selected?.cover_media_id === entry.id}>{entry.alt_tr ?? entry.path}</option>)}</select></label><label class="field">Tür<select name="type">{['article','project','fm_mod','gallery','lab_entry'].map((type) => <option value={type} selected={selected?.type === type}>{type}</option>)}</select></label><label class="field">Durum<select name="status">{['draft','scheduled','published','archived'].map((status) => <option value={status} selected={selected?.status === status}>{status}</option>)}</select></label><label><input type="checkbox" name="featured" checked={selected?.featured ?? false}/> Ana sayfada öne çıkar</label><input type="hidden" name="indexable" value="off"/><label><input type="checkbox" name="indexable" checked={selected?.indexable ?? true}/> Arama motoruna açık</label><label class="field">Zamanlı yayın (UTC)<input name="publish_at" type="datetime-local" value={selected?.status === 'scheduled' && selected?.published_at ? selected.published_at.slice(0,16) : ''}/></label><label class="field">Özet<textarea name="excerpt">{selected?.excerpt ?? ''}</textarea></label><div class="field"><span>İçerik</span><div class="editor-toolbar" role="toolbar" aria-label="İçerik biçimlendirme"><button type="button" data-editor="paragraph">P</button><button type="button" data-editor="heading2">H2</button><button type="button" data-editor="heading3">H3</button><button type="button" data-editor="bold">B</button><button type="button" data-editor="italic">I</button><button type="button" data-editor="bullet">Liste</button><button type="button" data-editor="quote">Alıntı</button><button type="button" data-editor="code">Kod</button><button type="button" data-editor="divider">Ayırıcı</button></div><div id="block-editor" data-content={JSON.stringify(selected?.body && typeof selected.body === 'object' ? selected.body : { type: 'doc', content: [{ type: 'paragraph', content: selected?.body ? [{ type: 'text', text: String(selected.body) }] : [] }] })}></div><textarea id="body-json" name="body" hidden required></textarea></div><label class="field">SEO başlığı<input name="seo_title" value={selected?.seo_title ?? ''}/></label><label class="field">SEO açıklaması<input name="seo_description" value={selected?.seo_description ?? ''}/></label><div data-type-section="fm_mod" hidden={selected?.type !== 'fm_mod'}><h3>FM Mod</h3><label class="field">Uyumluluk<input name="compatibility" value={selected?.type_data?.compatibility ?? ''}/></label><label class="field">Mod sürümü<input name="mod_version" value={selected?.type_data?.mod_version ?? ''}/></label><label class="field">Değişiklikler<textarea name="changelog">{selected?.type_data?.changelog ?? ''}</textarea></label><label class="field">Kurulum<textarea name="installation">{selected?.type_data?.installation ?? ''}</textarea></label><label class="field">İndirme URL<input name="download_url" type="url" value={selected?.type_data?.download_url ?? ''}/></label><label class="field">Kaynak URL<input name="source_url" type="url" value={selected?.type_data?.source_url ?? ''}/></label><label class="field">Dosya boyutu bilgisi<input name="size_label" value={selected?.type_data?.size_label ?? ''}/></label><label class="field">Uyumluluk notu<textarea name="compatibility_notes">{selected?.type_data?.compatibility_notes ?? ''}</textarea></label></div><div data-type-section="project" hidden={selected?.type !== 'project'}><h3>Proje</h3><label class="field">Proje URL<input name="project_url" type="url" value={selected?.type_data?.project_url ?? ''}/></label></div><div data-type-section="lab_entry" hidden={selected?.type !== 'lab_entry'}><h3>Lab</h3><label class="field">Deney notu<textarea name="experiment_note">{selected?.type_data?.experiment_note ?? ''}</textarea></label><label class="field">Video/Prototip URL<input name="experiment_url" type="url" value={selected?.type_data?.experiment_url ?? ''}/></label></div><button class="button">Kaydet</button></form><section class="section"><h2>İçerikler</h2><table class="admin-table"><thead><tr><th>Başlık</th><th>Dil</th><th>Durum</th><th></th></tr></thead><tbody>{content.map((entry) => <tr><td>{entry.title}</td><td>{entry.locale}</td><td>{entry.status}</td><td><a class="text-link" href={`/studio/?section=content&edit=${entry.id}`}>Düzenle</a> <a class="text-link" href={`/studio/preview/${entry.id}/`}>Önizle</a> <details><summary>Sil</summary><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="content"/><input type="hidden" name="operation" value="delete"/><input type="hidden" name="id" value={entry.id}/><button type="submit">Silmeyi onayla</button></form></details></td></tr>)}</tbody></table></section></>}
{section === 'categories' && <><h2>{selectedCategory ? 'Kategori düzenle' : 'Kategori ekle'}</h2><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="category"/><input type="hidden" name="operation" value={selectedCategory ? 'update' : 'create'}/><input type="hidden" name="id" value={selectedCategory?.id ?? ''}/><label class="field">Slug<input name="slug" required pattern="[a-z0-9-]+" value={selectedCategory?.slug ?? ''}/></label><label class="field">Türkçe ad<input name="name_tr" required value={selectedCategory?.name_tr ?? ''}/></label><label class="field">English name<input name="name_en" required value={selectedCategory?.name_en ?? ''}/></label><label class="field">Üst kategori<select name="parent_id"><option value="">Yok</option>{categories.filter((entry) => entry.id !== selectedCategory?.id).map((entry) => <option value={entry.id} selected={entry.id === selectedCategory?.parent_id}>{entry.name_tr}</option>)}</select></label><label class="field">Sıra<input name="sort_order" type="number" min="0" max="1000" value={selectedCategory?.sort_order ?? 0}/></label><label><input type="checkbox" name="active" checked={selectedCategory?.active ?? true}/> Aktif</label><button class="button">Kaydet</button></form><table class="admin-table"><tbody>{categories.map((entry) => <tr><td>{entry.name_tr}</td><td>{entry.slug}</td><td>{entry.active ? 'Aktif' : 'Pasif'}</td><td><a class="text-link" href={`/studio/?section=categories&edit=${entry.id}`}>Düzenle</a></td><td><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="category"/><input type="hidden" name="operation" value="delete"/><input type="hidden" name="id" value={entry.id}/><button type="submit">Sil</button></form></td></tr>)}</tbody></table></>}
{section === 'tags' && <><h2>{selectedTag ? 'Etiket düzenle' : 'Etiket ekle'}</h2><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="tag"/><input type="hidden" name="operation" value={selectedTag ? 'update' : 'create'}/><input type="hidden" name="id" value={selectedTag?.id ?? ''}/><label class="field">Slug<input name="slug" required pattern="[a-z0-9-]+" value={selectedTag?.slug ?? ''}/></label><label class="field">Türkçe ad<input name="name_tr" required value={selectedTag?.name_tr ?? ''}/></label><label class="field">English name<input name="name_en" required value={selectedTag?.name_en ?? ''}/></label><button class="button">Kaydet</button></form><table class="admin-table"><tbody>{tags.map((entry) => <tr><td>{entry.name_tr}</td><td>{entry.slug}</td><td><a class="text-link" href={`/studio/?section=tags&edit=${entry.id}`}>Düzenle</a></td><td><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="tag"/><input type="hidden" name="operation" value="delete"/><input type="hidden" name="id" value={entry.id}/><button type="submit">Sil</button></form></td></tr>)}</tbody></table></>}
{section === 'media' && <><h2>Medya yükle</h2><form method="post" action="/api/media/" enctype="multipart/form-data"><label class="field">Görsel (PNG, JPEG, WebP; en fazla 10 MB)<input type="file" name="file" accept="image/png,image/jpeg,image/webp" required/></label><label class="field">Alternatif metin<input name="alt_tr" maxlength="200" required/></label><button class="button" type="submit">Yükle</button></form><div class="card-grid section">{media.map((entry) => <div class="entry-card"><img src={`/api/media/${entry.id}/`} alt={entry.alt_tr ?? ''} width="400" height="250" loading="lazy"/><form method="post" action="/api/media/manage/"><input type="hidden" name="id" value={entry.id}/><input type="hidden" name="operation" value="update"/><label class="field">Alternatif metin<input name="alt_tr" required maxlength="200" value={entry.alt_tr ?? ''}/></label><button type="submit">Kaydet</button></form><small>{entry.mime} · {Math.round(entry.bytes/1024)} KB</small><details><summary>Sil</summary><form method="post" action="/api/media/manage/"><input type="hidden" name="id" value={entry.id}/><input type="hidden" name="operation" value="delete"/><button type="submit">Silmeyi onayla</button></form></details></div>)}</div></>}
{section === 'messages' && <table class="admin-table"><thead><tr><th>Gönderen</th><th>Mesaj</th><th>Durum</th></tr></thead><tbody>{messages.map((entry) => <tr><td>{entry.name}<br/>{entry.email}</td><td>{entry.message}</td><td><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="message"/><input type="hidden" name="id" value={entry.id}/><select name="status" aria-label="Mesaj durumu">{['unread','read','archived','spam'].map((status) => <option value={status} selected={entry.status === status}>{status}</option>)}</select><button type="submit">Kaydet</button></form></td></tr>)}</tbody></table>}
{section === 'appearance' && <>{profile.role === 'admin' ? <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="appearance"/><label class="field">Vurgu rengi<select name="accent"><option value="violet" selected={!appearance || appearance.accent === 'violet'}>Violet</option><option value="blue" selected={appearance?.accent === 'blue'}>Blue</option><option value="amber" selected={appearance?.accent === 'amber'}>Amber</option></select></label><label class="field">Köşe<select name="radius"><option value="sharp" selected={!appearance || appearance.radius === 'sharp'}>Sharp</option><option value="subtle" selected={appearance?.radius === 'subtle'}>Subtle</option></select></label><button class="button">Kaydet</button></form> : <p>Yalnız admin düzenleyebilir.</p>}</>}
{section === 'homepage' && <>{profile.role === 'admin' ? <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="homepage"/>{(['featured','categories','latest'] as const).map((name,index) => <div class="field"><label><input type="checkbox" name={`${name}_visible`} checked={homepage?.visible?.[name] !== false}/> {name}</label><label>Sıra<select name={`${name}_order`}>{[1,2,3].map((number) => <option value={number} selected={(homepage?.order?.[name] ?? index+1) === number}>{number}</option>)}</select></label></div>)}<button class="button">Kaydet</button></form> : <p>Yalnız admin düzenleyebilir.</p>}</>}
{section === 'navigation' && <>{profile.role === 'admin' && <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="navigation"/><input type="hidden" name="operation" value={selectedNav ? 'update' : 'create'}/><input type="hidden" name="id" value={selectedNav?.id ?? ''}/><label class="field">Dil<select name="locale"><option value="tr" selected={selectedNav?.locale !== 'en'}>TR</option><option value="en" selected={selectedNav?.locale === 'en'}>EN</option></select></label><label class="field">Başlık<input name="label" required maxlength="50" value={selectedNav?.label ?? ''}/></label><label class="field">Bağlantı<input name="href" required value={selectedNav?.href ?? ''}/></label><label class="field">Sıra<input name="sort_order" type="number" min="0" max="1000" value={selectedNav?.sort_order ?? 0}/></label><label><input name="active" type="checkbox" checked={selectedNav?.active ?? true}/> Aktif</label><p><button class="button">Kaydet</button></p></form>}<table class="admin-table"><tbody>{navigation.map((entry) => <tr><td>{entry.locale}</td><td>{entry.label}</td><td>{entry.href}</td><td><a href={`/studio/?section=navigation&edit=${entry.id}`}>Düzenle</a></td><td>{profile.role === 'admin' && <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="navigation"/><input type="hidden" name="operation" value="delete"/><input type="hidden" name="id" value={entry.id}/><button type="submit">Sil</button></form>}</td></tr>)}</tbody></table></>}
{section === 'redirects' && <>{profile.role === 'admin' && <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="redirect"/><input type="hidden" name="operation" value={selectedRedirect ? 'update' : 'create'}/><input type="hidden" name="id" value={selectedRedirect?.id ?? ''}/><label class="field">Eski yol<input name="source_path" required value={selectedRedirect?.source_path ?? ''} placeholder="/old/"/></label><label class="field">Yeni yol<input name="target_path" required value={selectedRedirect?.target_path ?? ''} placeholder="/new/"/></label><button class="button">Kaydet</button></form>}<table class="admin-table"><tbody>{redirects.map((entry) => <tr><td>{entry.source_path}</td><td>→</td><td>{entry.target_path}</td><td>{profile.role === 'admin' && <a href={`/studio/?section=redirects&edit=${entry.id}`}>Düzenle</a>}</td></tr>)}</tbody></table></>}
{section === 'audit' && <>{profile.role === 'admin' ? <table class="admin-table"><thead><tr><th>Zaman</th><th>İşlem</th><th>Varlık</th></tr></thead><tbody>{audit.map((entry) => <tr><td>{entry.created_at}</td><td>{entry.action}</td><td>{entry.entity} · {entry.entity_id}</td></tr>)}</tbody></table> : <p>Yalnız admin erişebilir.</p>}</>}
{section === 'users' && <>{profile.role === 'admin' ? <><h2>Üyeler</h2><table class="admin-table"><thead><tr><th>Kimlik</th><th>Ad</th><th>Rol</th></tr></thead><tbody>{members.map((entry) => <tr><td>{entry.id}</td><td>{entry.display_name ?? '—'}</td><td>{entry.id === user.id ? entry.role : <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="member_role"/><input type="hidden" name="id" value={entry.id}/><select name="role" aria-label="Üye rolü">{['member','editor','admin'].map((role) => <option value={role} selected={entry.role === role}>{role}</option>)}</select><button type="submit">Kaydet</button></form>}</td></tr>)}</tbody></table><h2>Hesap silme talepleri</h2><table class="admin-table"><tbody>{deletionRequests.map((entry) => <tr><td>{entry.user_id}</td><td>{entry.created_at}</td><td><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="deletion_request"/><input type="hidden" name="id" value={entry.id}/><select name="status" aria-label="Talep durumu">{['pending','processing','completed','rejected'].map((status) => <option value={status} selected={entry.status === status}>{status}</option>)}</select><button type="submit">Kaydet</button></form></td></tr>)}</tbody></table><p class="muted">Tamamlandı durumu hesabı otomatik silmez; doğrulanmış talep için kimlik sağlayıcıda ayrıca işlem gerekir.</p></> : <p>Yalnız admin erişebilir.</p>}</>}
{section === 'settings' && <>{profile.role === 'admin' ? <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="social"/><h2>Sosyal bağlantılar</h2>{(['github','youtube','instagram','x'] as const).map((name) => <label class="field">{name}<input name={name} type="url" value={social?.[name] ?? ''} placeholder="https://"/></label>)}<button class="button">Kaydet</button></form> : <p>Yalnız admin düzenleyebilir.</p>}</>}
</>}
</main></div><script src="../../scripts/editor.ts"></script><script src="../../scripts/type-fields.ts"></script></body></html>
