---
import { supabase } from '../../lib/supabase';
import '../../styles/global.css';
import StudioMemberManagement from '../../components/StudioMemberManagement.astro';
import ClassicEditorToolbar from '../../components/ClassicEditorToolbar.astro';
const db = supabase(Astro.cookies, Astro.request);
const user = db ? (await db.auth.getUser()).data.user : null;
let profile = user && db ? (await db.from('profiles').select('role,permission_group_id').eq('id', user.id).single()).data : null;
if(!profile&&user&&db) profile=(await db.from('profiles').select('role').eq('id',user.id).single()).data;
const editorPanel = profile?.role === 'editor' && Astro.url.searchParams.get('panel') === 'editor';
const staff = profile?.role === 'admin' || editorPanel;
const permissionGroup = profile?.permission_group_id && db ? (await db.from('permission_groups').select('permissions').eq('id',profile.permission_group_id).single()).data : null;
const can = (permission:string) => profile?.role === 'admin' || Boolean(permissionGroup?.permissions?.[permission]);
const sectionPermission:Record<string,string>={content:'content',categories:'taxonomy',tags:'taxonomy',media:'media',messages:'messages',comments:'messages',appearance:'appearance',homepage:'appearance',settings:'appearance',advertising:'appearance',traffic:'audit',navigation:'navigation',redirects:'navigation',members:'members',access:'permissions',audit:'audit'};
const canSection=(name:string)=>profile?.role==='admin'||(editorPanel&&(name==='dashboard'||Boolean(permissionGroup?.permissions?.[sectionPermission[name]])));
const sections = ['dashboard','content','categories','tags','media','messages','comments','members','access','appearance','homepage','advertising','traffic','navigation','redirects','audit','settings'].filter(canSection);
const menuGroups = [['Yayın','dashboard','content','categories','tags','media'],['Topluluk','messages','comments','members','access'],['Site','appearance','homepage','advertising','traffic','navigation','redirects'],['Sistem','audit','settings']].map(([label,...items]) => ({ label, items: items.filter((item) => sections.includes(item)) })).filter((group) => group.items.length);
const requestedSection = Astro.url.searchParams.get('section') ?? 'dashboard';
const section = sections.includes(requestedSection) ? requestedSection : 'dashboard';
const needs = (...names: string[]) => staff && db && names.includes(section);
const typeLabels: Record<string,string> = { article:'Yazı', project:'Proje', fm_mod:'FM Mod', gallery:'Galeri', lab_entry:'Lab' };
const statusLabels: Record<string,string> = { draft:'Taslak', scheduled:'Zamanlandı', published:'Yayında', archived:'Arşivlendi' };
const sectionLabels: Record<string, string> = { dashboard:'Genel bakış', content:'İçerikler', categories:'Kategoriler', tags:'Etiketler', media:'Medya', messages:'Mesajlar', comments:'Yorumlar', members:'Üyeler', access:'Yetki grupları', appearance:'Görünüm', homepage:'Ana sayfa', advertising:'Reklam alanları', traffic:'Trafik', navigation:'Menü', redirects:'Yönlendirmeler', audit:'İşlem geçmişi', settings:'Ayarlar' };
const content: Record<string, any>[] = needs('dashboard','content') ? (await db.from('content_items').select('id,title,locale,type,status,slug,published_at,updated_at,featured,translation_group').order('updated_at',{ascending:false}).limit(100)).data ?? [] : [];
const listSearch = (Astro.url.searchParams.get('q') ?? '').trim().toLocaleLowerCase('tr-TR').slice(0,100);
const listStatus = Astro.url.searchParams.get('status') ?? '';
const listType = Astro.url.searchParams.get('type') ?? '';
const listLocale = Astro.url.searchParams.get('locale') ?? '';
const filteredContent = content.filter((entry) => (!listSearch || String(entry.title).toLocaleLowerCase('tr-TR').includes(listSearch) || String(entry.slug).includes(listSearch)) && (!listStatus || entry.status === listStatus) && (!listType || entry.type === listType) && (!listLocale || entry.locale === listLocale));
const categories: Record<string, any>[] = needs('content','categories') ? (await db.from('categories').select('id,slug,name_tr,name_en,description_tr,description_en,seo,parent_id,active,sort_order').order('sort_order')).data ?? [] : [];
const tags: Record<string, any>[] = needs('content','tags') ? (await db.from('tags').select('id,slug,name_tr,name_en').order('slug')).data ?? [] : [];
const messages: Record<string, any>[] = needs('dashboard','messages') ? (await db.from('contact_messages').select('id,name,email,message,status,created_at').order('created_at',{ascending:false}).limit(50)).data ?? [] : [];
const comments: Record<string, any>[] = needs('comments') ? (await db.from('comments').select('id,content_id,user_id,body,status,created_at').order('created_at',{ascending:false}).limit(100)).data ?? [] : [];
const commentProfiles: Record<string, any>[] = comments.length && db ? (await db.from('profiles').select('id,display_name').in('id',[...new Set(comments.map((entry)=>entry.user_id))])).data ?? [] : [];
const commentContent: Record<string, any>[] = comments.length && db ? (await db.from('content_items').select('id,title,slug').in('id',[...new Set(comments.map((entry)=>entry.content_id))])).data ?? [] : [];
const media: Record<string, any>[] = needs('dashboard','content','media') ? (await db.from('media').select('id,path,mime,bytes,width,height,alt_tr,alt_en,caption_tr,caption_en,created_at').order('created_at',{ascending:false}).limit(100)).data ?? [] : [];
const navigation: Record<string, any>[] = needs('navigation') ? (await db.from('navigation').select('id,locale,label,href,sort_order,active').order('sort_order')).data ?? [] : [];
const appearance = needs('appearance') ? (await db.from('site_settings').select('value').eq('key','appearance').single()).data?.value : null;
const homepage = needs('homepage') ? (await db.from('site_settings').select('value').eq('key','homepage').single()).data?.value : null;
const social = needs('settings') ? (await db.from('site_settings').select('value').eq('key','social').single()).data?.value : null;
const advertising = needs('advertising') ? (await db.from('site_settings').select('value').eq('key','advertising').single()).data?.value : null;
const trafficDaily: Record<string, any>[] = can('audit') && needs('traffic') ? (await db.from('traffic_daily').select('day,path,pageviews,visitors').gte('day',new Date(Date.now()-29*86400000).toISOString().slice(0,10)).order('day',{ascending:false}).limit(500)).data ?? [] : [];
const trafficTotals = trafficDaily.reduce((total,entry)=>({ pageviews:total.pageviews+Number(entry.pageviews||0),visitors:total.visitors+Number(entry.visitors||0)}),{pageviews:0,visitors:0});
const qualifiedTraffic: Record<string, any>[] = can('audit') && needs('traffic') ? (await db.from('traffic_qualified_daily').select('day,path,source,pageviews,visitors').gte('day',new Date(Date.now()-29*86400000).toISOString().slice(0,10)).order('day',{ascending:false}).limit(500)).data ?? [] : [];
const qualifiedTotals = qualifiedTraffic.reduce((total,entry)=>({ pageviews:total.pageviews+Number(entry.pageviews||0),visitors:total.visitors+Number(entry.visitors||0)}),{pageviews:0,visitors:0});
const organicTotals = qualifiedTraffic.filter((entry)=>entry.source==='organic_search').reduce((total,entry)=>({ pageviews:total.pageviews+Number(entry.pageviews||0),visitors:total.visitors+Number(entry.visitors||0)}),{pageviews:0,visitors:0});
const redirects: Record<string, any>[] = needs('redirects') ? (await db.from('redirects').select('id,source_path,target_path,status_code').order('source_path')).data ?? [] : [];
const audit: Record<string, any>[] = can('audit') && needs('audit') ? (await db.from('audit_logs').select('actor_id,action,entity,entity_id,created_at').order('created_at',{ascending:false}).limit(50)).data ?? [] : [];
const auditActorIds = [...new Set(audit.map((entry) => entry.actor_id).filter(Boolean))];
const auditActors: Record<string, any>[] = auditActorIds.length && db ? (await db.from('profiles').select('id,display_name').in('id',auditActorIds)).data ?? [] : [];
const auditActionLabels: Record<string,string> = { INSERT:'Eklendi', UPDATE:'Güncellendi', DELETE:'Silindi', ROLE_CHANGE:'Rol değişti' };
const roleLabels: Record<string,string> = { member:'Üye', editor:'Editör', admin:'Yönetici' };
const members: Record<string, any>[] = profile?.role === 'admin' && needs('users') ? (await db.from('profiles').select('id,display_name,role,created_at').order('created_at',{ascending:false}).limit(100)).data ?? [] : [];
const deletionRequests: Record<string, any>[] = profile?.role === 'admin' && needs('users') ? (await db.from('account_deletion_requests').select('id,user_id,status,created_at').order('created_at',{ascending:false}).limit(100)).data ?? [] : [];
const selectedId = Astro.url.searchParams.get('edit');
const selected = selectedId && needs('content') ? (await db.from('content_items').select('*').eq('id',selectedId).single()).data : null;
const selectedContentCategory = selected && db ? (await db.from('content_categories').select('category_id').eq('content_id',selected.id).limit(1)).data?.[0]?.category_id : null;
const selectedContentTags: string[] = selected && db ? ((await db.from('content_tags').select('tag_id').eq('content_id',selected.id)).data ?? []).map((row: {tag_id:string}) => row.tag_id) : [];
const selectedCategory = section === 'categories' && selectedId ? categories.find((entry) => entry.id === selectedId) : null;
const selectedTag = section === 'tags' && selectedId ? tags.find((entry) => entry.id === selectedId) : null;
const selectedNav = section === 'navigation' && selectedId ? navigation.find((entry) => entry.id === selectedId) : null;
const selectedRedirect = section === 'redirects' && selectedId ? redirects.find((entry) => entry.id === selectedId) : null;
---
<!doctype html><html lang="tr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Studio — Palmarghe</title><meta name="theme-color" content="#0B0B0D"/><link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/fonts/manrope-latin-ext.woff2" as="font" type="font/woff2" crossorigin/></head><body>
<div class="admin-shell"><aside class="admin-side"><a class="brand" href="/studio/"><svg viewBox="0 0 48 56" width="25" height="30" aria-hidden="true"><path d="M5 3 43 15v26H24V29h7v-5L17 20v34L5 50Z" fill="currentColor"/></svg><span>STUDIO</span></a><button type="button" class="theme-toggle studio-theme-toggle" data-theme-toggle aria-label="Açık modu aç" aria-pressed="false">◐</button>{staff && <nav aria-label="Studio">{menuGroups.map((group) => <section class="studio-nav-group"><span>{group.label}</span>{group.items.map((name) => <a href={`/studio/?section=${name}`} aria-current={section === name ? 'page' : undefined}>{sectionLabels[name]}</a>)}</section>)}</nav>}</aside><main class="admin-main">
{!db ? <p class="alert">Supabase bağlantısı yapılandırılmadı.</p> : !user ? <section class="studio-auth"><span class="eyebrow">PALMARGHE / STUDIO</span><h1>Studio</h1><p>Yayın alanına giriş. Yalnızca yetkili hesaplar.</p><form method="post" action="/api/auth/"><input type="hidden" name="action" value="login"/><input type="hidden" name="next" value="studio"/><label class="field">Email<input name="email" type="email" autocomplete="email" required/></label><label class="field">Şifre<input name="password" type="password" autocomplete="current-password" required/></label><button class="button">Giriş yap</button></form></section> : !staff ? <><h1>Erişim yok</h1><p>Bu hesap Studio yetkisine sahip değil.</p></> : <>
<div class="section-heading admin-heading"><div><span class="eyebrow">PALMARGHE / STUDIO</span><h1>{sectionLabels[section] ?? section}</h1></div><span class="admin-role">{profile.role}</span></div>
{section === 'dashboard' && <><p class="admin-intro">Yayınını tek yerden yönet. Taslakları tamamla, gelen mesajları incele ve sitenin görünümünü düzenle.</p><div class="admin-stats">{can('content') && <a href="/studio/?section=content"><span>İçerikler</span><strong>{content.length}</strong><small>{content.filter((entry) => entry.status === 'draft').length} taslak · {content.filter((entry) => entry.status === 'published').length} yayında</small></a>}{can('messages') && <a href="/studio/?section=messages"><span>Mesajlar</span><strong>{messages.filter((entry) => entry.status === 'unread').length}</strong><small>Okunmamış · toplam {messages.length}</small></a>}{can('media') && <a href="/studio/?section=media"><span>Medya</span><strong>{media.length}</strong><small>Yüklenen dosya</small></a>}</div><section class="admin-quick"><div><span class="eyebrow">SONRAKİ ADIM</span><h2>Çalışmanı yayına hazırla.</h2><p>Yeni bir içerik oluşturabilir veya mevcut taslağı düzenleyebilirsin.</p></div><a class="button" href="/studio/?section=content">İçerik oluştur →</a></section>{content.length > 0 && <section class="admin-recent"><h2>Son içerikler</h2><ul>{content.slice(0,5).map((entry) => <li><a href={`/studio/?section=content&edit=${entry.id}`}>{entry.title}</a><span>{statusLabels[entry.status] ?? entry.status}</span></li>)}</ul></section>}</>}
{section === 'content' && <><h2>{selected ? 'İçerik düzenle' : 'Yeni içerik'}</h2><form class="content-editor-form" method="post" action="/api/studio/"><input type="hidden" name="entity" value="content"/><input type="hidden" name="id" value={selected?.id ?? ''}/><div class="editor-action-bar"><a class="text-link" href="/studio/?section=content">İçeriklere dön</a><div class="editor-mode-switch" role="group" aria-label="İçerik düzenleme modu"><button type="button" data-editor-mode="simple" aria-pressed="true">Basit</button><button type="button" data-editor-mode="detailed" aria-pressed="false">Detaylı</button></div><span class="editor-action-status" data-editor-save-state aria-live="polite">Kaydedildi</span>{selected && <a class="text-link" href={`/studio/preview/${selected.id}/`}>Önizle</a>}<button class="button button-quiet" type="button" data-publish-action="draft">Taslak kaydet</button><button class="button" type="button" data-publish-action="published">Yayınla</button><button class="button button-quiet" type="button" data-publish-action="scheduled">Zamanla</button><details class="editor-more-actions"><summary>Diğer</summary><button type="button" data-editor="focus">Odak modunu aç</button><a href="/studio/?section=content">Değişiklikleri bırak</a></details></div><label class="field editor-title-field">Başlık<input name="title" required maxlength="200" value={selected?.title ?? ''} autocomplete="off"/></label><details class="editor-url-details"><summary>URL / gelişmiş</summary><label class="field">URL yolu<input name="slug" required pattern="[a-z0-9/-]+" value={selected?.slug ?? ''} aria-describedby="slug-help"/></label><p id="slug-help" class="field-help">Başlıktan otomatik oluşturulur. Manuel düzenlediğinde korunur.</p></details><input name="translation_group" type="hidden" value={selected?.translation_group ?? ''}/><label class="field">Dil<select name="locale"><option value="tr" selected={selected?.locale !== 'en'}>Türkçe</option><option value="en" selected={selected?.locale === 'en'}>English</option></select></label><label class="field">Kategori<select name="category_id"><option value="">Yok</option>{categories.map((entry) => <option value={entry.id} selected={selectedContentCategory === entry.id}>{entry.name_tr}</option>)}</select></label><label class="field">Etiketler (çoklu seçim)<select name="tag_ids" multiple size="5">{tags.map((entry) => <option value={entry.id} selected={selectedContentTags.includes(entry.id)}>{entry.name_tr}</option>)}</select></label><label class="field">Kapak görseli<select name="cover_media_id"><option value="">Yok</option>{media.map((entry) => <option value={entry.id} selected={selected?.cover_media_id === entry.id}>{entry.alt_tr ?? entry.path}</option>)}</select></label><label class="field">Tür<select name="type">{['article','project','fm_mod','gallery','lab_entry'].map((type) => <option value={type} selected={selected?.type === type}>{typeLabels[type]}</option>)}</select></label><label class="field">Durum<select name="status">{['draft','scheduled','published','archived'].map((status) => <option value={status} selected={selected?.status === status}>{statusLabels[status]}</option>)}</select></label><label><input type="checkbox" name="featured" checked={selected?.featured ?? false}/> Ana sayfada öne çıkar</label><input type="hidden" name="indexable" value="off"/><label><input type="checkbox" name="indexable" checked={selected?.indexable ?? true}/> Arama motoruna açık</label><label class="field">Zamanlı yayın (UTC)<input name="publish_at" type="datetime-local" value={selected?.status === 'scheduled' && selected?.published_at ? selected.published_at.slice(0,16) : ''}/></label><label class="field editor-deck-field">Kısa açıklama<textarea name="excerpt">{selected?.excerpt ?? ''}</textarea></label><div class="field classic-editor-shell"><ClassicEditorToolbar /><div id="block-editor" data-media={JSON.stringify(media.map((entry) => ({ id: entry.id, alt_tr: entry.alt_tr, alt_en: entry.alt_en, path: entry.path })))} data-content={JSON.stringify(selected?.body && typeof selected.body === 'object' ? selected.body : { type: 'doc', content: [{ type: 'paragraph', content: selected?.body ? [{ type: 'text', text: String(selected.body) }] : [] }] })}></div><textarea id="body-json" name="body" hidden required></textarea></div><label class="field">SEO başlığı<input name="seo_title" value={selected?.seo_title ?? ''}/></label><label class="field">SEO açıklaması<input name="seo_description" value={selected?.seo_description ?? ''}/></label><details class="advanced-content"><summary>Gelişmiş paylaşım ve canonical ayarları</summary><label class="field">Canonical URL<input name="canonical_override" type="url" value={selected?.canonical_override ?? ''} placeholder="https://example.com/orijinal-yazi"/></label><label class="field">Sosyal paylaşım görseli<select name="og_media_id"><option value="">Kapak görselini kullan</option>{media.map((entry) => <option value={entry.id} selected={selected?.og_media_id === entry.id}>{entry.alt_tr ?? entry.path}</option>)}</select></label></details><div data-type-section="fm_mod" hidden={selected?.type !== 'fm_mod'}><h3>FM Mod</h3><label class="field">Uyumluluk<input name="compatibility" value={selected?.type_data?.compatibility ?? ''}/></label><label class="field">Mod sürümü<input name="mod_version" value={selected?.type_data?.mod_version ?? ''}/></label><label class="field">Değişiklikler<textarea name="changelog">{selected?.type_data?.changelog ?? ''}</textarea></label><label class="field">Kurulum<textarea name="installation">{selected?.type_data?.installation ?? ''}</textarea></label><label class="field">İndirme URL<input name="download_url" type="url" value={selected?.type_data?.download_url ?? ''}/></label><label class="field">Kaynak URL<input name="source_url" type="url" value={selected?.type_data?.source_url ?? ''}/></label><label class="field">Dosya boyutu bilgisi<input name="size_label" value={selected?.type_data?.size_label ?? ''}/></label><label class="field">Uyumluluk notu<textarea name="compatibility_notes">{selected?.type_data?.compatibility_notes ?? ''}</textarea></label></div><div data-type-section="gallery" hidden={selected?.type !== 'gallery'}><h3>Galeri görselleri</h3><p>Sıra numarası görsellerin yayın düzenini belirler.</p><div class="gallery-picker">{media.map((entry) => <div class="gallery-picker-row"><label><input type="checkbox" name="gallery_media_ids" value={entry.id} checked={Array.isArray(selected?.type_data?.gallery_media_ids) && selected.type_data.gallery_media_ids.includes(entry.id)}/><img src={`/api/media/${entry.id}/`} alt="" width="96" height="72" loading="lazy"/><span>{entry.alt_tr ?? entry.path}</span></label><label>Sıra<input type="number" min="1" max="24" name={`gallery_order_${entry.id}`} value={Array.isArray(selected?.type_data?.gallery_media_ids) ? Math.max(1, selected.type_data.gallery_media_ids.indexOf(entry.id)+1) : 1}/></label></div>)}</div></div><div data-type-section="project" hidden={selected?.type !== 'project'}><h3>Proje</h3><label class="field">Proje URL<input name="project_url" type="url" value={selected?.type_data?.project_url ?? ''}/></label></div><div data-type-section="lab_entry" hidden={selected?.type !== 'lab_entry'}><h3>Lab</h3><label class="field">Deney notu<textarea name="experiment_note">{selected?.type_data?.experiment_note ?? ''}</textarea></label><label class="field">Video/Prototip URL<input name="experiment_url" type="url" value={selected?.type_data?.experiment_url ?? ''}/></label></div><button class="button">Kaydet</button></form>{selected && <section class="translation-panel"><h3>Çeviri eşleştir</h3><p>{selected.translation_group ? 'Bu içerik bir çeviriyle eşleşmiş.' : 'Karşı dildeki mevcut bir içerikle eşleştir.'}</p><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="translation"/><input type="hidden" name="operation" value="pair"/><input type="hidden" name="id" value={selected.id}/><label class="field">Karşı dil içeriği<select name="target_id" required><option value="">Seç</option>{content.filter((entry) => entry.id !== selected.id && entry.locale !== selected.locale).map((entry) => <option value={entry.id} selected={selected.translation_group && entry.translation_group === selected.translation_group}>{entry.title} · {entry.locale.toUpperCase()}</option>)}</select></label><button class="button" type="submit">Eşleştir</button></form>{selected.translation_group && <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="translation"/><input type="hidden" name="operation" value="unlink"/><input type="hidden" name="id" value={selected.id}/><button class="button" type="submit">Eşleşmeyi kaldır</button></form>}</section>}<section class="section content-list"><div class="section-heading"><h2>İçerikler</h2><span>{filteredContent.length} sonuç</span></div><form class="studio-filters" method="get" action="/studio/"><input type="hidden" name="section" value="content"/><label>İçerik ara<input type="search" name="q" value={Astro.url.searchParams.get('q') ?? ''} placeholder="Başlık veya URL"/></label><label>Durum<select name="status"><option value="">Tümü</option>{Object.entries(statusLabels).map(([value,label]) => <option value={value} selected={listStatus === value}>{label}</option>)}</select></label><label>Tür<select name="type"><option value="">Tümü</option>{Object.entries(typeLabels).map(([value,label]) => <option value={value} selected={listType === value}>{label}</option>)}</select></label><label>Dil<select name="locale"><option value="">Tümü</option><option value="tr" selected={listLocale === 'tr'}>TR</option><option value="en" selected={listLocale === 'en'}>EN</option></select></label><button class="button" type="submit">Filtrele</button></form>{filteredContent.length ? <table class="admin-table"><thead><tr><th>Başlık</th><th>Tür</th><th>Dil</th><th>Durum</th><th>Güncellendi</th><th></th></tr></thead><tbody>{filteredContent.map((entry) => <tr><td><strong>{entry.title}</strong>{entry.featured && <small> · Öne çıkan</small>}</td><td>{typeLabels[entry.type] ?? entry.type}</td><td>{entry.locale.toUpperCase()}</td><td>{statusLabels[entry.status] ?? entry.status}</td><td>{entry.updated_at ? new Date(entry.updated_at).toLocaleDateString('tr-TR') : ''}</td><td><a class="text-link" href={"/studio/?section=content&edit=" + entry.id}>Düzenle</a> <a class="text-link" href={"/studio/preview/" + entry.id + "/"}>Önizle</a> <details><summary>Sil</summary><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="content"/><input type="hidden" name="operation" value="delete"/><input type="hidden" name="id" value={entry.id}/><button type="submit">Silmeyi onayla</button></form></details></td></tr>)}</tbody></table> : <div class="empty"><p>Bu filtrelerde içerik bulunamadı.</p><a class="text-link" href="/studio/?section=content">Filtreleri temizle →</a></div>}</section></>}
{section === 'categories' && <><h2>{selectedCategory ? 'Kategori düzenle' : 'Kategori ekle'}</h2><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="category"/><input type="hidden" name="operation" value={selectedCategory ? 'update' : 'create'}/><input type="hidden" name="id" value={selectedCategory?.id ?? ''}/><label class="field">Slug<input name="slug" required pattern="[a-z0-9-]+" value={selectedCategory?.slug ?? ''}/></label><label class="field">Türkçe ad<input name="name_tr" required value={selectedCategory?.name_tr ?? ''}/></label><label class="field">English name<input name="name_en" required value={selectedCategory?.name_en ?? ''}/></label><label class="field">Türkçe açıklama<textarea name="description_tr" maxlength="500">{selectedCategory?.description_tr ?? ''}</textarea></label><label class="field">English description<textarea name="description_en" maxlength="500">{selectedCategory?.description_en ?? ''}</textarea></label><details class="studio-advanced"><summary>Arama görünümü</summary><label class="field">TR meta başlığı<input name="seo_title_tr" maxlength="120" value={selectedCategory?.seo?.title_tr ?? ''}/></label><label class="field">EN meta title<input name="seo_title_en" maxlength="120" value={selectedCategory?.seo?.title_en ?? ''}/></label><label class="field">TR meta açıklaması<input name="seo_description_tr" maxlength="300" value={selectedCategory?.seo?.description_tr ?? ''}/></label><label class="field">EN meta description<input name="seo_description_en" maxlength="300" value={selectedCategory?.seo?.description_en ?? ''}/></label></details><label class="field">Üst kategori<select name="parent_id"><option value="">Yok</option>{categories.filter((entry) => entry.id !== selectedCategory?.id).map((entry) => <option value={entry.id} selected={entry.id === selectedCategory?.parent_id}>{entry.name_tr}</option>)}</select></label><label class="field">Sıra<input name="sort_order" type="number" min="0" max="1000" value={selectedCategory?.sort_order ?? 0}/></label><label><input type="checkbox" name="active" checked={selectedCategory?.active ?? true}/> Aktif</label><button class="button">Kaydet</button></form><table class="admin-table"><tbody>{categories.map((entry) => <tr><td>{entry.name_tr}</td><td>{entry.slug}</td><td>{entry.active ? 'Aktif' : 'Pasif'}</td><td><a class="text-link" href={`/studio/?section=categories&edit=${entry.id}`}>Düzenle</a></td><td><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="category"/><input type="hidden" name="operation" value="delete"/><input type="hidden" name="id" value={entry.id}/><button type="submit">Sil</button></form></td></tr>)}</tbody></table></>}
{section === 'tags' && <><h2>{selectedTag ? 'Etiket düzenle' : 'Etiket ekle'}</h2><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="tag"/><input type="hidden" name="operation" value={selectedTag ? 'update' : 'create'}/><input type="hidden" name="id" value={selectedTag?.id ?? ''}/><label class="field">Slug<input name="slug" required pattern="[a-z0-9-]+" value={selectedTag?.slug ?? ''}/></label><label class="field">Türkçe ad<input name="name_tr" required value={selectedTag?.name_tr ?? ''}/></label><label class="field">English name<input name="name_en" required value={selectedTag?.name_en ?? ''}/></label><button class="button">Kaydet</button></form><table class="admin-table"><tbody>{tags.map((entry) => <tr><td>{entry.name_tr}</td><td>{entry.slug}</td><td><a class="text-link" href={`/studio/?section=tags&edit=${entry.id}`}>Düzenle</a></td><td><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="tag"/><input type="hidden" name="operation" value="delete"/><input type="hidden" name="id" value={entry.id}/><button type="submit">Sil</button></form></td></tr>)}</tbody></table></>}
{section === 'media' && <><h2>Medya yükle</h2><form method="post" action="/api/media/" enctype="multipart/form-data"><label class="field">Görsel (PNG, JPEG, WebP; en fazla 10 MB)<input type="file" name="file" accept="image/png,image/jpeg,image/webp" required/></label><label class="field">Alternatif metin · Türkçe<input name="alt_tr" maxlength="200" required/></label><label class="field">Alternative text · English<input name="alt_en" maxlength="200"/></label><label class="field">Açıklama · Türkçe<input name="caption_tr" maxlength="500"/></label><label class="field">Caption · English<input name="caption_en" maxlength="500"/></label><button class="button" type="submit">Yükle</button></form><div class="card-grid section">{media.map((entry) => <div class="entry-card"><img src={`/api/media/${entry.id}/`} alt={entry.alt_tr ?? ''} width="400" height="250" loading="lazy"/><form method="post" action="/api/media/manage/"><input type="hidden" name="id" value={entry.id}/><input type="hidden" name="operation" value="update"/><label class="field">Alternatif metin · Türkçe<input name="alt_tr" required maxlength="200" value={entry.alt_tr ?? ''}/></label><label class="field">Alternative text · English<input name="alt_en" maxlength="200" value={entry.alt_en ?? ''}/></label><label class="field">Açıklama · Türkçe<input name="caption_tr" maxlength="500" value={entry.caption_tr ?? ''}/></label><label class="field">Caption · English<input name="caption_en" maxlength="500" value={entry.caption_en ?? ''}/></label><button class="button" type="submit">Kaydet</button></form><small>{entry.path} · {entry.mime} · {Math.round(entry.bytes/1024)} KB{entry.width && entry.height ? ` · ${entry.width}×${entry.height}` : ''} · {new Date(entry.created_at).toLocaleDateString('tr-TR')}</small><details><summary>Sil</summary><form method="post" action="/api/media/manage/"><input type="hidden" name="id" value={entry.id}/><input type="hidden" name="operation" value="delete"/><button type="submit">Silmeyi onayla</button></form></details></div>)}</div></>}
{section === 'messages' && <table class="admin-table"><thead><tr><th>Gönderen</th><th>Tarih</th><th>Mesaj</th><th>Durum</th></tr></thead><tbody>{messages.map((entry) => <tr><td>{entry.name}<br/><small>{entry.email}</small></td><td>{new Date(entry.created_at).toLocaleString('tr-TR')}</td><td><p class="message-preview">{entry.message.slice(0,120)}{entry.message.length > 120 ? '…' : ''}</p><details><summary>Mesajı aç</summary><div class="message-full">{entry.message}</div></details></td><td><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="message"/><input type="hidden" name="id" value={entry.id}/><select name="status" aria-label="Mesaj durumu">{['unread','read','archived','spam'].map((status) => <option value={status} selected={entry.status === status}>{status}</option>)}</select><button type="submit">Kaydet</button></form></td></tr>)}</tbody></table>}
{section === 'comments' && <section class="studio-panel"><div class="section-heading"><div><span class="eyebrow">TOPLULUK</span><h2>{comments.length} yorum</h2></div></div>{comments.length===0?<p class="muted">Henüz yorum yok.</p>:<div class="comment-moderation-list">{comments.map((entry)=>{const author=commentProfiles.find((item)=>item.id===entry.user_id);const item=commentContent.find((contentItem)=>contentItem.id===entry.content_id);return <article><div><strong>{author?.display_name??'Üye'}</strong><small>{new Date(entry.created_at).toLocaleString('tr-TR')} · {item?.title??'İçerik'}</small><p>{entry.body}</p>{item&&<a href={`/${item.slug}/`} target="_blank">İçeriği aç ↗</a>}</div><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="comment"/><input type="hidden" name="id" value={entry.id}/><select name="status" aria-label="Yorum durumu"><option value="published" selected={entry.status==='published'}>Yayında</option><option value="hidden" selected={entry.status==='hidden'}>Gizli</option></select><button type="submit">Kaydet</button><button type="submit" name="operation" value="delete" class="danger-button">Sil</button></form></article>})}</div>}</section>}{section === 'appearance' && <>{profile.role === 'admin' ? <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="appearance"/><label class="field">Vurgu rengi<select name="accent"><option value="violet" selected={!appearance || appearance.accent === 'violet'}>Violet</option><option value="blue" selected={appearance?.accent === 'blue'}>Blue</option><option value="amber" selected={appearance?.accent === 'amber'}>Amber</option></select></label><label class="field">Köşe<select name="radius"><option value="sharp" selected={!appearance || appearance.radius === 'sharp'}>Sharp</option><option value="subtle" selected={appearance?.radius === 'subtle'}>Subtle</option></select></label><button class="button">Kaydet</button></form> : <p>Yalnız admin düzenleyebilir.</p>}</>}
{section === 'homepage' && <>{profile.role === 'admin' ? <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="homepage"/>{(['now','featured','categories','latest','fm_spotlight','lab_notes','visual_reel','archive_cta'] as const).map((name,index) => <div class="field"><label><input type="checkbox" name={`${name}_visible`} checked={homepage?.visible?.[name] !== false}/> {name.replace('_',' ')}</label><label>Sıra<select name={`${name}_order`}>{[1,2,3,4,5,6,7,8].map((number) => <option value={number} selected={(homepage?.order?.[name] ?? index+1) === number}>{number}</option>)}</select></label></div>)}<button class="button">Kaydet</button></form> : <p>Yalnız admin düzenleyebilir.</p>}</>}
{section === 'advertising' && <>{profile.role === 'admin' ? <section class="studio-panel"><span class="eyebrow">GOOGLE ADSENSE</span><h2>Reklam alanları</h2><p>Yalnız geçerli yayıncı ve slot kimlikleri kaydedildiğinde sayfada Google reklam etiketi yüklenir. Kimlikler boşken alanlar görünmez.</p><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="advertising"/><label class="field"><input type="checkbox" name="enabled" checked={advertising?.enabled === true}/> Reklam yerleşimlerini etkinleştir</label><label class="field">AdSense yayıncı kimliği<input name="publisher_id" pattern="ca-pub-[0-9]{10,20}" value={advertising?.publisher_id ?? ''} placeholder="ca-pub-1234567890123456"/></label><label class="field">Üst alan slotu<input name="header_slot" inputmode="numeric" pattern="[0-9]{6,20}" value={advertising?.slots?.header ?? ''} placeholder="1234567890"/></label><label class="field">Yazı içi slotu<input name="article_slot" inputmode="numeric" pattern="[0-9]{6,20}" value={advertising?.slots?.article ?? ''} placeholder="1234567890"/></label><label class="field">Alt alan slotu<input name="footer_slot" inputmode="numeric" pattern="[0-9]{6,20}" value={advertising?.slots?.footer ?? ''} placeholder="1234567890"/></label><button class="button">Reklam ayarlarını kaydet</button></form></section> : <p>Yalnız admin düzenleyebilir.</p>}</>}
{section === 'traffic' && <>{profile.role === 'admin' ? <><p class="admin-intro">Filtreli rapor, bilinen botları ve Studio/otomasyon doğrulamalarını dışarıda bırakır. IP, ham yönlendiren adresi, kullanıcı hesabı ve tarayıcı bilgisi saklanmaz.</p><div class="admin-stats"><article><span>Filtreli görüntüleme</span><strong>{qualifiedTotals.pageviews}</strong><small>Yeni ölçümden itibaren · son 30 gün</small></article><article><span>Filtreli tekil ziyaret</span><strong>{qualifiedTotals.visitors}</strong><small>Gün ve sayfa bazında anonim</small></article><article><span>Organik arama</span><strong>{organicTotals.pageviews}</strong><small>Google, Bing ve diğer arama motorları</small></article></div><section class="studio-panel"><h2>Filtreli trafik</h2>{qualifiedTraffic.length ? <table class="admin-table"><thead><tr><th>Tarih</th><th>Yol</th><th>Kaynak</th><th>Görüntüleme</th><th>Ziyaretçi</th></tr></thead><tbody>{qualifiedTraffic.map((entry)=><tr><td>{entry.day}</td><td>{entry.path}</td><td>{entry.source === 'organic_search' ? 'Organik arama' : entry.source === 'referral' ? 'Yönlendiren site' : 'Doğrudan'}</td><td>{entry.pageviews}</td><td>{entry.visitors}</td></tr>)}</tbody></table> : <p class="muted">Filtreli sayaç bu sürümle başladı; ilk gerçek ziyaretlerden sonra burada görünür.</p>}</section><details class="studio-panel"><summary>Önceki ham toplamlar</summary><p class="muted">Bu değerler geçmiş test ve otomasyon ziyaretlerini içerebilir; organik trafik olarak kullanılmamalıdır.</p><div class="admin-stats"><article><span>Ham görüntüleme</span><strong>{trafficTotals.pageviews}</strong></article><article><span>Ham tekil ziyaret</span><strong>{trafficTotals.visitors}</strong></article><article><span>İzlenen yol</span><strong>{new Set(trafficDaily.map((entry)=>entry.path)).size}</strong></article></div></details></> : <p>Yalnız admin erişebilir.</p>}</>}
{section === 'navigation' && <>{profile.role === 'admin' && <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="navigation"/><input type="hidden" name="operation" value={selectedNav ? 'update' : 'create'}/><input type="hidden" name="id" value={selectedNav?.id ?? ''}/><label class="field">Dil<select name="locale"><option value="tr" selected={selectedNav?.locale !== 'en'}>TR</option><option value="en" selected={selectedNav?.locale === 'en'}>EN</option></select></label><label class="field">Başlık<input name="label" required maxlength="50" value={selectedNav?.label ?? ''}/></label><label class="field">Bağlantı<input name="href" required value={selectedNav?.href ?? ''}/></label><label class="field">Sıra<input name="sort_order" type="number" min="0" max="1000" value={selectedNav?.sort_order ?? 0}/></label><label><input name="active" type="checkbox" checked={selectedNav?.active ?? true}/> Aktif</label><p><button class="button">Kaydet</button></p></form>}<table class="admin-table"><tbody>{navigation.map((entry) => <tr><td>{entry.locale}</td><td>{entry.label}</td><td>{entry.href}</td><td><a href={`/studio/?section=navigation&edit=${entry.id}`}>Düzenle</a></td><td>{profile.role === 'admin' && <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="navigation"/><input type="hidden" name="operation" value="delete"/><input type="hidden" name="id" value={entry.id}/><button type="submit">Sil</button></form>}</td></tr>)}</tbody></table></>}
{section === 'redirects' && <>{profile.role === 'admin' && <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="redirect"/><input type="hidden" name="operation" value={selectedRedirect ? 'update' : 'create'}/><input type="hidden" name="id" value={selectedRedirect?.id ?? ''}/><label class="field">Eski yol<input name="source_path" required value={selectedRedirect?.source_path ?? ''} placeholder="/old/"/></label><label class="field">Yeni yol<input name="target_path" required value={selectedRedirect?.target_path ?? ''} placeholder="/new/"/></label><button class="button">Kaydet</button></form>}<table class="admin-table"><tbody>{redirects.map((entry) => <tr><td>{entry.source_path}</td><td>→</td><td>{entry.target_path}</td><td>{profile.role === 'admin' && <a href={`/studio/?section=redirects&edit=${entry.id}`}>Düzenle</a>}</td></tr>)}</tbody></table></>}
{section === 'audit' && <>{profile.role === 'admin' ? <table class="admin-table"><thead><tr><th>Zaman</th><th>İşlem</th><th>Yapan</th><th>Kayıt</th></tr></thead><tbody>{audit.map((entry) => <tr><td>{new Date(entry.created_at).toLocaleString('tr-TR',{timeZone:'Europe/Istanbul'})}</td><td>{auditActionLabels[entry.action] ?? entry.action}</td><td>{auditActors.find((actor) => actor.id === entry.actor_id)?.display_name ?? (entry.actor_id ? 'Yetkili kullanıcı' : 'Sistem')}</td><td>{entry.entity} <small>{String(entry.entity_id ?? '').slice(0,8)}</small></td></tr>)}</tbody></table> : <p>Yalnız admin erişebilir.</p>}</>}
{section === 'users' && <>{profile.role === 'admin' ? <><h2>Üyeler</h2><table class="admin-table"><thead><tr><th>Üye</th><th>Katılım</th><th>Rol</th></tr></thead><tbody>{members.map((entry) => <tr><td><strong>{entry.display_name ?? 'Adsız üye'}</strong><br/><small title={entry.id}>ID: {entry.id.slice(0,8)}</small></td><td>{new Date(entry.created_at).toLocaleDateString('tr-TR')}</td><td>{entry.id === user.id ? roleLabels[entry.role] : <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="member_role"/><input type="hidden" name="id" value={entry.id}/><select name="role" aria-label="Üye rolü">{['member','editor','admin'].map((role) => <option value={role} selected={entry.role === role}>{roleLabels[role]}</option>)}</select><button type="submit">Kaydet</button></form>}</td></tr>)}</tbody></table><h2>Hesap silme talepleri</h2><table class="admin-table"><tbody>{deletionRequests.map((entry) => <tr><td>{entry.user_id}</td><td>{entry.created_at}</td><td><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="deletion_request"/><input type="hidden" name="id" value={entry.id}/><select name="status" aria-label="Talep durumu">{['pending','processing','completed','rejected'].map((status) => <option value={status} selected={entry.status === status}>{status}</option>)}</select><button type="submit">Kaydet</button></form></td></tr>)}</tbody></table><p class="muted">Tamamlandı durumu hesabı otomatik silmez; doğrulanmış talep için kimlik sağlayıcıda ayrıca işlem gerekir.</p></> : <p>Yalnız admin erişebilir.</p>}</>}
{section === 'members' && <StudioMemberManagement mode="members"/>}
{section === 'access' && <StudioMemberManagement mode="access"/>}
{section === 'settings' && <>{profile.role === 'admin' ? <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="social"/><h2>Sosyal bağlantılar</h2>{(['github','youtube','instagram','x'] as const).map((name) => <label class="field">{name}<input name={name} type="url" value={social?.[name] ?? ''} placeholder="https://"/></label>)}<button class="button">Kaydet</button></form> : <p>Yalnız admin düzenleyebilir.</p>}</>}
</>}
</main></div>{section === 'content' && staff && <><script src="../../scripts/editor.ts"></script><script src="../../scripts/type-fields.ts"></script><script src="../../scripts/studio-slug.ts"></script><script src="../../scripts/studio-language.ts"></script></>}{section === 'advertising' && <><script is:inline set:html={`window.__palmargheAdvertising=${JSON.stringify(advertising ?? {}).replace(/</g,'\\u003c')};`}></script><script is:inline src="/scripts/advertising-editor.js" defer></script></>}{!user && <script is:inline src="/scripts/password-visibility.js" defer></script>}<script is:inline src="/scripts/studio-nav.js" defer></script><script is:inline src="/scripts/theme-toggle.js" defer></script><script is:inline src="/scripts/cursor-glow.js" defer></script></body></html>
