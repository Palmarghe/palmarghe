---
import { supabase } from '../../lib/supabase';
import '../../styles/global.css';
const db = supabase(Astro.cookies, Astro.request);
const user = db ? (await db.auth.getUser()).data.user : null;
const profile = user && db ? (await db.from('profiles').select('role').eq('id', user.id).single()).data : null;
const staff = profile?.role === 'admin' || profile?.role === 'editor';
const section = Astro.url.searchParams.get('section') ?? 'dashboard';
const sections = ['dashboard','content','categories','tags','media','messages','appearance','navigation','settings'];
const content: Record<string, any>[] = staff && db ? (await db.from('content_items').select('id,title,locale,type,status,slug,published_at').order('updated_at',{ascending:false}).limit(100)).data ?? [] : [];
const categories: Record<string, any>[] = staff && db ? (await db.from('categories').select('id,slug,name_tr,name_en,parent_id,active,sort_order').order('sort_order')).data ?? [] : [];
const tags: Record<string, any>[] = staff && db ? (await db.from('tags').select('id,slug,name_tr,name_en').order('slug')).data ?? [] : [];
const messages: Record<string, any>[] = staff && db ? (await db.from('contact_messages').select('id,name,email,message,status,created_at').order('created_at',{ascending:false}).limit(50)).data ?? [] : [];
const media: Record<string, any>[] = staff && db ? (await db.from('media').select('id,path,mime,bytes,alt_tr,created_at').order('created_at',{ascending:false}).limit(100)).data ?? [] : [];
const navigation: Record<string, any>[] = staff && db ? (await db.from('navigation').select('id,locale,label,href,sort_order,active').order('sort_order')).data ?? [] : [];
const appearance = staff && db ? (await db.from('site_settings').select('value').eq('key','appearance').single()).data?.value : null;
const selectedId = Astro.url.searchParams.get('edit');
const selected = selectedId && staff && db ? (await db.from('content_items').select('*').eq('id',selectedId).single()).data : null;
const selectedContentCategory = selected && db ? (await db.from('content_categories').select('category_id').eq('content_id',selected.id).limit(1)).data?.[0]?.category_id : null;
const selectedCategory = section === 'categories' && selectedId ? categories.find((entry) => entry.id === selectedId) : null;
const selectedTag = section === 'tags' && selectedId ? tags.find((entry) => entry.id === selectedId) : null;
const selectedNav = section === 'navigation' && selectedId ? navigation.find((entry) => entry.id === selectedId) : null;
---
<!doctype html><html lang="tr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Studio — Palmarghe</title></head><body>
<div class="admin-shell"><aside class="admin-side"><a class="brand" href="/studio/"><svg viewBox="0 0 48 56" width="25" height="30" aria-hidden="true"><path d="M5 3 43 15v26H24V29h7v-5L17 20v34L5 50Z" fill="currentColor"/></svg><span>STUDIO</span></a>{staff && <nav aria-label="Studio">{sections.map((name) => <a href={`/studio/?section=${name}`} aria-current={section === name ? 'page' : undefined}>{name}</a>)}</nav>}</aside><main class="admin-main">
{!db ? <p class="alert">Supabase bağlantısı yapılandırılmadı.</p> : !user ? <><h1>Studio</h1><p>Yalnızca yetkili hesaplar.</p><form method="post" action="/api/auth/"><input type="hidden" name="action" value="login"/><label class="field">Email<input name="email" type="email" required/></label><label class="field">Şifre<input name="password" type="password" required/></label><button class="button">Giriş</button></form></> : !staff ? <><h1>Erişim yok</h1><p>Bu hesap Studio yetkisine sahip değil.</p></> : <>
<div class="section-heading"><h1 style="font-size:clamp(2rem,5vw,4rem)">{section}</h1><span>{profile.role}</span></div>
{section === 'dashboard' && <><p>İçerik: {content.length} · Mesaj: {messages.length}</p><p class="muted">Trafik verisi bağlı değil.</p></>}
{section === 'content' && <><h2>{selected ? 'İçerik düzenle' : 'Yeni içerik'}</h2><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="content"/><input type="hidden" name="id" value={selected?.id ?? ''}/><label class="field">Başlık<input name="title" required maxlength="200" value={selected?.title ?? ''}/></label><label class="field">Slug<input name="slug" required pattern="[a-z0-9/-]+" value={selected?.slug ?? ''}/></label><label class="field">Dil<select name="locale"><option value="tr" selected={selected?.locale !== 'en'}>Türkçe</option><option value="en" selected={selected?.locale === 'en'}>English</option></select></label><label class="field">Kategori<select name="category_id"><option value="">Yok</option>{categories.map((entry) => <option value={entry.id} selected={selectedContentCategory === entry.id}>{entry.name_tr}</option>)}</select></label><label class="field">Kapak görseli<select name="cover_media_id"><option value="">Yok</option>{media.map((entry) => <option value={entry.id} selected={selected?.cover_media_id === entry.id}>{entry.alt_tr ?? entry.path}</option>)}</select></label><label class="field">Tür<select name="type">{['article','project','fm_mod','gallery','lab_entry'].map((type) => <option value={type} selected={selected?.type === type}>{type}</option>)}</select></label><label class="field">Durum<select name="status">{['draft','scheduled','published','archived'].map((status) => <option value={status} selected={selected?.status === status}>{status}</option>)}</select></label><label class="field">Özet<textarea name="excerpt">{selected?.excerpt ?? ''}</textarea></label><div class="field"><span>İçerik</span><div class="editor-toolbar" role="toolbar" aria-label="İçerik biçimlendirme"><button type="button" data-editor="paragraph">P</button><button type="button" data-editor="heading2">H2</button><button type="button" data-editor="heading3">H3</button><button type="button" data-editor="bold">B</button><button type="button" data-editor="italic">I</button><button type="button" data-editor="bullet">Liste</button><button type="button" data-editor="quote">Alıntı</button><button type="button" data-editor="code">Kod</button><button type="button" data-editor="divider">Ayırıcı</button></div><div id="block-editor" data-content={JSON.stringify(selected?.body && typeof selected.body === 'object' ? selected.body : { type: 'doc', content: [{ type: 'paragraph', content: selected?.body ? [{ type: 'text', text: String(selected.body) }] : [] }] })}></div><textarea id="body-json" name="body" hidden required></textarea></div><label class="field">SEO başlığı<input name="seo_title" value={selected?.seo_title ?? ''}/></label><label class="field">SEO açıklaması<input name="seo_description" value={selected?.seo_description ?? ''}/></label><button class="button">Kaydet</button></form><section class="section"><h2>İçerikler</h2><table class="admin-table"><thead><tr><th>Başlık</th><th>Dil</th><th>Durum</th><th></th></tr></thead><tbody>{content.map((entry) => <tr><td>{entry.title}</td><td>{entry.locale}</td><td>{entry.status}</td><td><a class="text-link" href={`/studio/?section=content&edit=${entry.id}`}>Düzenle</a> <details><summary>Sil</summary><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="content"/><input type="hidden" name="operation" value="delete"/><input type="hidden" name="id" value={entry.id}/><button type="submit">Silmeyi onayla</button></form></details></td></tr>)}</tbody></table></section></>}
{section === 'categories' && <><h2>{selectedCategory ? 'Kategori düzenle' : 'Kategori ekle'}</h2><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="category"/><input type="hidden" name="operation" value={selectedCategory ? 'update' : 'create'}/><input type="hidden" name="id" value={selectedCategory?.id ?? ''}/><label class="field">Slug<input name="slug" required pattern="[a-z0-9-]+" value={selectedCategory?.slug ?? ''}/></label><label class="field">Türkçe ad<input name="name_tr" required value={selectedCategory?.name_tr ?? ''}/></label><label class="field">English name<input name="name_en" required value={selectedCategory?.name_en ?? ''}/></label><label class="field">Üst kategori<select name="parent_id"><option value="">Yok</option>{categories.filter((entry) => entry.id !== selectedCategory?.id).map((entry) => <option value={entry.id} selected={entry.id === selectedCategory?.parent_id}>{entry.name_tr}</option>)}</select></label><button class="button">Kaydet</button></form><table class="admin-table"><tbody>{categories.map((entry) => <tr><td>{entry.name_tr}</td><td>{entry.slug}</td><td>{entry.active ? 'Aktif' : 'Pasif'}</td><td><a class="text-link" href={`/studio/?section=categories&edit=${entry.id}`}>Düzenle</a></td><td><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="category"/><input type="hidden" name="operation" value="delete"/><input type="hidden" name="id" value={entry.id}/><button type="submit">Sil</button></form></td></tr>)}</tbody></table></>}
{section === 'tags' && <><h2>{selectedTag ? 'Etiket düzenle' : 'Etiket ekle'}</h2><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="tag"/><input type="hidden" name="operation" value={selectedTag ? 'update' : 'create'}/><input type="hidden" name="id" value={selectedTag?.id ?? ''}/><label class="field">Slug<input name="slug" required pattern="[a-z0-9-]+" value={selectedTag?.slug ?? ''}/></label><label class="field">Türkçe ad<input name="name_tr" required value={selectedTag?.name_tr ?? ''}/></label><label class="field">English name<input name="name_en" required value={selectedTag?.name_en ?? ''}/></label><button class="button">Kaydet</button></form><table class="admin-table"><tbody>{tags.map((entry) => <tr><td>{entry.name_tr}</td><td>{entry.slug}</td><td><a class="text-link" href={`/studio/?section=tags&edit=${entry.id}`}>Düzenle</a></td><td><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="tag"/><input type="hidden" name="operation" value="delete"/><input type="hidden" name="id" value={entry.id}/><button type="submit">Sil</button></form></td></tr>)}</tbody></table></>}
{section === 'media' && <><h2>Medya yükle</h2><form method="post" action="/api/media/" enctype="multipart/form-data"><label class="field">Görsel (PNG, JPEG, WebP; en fazla 10 MB)<input type="file" name="file" accept="image/png,image/jpeg,image/webp" required/></label><label class="field">Alternatif metin<input name="alt_tr" maxlength="200" required/></label><button class="button" type="submit">Yükle</button></form><div class="card-grid section">{media.map((entry) => <div class="entry-card"><img src={`/api/media/${entry.id}/`} alt={entry.alt_tr ?? ''} width="400" height="250" loading="lazy"/><p>{entry.alt_tr}</p><small>{entry.mime} · {Math.round(entry.bytes/1024)} KB</small></div>)}</div></>}
{section === 'messages' && <table class="admin-table"><thead><tr><th>Gönderen</th><th>Mesaj</th><th>Durum</th></tr></thead><tbody>{messages.map((entry) => <tr><td>{entry.name}<br/>{entry.email}</td><td>{entry.message}</td><td><form method="post" action="/api/studio/"><input type="hidden" name="entity" value="message"/><input type="hidden" name="id" value={entry.id}/><select name="status" aria-label="Mesaj durumu">{['unread','read','archived','spam'].map((status) => <option value={status} selected={entry.status === status}>{status}</option>)}</select><button type="submit">Kaydet</button></form></td></tr>)}</tbody></table>}
{section === 'appearance' && <>{profile.role === 'admin' ? <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="appearance"/><label class="field">Vurgu rengi<select name="accent"><option value="violet" selected={!appearance || appearance.accent === 'violet'}>Violet</option><option value="blue" selected={appearance?.accent === 'blue'}>Blue</option><option value="amber" selected={appearance?.accent === 'amber'}>Amber</option></select></label><label class="field">Köşe<select name="radius"><option value="sharp" selected={!appearance || appearance.radius === 'sharp'}>Sharp</option><option value="subtle" selected={appearance?.radius === 'subtle'}>Subtle</option></select></label><button class="button">Kaydet</button></form> : <p>Yalnız admin düzenleyebilir.</p>}</>}
{section === 'navigation' && <>{profile.role === 'admin' && <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="navigation"/><input type="hidden" name="operation" value={selectedNav ? 'update' : 'create'}/><input type="hidden" name="id" value={selectedNav?.id ?? ''}/><label class="field">Dil<select name="locale"><option value="tr" selected={selectedNav?.locale !== 'en'}>TR</option><option value="en" selected={selectedNav?.locale === 'en'}>EN</option></select></label><label class="field">Başlık<input name="label" required maxlength="50" value={selectedNav?.label ?? ''}/></label><label class="field">Bağlantı<input name="href" required value={selectedNav?.href ?? ''}/></label><label class="field">Sıra<input name="sort_order" type="number" min="0" max="1000" value={selectedNav?.sort_order ?? 0}/></label><label><input name="active" type="checkbox" checked={selectedNav?.active ?? true}/> Aktif</label><p><button class="button">Kaydet</button></p></form>}<table class="admin-table"><tbody>{navigation.map((entry) => <tr><td>{entry.locale}</td><td>{entry.label}</td><td>{entry.href}</td><td><a href={`/studio/?section=navigation&edit=${entry.id}`}>Düzenle</a></td><td>{profile.role === 'admin' && <form method="post" action="/api/studio/"><input type="hidden" name="entity" value="navigation"/><input type="hidden" name="operation" value="delete"/><input type="hidden" name="id" value={entry.id}/><button type="submit">Sil</button></form>}</td></tr>)}</tbody></table></>}
{section === 'settings' && <p class="alert">Ayar yönetimi henüz yapılandırılmadı.</p>}
</>}
</main></div><script src="../../scripts/editor.ts"></script></body></html>
