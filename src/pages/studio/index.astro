---
import { supabase } from '../../lib/supabase';
import '../../styles/global.css';
const db = supabase(Astro.cookies, Astro.request);
const user = db ? (await db.auth.getUser()).data.user : null;
const profile = user && db ? (await db.from('profiles').select('role').eq('id', user.id).single()).data : null;
const staff = profile?.role === 'admin' || profile?.role === 'editor';
const section = Astro.url.searchParams.get('section') ?? 'dashboard';
const sections = ['dashboard','content','categories','tags','media','messages','settings'];
const content = staff && db ? (await db.from('content_items').select('id,title,locale,type,status,slug,published_at').order('updated_at',{ascending:false}).limit(100)).data ?? [] : [];
const categories = staff && db ? (await db.from('categories').select('id,slug,name_tr,name_en,parent_id,active,sort_order').order('sort_order')).data ?? [] : [];
const tags = staff && db ? (await db.from('tags').select('id,slug,name_tr,name_en').order('slug')).data ?? [] : [];
const messages = staff && db ? (await db.from('contact_messages').select('id,name,email,message,status,created_at').order('created_at',{ascending:false}).limit(50)).data ?? [] : [];
const selectedId = Astro.url.searchParams.get('edit');
const selected = selectedId && staff && db ? (await db.from('content_items').select('*').eq('id',selectedId).single()).data : null;
---
<!doctype html><html lang="tr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Studio — Palmarghe</title></head><body>
<div class="admin-shell"><aside class="admin-side"><a class="brand" href="/studio/"><svg viewBox="0 0 48 56" width="25" height="30" aria-hidden="true"><path d="M5 3 43 15v26H24V29h7v-5L17 20v34L5 50Z" fill="currentColor"/></svg><span>STUDIO</span></a>{staff && <nav aria-label="Studio">{sections.map((name) => <a href={`/studio/?section=${name}`} aria-current={section === name ? 'page' : undefined}>{name}</a>)}</nav>}</aside><main class="admin-main">
{!db ? <p class="alert">Supabase bağlantısı yapılandırılmadı.</p> : !user ? <><h1>Studio</h1><p>Yalnızca yetkili hesaplar.</p><form method="post" action="/api/auth"><input type="hidden" name="action" value="login"/><label class="field">Email<input name="email" type="email" required/></label><label class="field">Şifre<input name="password" type="password" required/></label><button class="button">Giriş</button></form></> : !staff ? <><h1>Erişim yok</h1><p>Bu hesap Studio yetkisine sahip değil.</p></> : <>
<div class="section-heading"><h1 style="font-size:clamp(2rem,5vw,4rem)">{section}</h1><span>{profile.role}</span></div>
{section === 'dashboard' && <><p>İçerik: {content.length} · Mesaj: {messages.length}</p><p class="muted">Trafik verisi bağlı değil.</p></>}
{section === 'content' && <><h2>{selected ? 'İçerik düzenle' : 'Yeni içerik'}</h2><form method="post" action="/api/studio"><input type="hidden" name="entity" value="content"/><input type="hidden" name="id" value={selected?.id ?? ''}/><label class="field">Başlık<input name="title" required maxlength="200" value={selected?.title ?? ''}/></label><label class="field">Slug<input name="slug" required pattern="[a-z0-9/-]+" value={selected?.slug ?? ''}/></label><label class="field">Dil<select name="locale"><option value="tr" selected={selected?.locale !== 'en'}>Türkçe</option><option value="en" selected={selected?.locale === 'en'}>English</option></select></label><label class="field">Tür<select name="type">{['article','project','fm_mod','gallery','lab_entry'].map((type) => <option value={type} selected={selected?.type === type}>{type}</option>)}</select></label><label class="field">Durum<select name="status">{['draft','scheduled','published','archived'].map((status) => <option value={status} selected={selected?.status === status}>{status}</option>)}</select></label><label class="field">Özet<textarea name="excerpt">{selected?.excerpt ?? ''}</textarea></label><label class="field">İçerik<textarea name="body">{typeof selected?.body === 'string' ? selected.body : ''}</textarea></label><label class="field">SEO başlığı<input name="seo_title" value={selected?.seo_title ?? ''}/></label><label class="field">SEO açıklaması<input name="seo_description" value={selected?.seo_description ?? ''}/></label><button class="button">Kaydet</button></form><section class="section"><h2>İçerikler</h2><table class="admin-table"><thead><tr><th>Başlık</th><th>Dil</th><th>Durum</th><th></th></tr></thead><tbody>{content.map((entry) => <tr><td>{entry.title}</td><td>{entry.locale}</td><td>{entry.status}</td><td><a class="text-link" href={`/studio/?section=content&edit=${entry.id}`}>Düzenle</a></td></tr>)}</tbody></table></section></>}
{section === 'categories' && <><h2>Kategori ekle</h2><form method="post" action="/api/studio"><input type="hidden" name="entity" value="category"/><label class="field">Slug<input name="slug" required pattern="[a-z0-9-]+"/></label><label class="field">Türkçe ad<input name="name_tr" required/></label><label class="field">English name<input name="name_en" required/></label><label class="field">Üst kategori<select name="parent_id"><option value="">Yok</option>{categories.map((entry) => <option value={entry.id}>{entry.name_tr}</option>)}</select></label><button class="button">Ekle</button></form><table class="admin-table"><tbody>{categories.map((entry) => <tr><td>{entry.name_tr}</td><td>{entry.slug}</td><td>{entry.active ? 'Aktif' : 'Pasif'}</td></tr>)}</tbody></table></>}
{section === 'tags' && <><h2>Etiket ekle</h2><form method="post" action="/api/studio"><input type="hidden" name="entity" value="tag"/><label class="field">Slug<input name="slug" required pattern="[a-z0-9-]+"/></label><label class="field">Türkçe ad<input name="name_tr" required/></label><label class="field">English name<input name="name_en" required/></label><button class="button">Ekle</button></form><table class="admin-table"><tbody>{tags.map((entry) => <tr><td>{entry.name_tr}</td><td>{entry.slug}</td></tr>)}</tbody></table></>}
{section === 'media' && <p class="alert">Medya yükleme henüz yapılandırılmadı.</p>}
{section === 'messages' && <table class="admin-table"><thead><tr><th>Gönderen</th><th>Mesaj</th><th>Durum</th></tr></thead><tbody>{messages.map((entry) => <tr><td>{entry.name}<br/>{entry.email}</td><td>{entry.message}</td><td>{entry.status}</td></tr>)}</tbody></table>}
{section === 'settings' && <p class="alert">Ayar yönetimi henüz yapılandırılmadı.</p>}
</>}
</main></div></body></html>
